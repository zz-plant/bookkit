---
import newBookStudioClient from "./new-book-studio/client.ts?url";

const {
  title = "Start a new book",
  description = "Fill this in to get a starter config, a setup checklist, and a short brief for whoever builds the book.",
} = Astro.props;
---
<section class="studio" aria-labelledby="studio-title">
  <div class="section-header">
    <h1 id="studio-title">{title}</h1>
    <p class="lede">{description}</p>
  </div>

  <nav class="studio__progress" aria-label="Form progress">
    <a href="#studio-step-1">Name</a>
    <a href="#studio-step-2">Structure</a>
    <a href="#studio-step-3">Technical</a>
    <a href="#studio-step-4">Search and sharing</a>
    <a href="#studio-output">Output</a>
  </nav>

  <form class="studio__form" data-new-book-form>
    <fieldset id="studio-step-1">
      <legend>Name and purpose</legend>
      <label>
        Working title
        <input name="bookTitle" required placeholder="Operational Clarity" />
      </label>
      <label>
        Short promise (one sentence)
        <textarea name="promise" rows="3" required placeholder="Help teams identify delivery bottlenecks and fix them within one sprint."></textarea>
      </label>
      <label>
        Who is this for?
        <input name="audience" placeholder="New managers, team leads, and staff engineers" />
      </label>
    </fieldset>

    <fieldset id="studio-step-2">
      <legend>Structure</legend>
      <label>
        Topic tags (one per line)
        <textarea name="mechanisms" rows="4" placeholder={"failure-triage\nsignal-budget\nhandoff-contract"}></textarea>
        <small>Slugs or short labels. Formatting is cleaned up for you.</small>
      </label>
      <label>
        Chapter ideas (one per line)
        <textarea name="chapters" rows="4" placeholder={"overview\ncore-loops\naction-playbooks"}></textarea>
      </label>
      <label>
        Languages needed
        <input name="locales" placeholder="English only (default) or e.g. en, es" />
      </label>
    </fieldset>

    <fieldset id="studio-step-3">
      <legend>Technical details (optional)</legend>
      <label>
        Internal ID (letters, numbers, dashes)
        <input name="bookKey" pattern="[a-z0-9-]+" placeholder="operator-playbook" />
        <small>Leave blank to derive it from the title.</small>
      </label>
    </fieldset>

    <fieldset id="studio-step-4">
      <legend>Search and social sharing</legend>
      <label>
        Canonical site URL
        <input name="siteUrl" placeholder="https://operator-playbook.book" />
      </label>
      <label>
        Additional domains (one per line)
        <textarea name="domains" rows="2" placeholder="https://www.operator-playbook.com"></textarea>
      </label>
      <label>
        Default metadata description
        <textarea name="defaultMetaDescription" rows="3" placeholder="This book helps teams diagnose operating friction and ship repair moves in under ten minutes."></textarea>
      </label>
      <label>
        Default Open Graph image path
        <input name="defaultOgImage" placeholder="/og/default.svg" />
      </label>
      <label>
        Open Graph site name
        <input name="ogSiteName" placeholder="Operator Playbook" />
      </label>
      <label>
        Open Graph locale
        <input name="ogLocale" placeholder="en_US" />
      </label>
      <label>
        Open Graph image alt text
        <input name="ogImageAlt" placeholder="Cover art for Operator Playbook" />
      </label>
      <label>
        Twitter card type
        <select name="twitterCard">
          <option value="summary_large_image" selected>summary_large_image</option>
          <option value="summary">summary</option>
          <option value="app">app</option>
          <option value="player">player</option>
        </select>
      </label>
      <label>
        <input type="checkbox" name="indexable" checked />
        Index this book in production by default
      </label>
      <label>
        Open Graph image per page type
        <textarea
          name="ogSurfaces"
          rows="8"
          placeholder={"home=/og/home.svg\nread-hub=/og/read-hub.svg\noverview=/og/overview.svg\nchapters-index=/og/chapters.svg\nchapter-detail=/og/chapter-detail.svg\nmechanisms-index=/og/mechanisms.svg\nmechanism-detail=/og/mechanism-detail.svg\ntoolkit-index=/og/toolkit.svg\ntoolkit-detail=/og/toolkit-detail.svg\nglossary-index=/og/glossary.svg\nglossary-detail=/og/glossary-detail.svg\nexamples-index=/og/examples.svg\nexample-detail=/og/example-detail.svg\nrelease-notes=/og/release-notes.svg\nversions=/og/versions.svg\ndownloads=/og/downloads.svg"}
        ></textarea>
        <small>One line per page type, as <code>page-type=/path/to/image.svg</code>.</small>
      </label>
    </fieldset>

    <div class="studio__actions">
      <button type="submit" class="studio__button studio__button--primary">Generate starter files</button>
      <button type="button" class="studio__button studio__button--secondary" data-fill-example>Fill in an example</button>
    </div>
  </form>

  <section class="studio__output" id="studio-output" data-studio-output hidden>
    <h2>Starter files</h2>
    <p class="meta">Copy each block, or download everything as one JSON file.</p>

    <article>
      <div class="studio__output-header">
        <h3>Brief</h3>
        <button type="button" class="studio__button studio__button--secondary" data-copy-target="brief">Copy</button>
      </div>
      <pre data-output="brief"></pre>
    </article>

    <article>
      <div class="studio__output-header">
        <h3>Setup checklist</h3>
        <button type="button" class="studio__button studio__button--secondary" data-copy-target="checklist">Copy</button>
      </div>
      <pre data-output="checklist"></pre>
    </article>

    <article>
      <div class="studio__output-header">
        <h3><code>book.config.ts</code> starter</h3>
        <button type="button" class="studio__button studio__button--secondary" data-copy-target="config">Copy</button>
      </div>
      <pre data-output="config"></pre>
    </article>

    <article>
      <div class="studio__output-header">
        <h3>SEO and social settings</h3>
        <button type="button" class="studio__button studio__button--secondary" data-copy-target="seo">Copy</button>
      </div>
      <pre data-output="seo"></pre>
    </article>

    <article>
      <div class="studio__output-header">
        <h3>Open Graph image URLs</h3>
        <button type="button" class="studio__button studio__button--secondary" data-copy-target="ogUrls">Copy</button>
      </div>
      <pre data-output="ogUrls"></pre>
    </article>

    <details class="studio__advanced">
      <summary>Agent payload and CLI commands</summary>

      <article>
        <div class="studio__output-header">
          <h3>Agent payload (JSON)</h3>
          <button type="button" class="studio__button studio__button--secondary" data-copy-target="payload">Copy</button>
        </div>
        <pre data-output="payload"></pre>
      </article>

      <article>
        <div class="studio__output-header">
          <h3>Commands</h3>
          <button type="button" class="studio__button studio__button--secondary" data-copy-target="commands">Copy</button>
        </div>
        <pre data-output="commands"></pre>
      </article>
    </details>

    <div class="studio__actions">
      <button type="button" class="studio__button studio__button--primary" data-download-package>Download JSON</button>
      <button type="button" class="studio__button studio__button--secondary" data-reset-form>Reset form</button>
    </div>
  </section>

  <div class="studio__toast-region" aria-live="polite" aria-atomic="true" data-studio-toast-region></div>

  <dialog class="studio__confirm" data-reset-confirm>
    <p>Reset all current form fields and generated output?</p>
    <div class="studio__confirm-actions">
      <button type="button" class="studio__button studio__button--secondary" data-reset-cancel>Cancel</button>
      <button type="button" class="studio__button studio__button--primary" data-reset-confirm-action>Reset</button>
    </div>
  </dialog>
</section>

<script type="module" src={newBookStudioClient}></script>


<style>
  .studio {
    display: grid;
    gap: 1.5rem;
    max-width: 60rem;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.55;
  }

  .studio :where(h1, h2, h3) {
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .studio .lede {
    max-width: 62ch;
    color: var(--color-muted);
    font-size: 1.05rem;
  }

  .studio__progress {
    position: sticky;
    top: 5.25rem;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 96%, transparent);
    padding: 0.45rem 0.65rem;
    box-shadow: var(--shadow-soft);
  }


  .studio__progress a {
    font-size: var(--text-sm);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid transparent;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .studio__progress a:hover,
  .studio__progress a:focus-visible {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    text-decoration: none;
  }


  .studio__form {
    display: grid;
    gap: 1rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.9rem;
    background: var(--color-surface);
  }

  fieldset {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  legend {
    padding: 0 0.35rem;
    font-weight: 700;
  }

  .studio__form label {
    display: grid;
    gap: 0.45rem;
    font-weight: 600;
  }

  .studio__form small {
    color: var(--color-muted);
    font-weight: 400;
    line-height: 1.4;
  }

  .studio__form input,
  .studio__form textarea,
  .studio__form select {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--color-bg);
    color: inherit;
    padding: 0.75rem 0.85rem;
    font: inherit;
    line-height: 1.45;
  }

  .studio__form textarea {
    min-height: 7rem;
  }

  .studio__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .studio__toast-region {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.5rem;
    z-index: 50;
    max-width: min(26rem, calc(100vw - 2rem));
  }

  .studio__toast {
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface), #7cc5ff 10%);
    border-radius: 0.75rem;
    padding: 0.65rem 0.8rem;
    box-shadow: var(--shadow-soft);
    font-size: var(--text-sm);
  }

  .studio__confirm {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    max-width: 24rem;
  }

  .studio__confirm-actions {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    margin-top: 0.75rem;
  }

  .studio__button {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 0.95rem;
    background: var(--color-bg);
    color: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .studio__button--primary {
    background: var(--color-accent-strong);
    color: var(--color-on-accent);
    border-color: transparent;
  }

  .studio__button--primary:hover,
  .studio__button--primary:focus-visible {
    background: var(--color-accent);
  }

  .studio__button--secondary {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .studio__button--secondary:hover,
  .studio__button--secondary:focus-visible {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
  }

  .studio__output {
    display: grid;
    gap: 1rem;
  }

  .studio__advanced {
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    padding: 0.9rem;
    background: var(--color-surface);
  }

  .studio__advanced summary {
    cursor: pointer;
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .studio__output article {
    border: 1px solid var(--color-border);
    border-radius: 0.85rem;
    padding: 1rem;
    background: var(--color-surface);
  }

  .studio__output-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .studio__output pre {
    overflow: auto;
    white-space: pre-wrap;
    word-break: break-word;
    padding: 0.8rem;
    border-radius: 0.65rem;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-bg), #000 8%);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 720px) {
    .studio {
      font-size: 0.97rem;
      gap: 1.15rem;
    }

    .studio__progress {
      top: 4.8rem;
      border-radius: 14px;
    }

    .studio__form,
    .studio__output article {
      padding: 0.9rem;
    }
  }
</style>
