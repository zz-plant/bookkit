---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath } from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.toolkit;
const { items: toolItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const name = frontmatter.name ?? "Untitled action";
    return {
      href: readItemPath("toolkit", slug),
      title: isFallback ? `${name} (not yet translated)` : name,
      meta: [
        frontmatter.mechanism,
        frontmatter.timeboxMinutes ? `${frontmatter.timeboxMinutes} min` : null,
      ]
        .filter(Boolean)
        .join(" · "),
    };
  },
  sort: (a, b) => a.title.localeCompare(b.title),
});
const localizedLede = buildTranslationLede(
  "Actions you can take in ten minutes or less.",
  completeness
);
---
<BaseLayout title={`Toolkit • ${bookConfig.title}`}>
  <ContentIndexList
    title="Toolkit"
    lede={localizedLede}
    items={toolItems}
    filterMode="always"
    filterPlaceholder="Filter by name or mechanism"
    alphaMode="always"
  />
</BaseLayout>
