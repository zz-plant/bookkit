---
import BaseLayout from "../../BaseLayout.astro";
import { bookConfig, bookEntryPoints } from "../../runtime";
import {
	type BookConfig,
	readItemPath,
	readRoutes,
	readSectionTitles,
} from "../../../book";
import { bookPageTitle } from "../../../seo/page-meta";

// Read through BookConfig: under `as const`, an empty `mechanisms: []` has no element type.
const config: BookConfig = bookConfig;
const { objectives, frame, causalStance, constraints, mechanisms } = config;
const mechanismTitles = new Map(
	Object.values(bookEntryPoints.contentModules.mechanisms)
		.filter(
			(module) =>
				!module.frontmatter?.locale || module.frontmatter.locale === "en",
		)
		.map((module) => [module.frontmatter?.slug, module.frontmatter?.title]),
);
---
<BaseLayout title={bookPageTitle(readSectionTitles.overview, bookConfig.title)}>
  <a class="back-link" href={readRoutes.root}>← Reading hub</a>
  <div class="section-header">
    <h1>{readSectionTitles.overview}</h1>
    <p class="lede">What the book sets out to do, how it approaches the problem, and the rules it follows.</p>
  </div>
  <section class="content-block">
    <h2>What you’ll get from it</h2>
    <ul>
      <li><strong>Starting point:</strong> {objectives.readerStart}</li>
      <li><strong>By the end:</strong> {objectives.readerEnd}</li>
      <li><strong>The change:</strong> {objectives.transformation}</li>
    </ul>

    <h2>Approach</h2>
    <p>{frame.intent}</p>
    <ol>
      {frame.steps.map((step) => (
        <li>{step}</li>
      ))}
    </ol>

    <h2>Core claim</h2>
    <p>{causalStance}</p>

    <h2>Ground rules</h2>
    <ul>
      <li>Every toolkit action takes {constraints.actionPrimitiveMaxMinutes} minutes or less.</li>
      {constraints.examplesMustBeSwappable && (
        <li>Examples are interchangeable: swap in your own and the mechanism still holds.</li>
      )}
    </ul>

    {mechanisms.length > 0 && (
      <Fragment>
        <h2>Core mechanisms</h2>
        <ul>
          {mechanisms.map((mechanism) => (
            <li>
              <strong>
                <a href={readItemPath("mechanisms", mechanism.slug)}>
                  {mechanismTitles.get(mechanism.slug) ?? mechanism.slug}
                </a>:
              </strong>{" "}
              {mechanism.focus}
            </li>
          ))}
        </ul>
      </Fragment>
    )}
  </section>
  <section class="next-steps">
    <h2>Keep going</h2>
    <div class="next-steps__links">
      <a class="next-steps__link" href={readRoutes.chapters}>Chapters</a>
      <a class="next-steps__link" href={readRoutes.mechanisms}>Mechanisms</a>
      <a class="next-steps__link" href={readRoutes.toolkit}>Toolkit</a>
    </div>
  </section>
</BaseLayout>
