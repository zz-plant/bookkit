{
	"name": "bookkit-workspace",
	"private": true,
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=22.22.0",
		"bun": ">=1.4.3"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run bookkit dev",
		"build": "bun run bookkit build",
		"build:all": "bun run --workspaces build",
		"check:build": "bun run scripts/check-build.ts",
		"check:a11y": "bun run scripts/check-a11y.ts",
		"qa": "bun run verify -- --all",
		"verify": "bun run scripts/verify.ts",
		"mcp": "bun run scripts/mcp-server.ts",
		"deploy": "bun run bookkit deploy --all",
		"lint": "biome lint .",
		"check:types": "bun run scripts/typecheck.ts",
		"check:upgrade": "bun run scripts/upgrade-check.ts",
		"format": "biome format --write .",
		"check:format": "biome ci .",
		"prepare": "bun run scripts/install-hooks.ts",
		"list:books": "bun run scripts/list-books.ts",
		"bookkit": "bun run scripts/bookkit.ts",
		"compile:book": "bun run scripts/compile-book.ts",
		"validate:book": "bun run scripts/validate-book.ts",
		"validate": "bun run scripts/validate-all.ts",
		"validate:release": "bun run validate",
		"new:example": "bun run scripts/scaffold-example.ts",
		"new:book": "bun run scripts/scaffold-book.ts",
		"create-bookkit": "bun run packages/create-bookkit/src/index.ts",
		"remove:book": "bun run scripts/remove-book.ts",
		"new:mechanism": "bun run scripts/scaffold-mechanism.ts",
		"new:tool": "bun run scripts/scaffold-tool.ts",
		"check:concepts": "bun run scripts/check-floating-concepts.ts",
		"check:suggestions": "bun run scripts/check-suggestions.ts",
		"check:corpus": "bun run scripts/check-corpus.ts",
		"check:runbooks": "bun run scripts/check-runbooks.ts",
		"check:runbooks:error": "bun run scripts/check-runbooks.ts --mode error",
		"propose": "bun run scripts/propose-book.ts",
		"export:gitbook": "bun run scripts/export-gitbook.ts",
		"export:smoke": "bun run scripts/export-smoke.ts",
		"check:separation": "bun run scripts/check-separation.ts",
		"check:architecture": "bun run scripts/check-architecture.ts",
		"stack:capabilities": "bun run scripts/stack-capabilities.ts",
		"validate:release:seo": "bun run validate",
		"setup:codex": "bash scripts/codex-setup.sh",
		"check:todos": "bun run scripts/check-todos.ts",
		"check:shims": "bun run scripts/check-shims.ts",
		"sync:shims": "bun run scripts/check-shims.ts --write",
		"test": "bun test --parallel",
		"test:browser": "bun test ./scripts/chromium-relaunch.browser.ts ./scripts/ask-panel.browser.ts ./scripts/search-panel.browser.ts ./scripts/reader-wayfinding.browser.ts ./scripts/untrusted-text.browser.ts",
		"setup": "bun run scripts/setup.ts",
		"check": "bun run bookkit check"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.8",
		"@bookkit/astro-bookkit": "workspace:*",
		"@mdx-js/mdx": "^3.1.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.5",
		"axe-core": "4.14.0",
		"husky": "^9.1.7",
		"jszip": "^3.10.1",
		"lint-staged": "^17.0.5",
		"pdf-lib": "^1.17.1",
		"playwright": "1.64.1",
		"remark-gfm": "^4.0.1",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@7.0.2",
		"wrangler": "^4.152.0"
	},
	"optionalDependencies": {
		"@xenova/transformers": "^2.17.2"
	},
	"overrides": {
		"lodash-es": "^4.18.1",
		"mermaid": "11.12.2",
		"protobufjs": "^7.6.6",
		"sharp": "^0.35.5",
		"undici@7": "7.30.1",
		"vscode-languageserver-protocol": "~3.17.5"
	},
	"dependencies": {
		"undici": "^8.12.3"
	}
}
