---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath, readRoutes } from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.mechanisms;
const coreMechanismSlugs = new Set(bookConfig.mechanisms.map((mechanism) => mechanism.slug));
const urgencyBySlug: Record<string, string> = {
  "delay-as-force": "urgent",
  "compliance-trap": "urgent",
  "transfer-success": "urgent",
  "bureaucracy-moral-technology": "high-leverage",
  "reputation-membrane": "high-leverage",
  "reversal-capacity": "stabilize",
};
const urgencyOrder: Record<string, number> = {
  urgent: 0,
  "high-leverage": 1,
  stabilize: 2,
};
const { items: mechanismItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const urgency = urgencyBySlug[slug] ?? "stabilize";
    const tags = [
      urgency,
      coreMechanismSlugs.has(slug) ? "core" : null,
      isFallback ? "fallback" : null,
    ].filter(Boolean);
    const predictions = Array.isArray(frontmatter.predictions) ? frontmatter.predictions : [];
    const quickTrigger = typeof predictions[0] === "string" ? predictions[0] : null;
    const definition = typeof frontmatter.definition === "string" ? frontmatter.definition : "";
    return {
      href: readItemPath("mechanisms", slug),
      title: frontmatter.title ?? "Untitled mechanism",
      eyebrow: tags.join(" • "),
      meta: quickTrigger ? `Use this when: ${quickTrigger}` : definition,
    };
  },
  sort: (a, b) => {
    const urgencyA = urgencyOrder[a.eyebrow?.split(" • ")[0] ?? "stabilize"] ?? 99;
    const urgencyB = urgencyOrder[b.eyebrow?.split(" • ")[0] ?? "stabilize"] ?? 99;
    if (urgencyA !== urgencyB) return urgencyA - urgencyB;
    return a.title.localeCompare(b.title);
  },
});
const localizedLede = buildTranslationLede(
  "Stable patterns that explain how harm stays normalized. Pick one by trigger language, then open its next action.",
  completeness
);
---
<BaseLayout title={`Mechanisms • ${bookConfig.title}`}>
  <ContentIndexList
    title="Mechanisms"
    lede={localizedLede}
    items={mechanismItems}
    filterMode="always"
    filterPlaceholder="Filter by mechanism, urgency tag, or trigger language..."
    filterHint="Try tags like urgent, high-leverage, stabilize, or phrases from your situation."
    alphaMode={false}
    itemActionLabel="Open mechanism"
  >
    <Fragment slot="after-list">
      <section class="content-block mechanisms-tail">
        <div>
          <div class="eyebrow">Need a next step?</div>
          <h2>Turn diagnosis into a ten-minute move</h2>
          <p class="meta">After naming the pattern, open Toolkit to choose a reversible action you can run now.</p>
        </div>
        <div class="link-group">
          <a class="button" href={readRoutes.toolkit}>Open toolkit</a>
          <a class="button button--secondary" href={readRoutes.overview}>Review framing constraints</a>
        </div>
      </section>
    </Fragment>
  </ContentIndexList>

  <script>
    const mechanismMeta = Array.from(document.querySelectorAll(".list-link .meta"));
    mechanismMeta.forEach((meta, index) => {
      if (!(meta instanceof HTMLElement)) return;
      const isMobile = window.matchMedia("(max-width: 720px)").matches;
      if (!isMobile) return;
      if ((meta.textContent || "").trim().length < 120) return;
      meta.classList.add("mechanism-meta");
      meta.id = `mechanism-meta-${index}`;

      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "mechanism-meta__toggle";
      toggle.textContent = "Show more";
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-controls", meta.id);

      toggle.addEventListener("click", () => {
        const expanded = meta.classList.toggle("is-expanded");
        toggle.textContent = expanded ? "Show less" : "Show more";
        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      });

      const listLink = meta.closest(".list-link");
      if (listLink instanceof HTMLElement) {
        listLink.insertAdjacentElement("afterend", toggle);
      }
    });
  </script>

</BaseLayout>

<style>
  .mechanisms-tail {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .mechanisms-tail h2 {
    margin-bottom: 0.35rem;
  }

  .mechanisms-tail .link-group {
    align-items: center;
  }

  @media (max-width: 720px) {
    .mechanism-meta {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0;
    }

    .mechanism-meta.is-expanded {
      display: block;
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .mechanism-meta__toggle {
      margin-top: 0.2rem;
      border: none;
      background: none;
      padding: 0;
      color: var(--color-accent-strong);
      font-size: var(--text-xs);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      justify-self: start;
    }
  }
</style>
