---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const modules = Object.entries(
  import.meta.glob("../../../content/book/chapters/*.mdx", { eager: true })
).map(([path, module]) => {
  const frontmatter = module.frontmatter ?? {};
  return {
    path,
    slug: frontmatter.slug,
    title: frontmatter.title ?? "Untitled chapter",
    status: frontmatter.status ?? "draft",
  };
});

const chapters = modules.sort((a, b) => a.path.localeCompare(b.path));
---
<BaseLayout title="Chapters • Bad People">
  <h1>Chapters</h1>
  <p class="lede">Module outlines that define the intervention frame.</p>
  <div class="stack">
    {chapters.map((chapter) => (
      <a class="list-link" href={`/read/chapters/${chapter.slug}`}>
        <span class="eyebrow">{chapter.status}</span>
        <strong>{chapter.title}</strong>
      </a>
    ))}
  </div>
</BaseLayout>
