{
	"name": "bookkit-workspace",
	"private": true,
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=20.11.0",
		"bun": ">=1.3.14"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run bookkit dev",
		"build": "bun run bookkit build",
		"build:all": "bun run --workspaces build",
		"check:build": "bun run scripts/check-build.ts",
		"qa": "bun run lint && bun run check:types && bun run test && bun run validate && bun run build:all && bun run check:build",
		"deploy": "bun run bookkit deploy",
		"lint": "biome lint .",
		"check:types": "bun run scripts/typecheck.ts",
		"check:upgrade": "bun run scripts/upgrade-check.ts",
		"format": "biome format --write .",
		"list:books": "bun run scripts/list-books.ts",
		"bookkit": "bun run scripts/bookkit.ts",
		"compile:book": "bun run scripts/compile-book.ts",
		"validate:book": "bun run scripts/validate-book.ts",
		"validate": "bun run scripts/validate-all.ts",
		"validate:release": "bun run scripts/validate-all.ts --mode error --no-drafts",
		"new:example": "bun run scripts/scaffold-example.ts",
		"new:book": "bun run scripts/scaffold-book.ts",
		"create-bookkit": "bun run packages/create-bookkit/src/index.ts",
		"remove:book": "bun run scripts/remove-book.ts",
		"new:mechanism": "bun run scripts/scaffold-mechanism.ts",
		"new:tool": "bun run scripts/scaffold-tool.ts",
		"check:concepts": "bun run scripts/check-floating-concepts.ts",
		"check:concepts:book": "bun run scripts/check-floating-concepts.ts --book",
		"check:suggestions": "bun run scripts/check-suggestions.ts --book",
		"check:suggestions:all": "bun run scripts/check-suggestions.ts --book",
		"check:runbooks": "bun run scripts/check-runbooks.ts",
		"check:runbooks:error": "bun run scripts/check-runbooks.ts --mode error",
		"propose": "bun run scripts/propose-book.ts",
		"propose:book": "bun run scripts/propose-book.ts --book",
		"audit:unused": "bun run scripts/audit-unused.ts",
		"fix:frontmatter": "bun run scripts/fix-frontmatter.ts",
		"export:gitbook": "bun run scripts/export-gitbook.ts",
		"export:smoke": "bun run scripts/export-smoke.ts",
		"check:separation": "bun run scripts/check-separation.ts",
		"check:architecture": "bun run scripts/check-architecture.ts",
		"stack:capabilities": "bun run scripts/stack-capabilities.ts --write STACK_CAPABILITIES_RESEARCH.md",
		"validate:release:seo": "BOOKKIT_REQUIRE_INDEXABLE_PROD=true bun run scripts/validate-all.ts --mode error --no-drafts",
		"setup:codex": "bash scripts/codex-setup.sh",
		"check:todos": "bun run scripts/check-todos.ts",
		"check:shims": "bun run scripts/check-shims.ts",
		"sync:shims": "bun run scripts/check-shims.ts --write",
		"test": "bun test",
		"test:vitest": "vitest run",
		"setup": "mise trust && bun install",
		"assets:check": "bun run scripts/check-assets.ts",
		"check": "bun run assets:check",
		"assets:generate": "bun run scripts/generate-scenes.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.131.2"
	}
}
