---
import { buildReleaseNotesPageProps } from "@bookkit/astro-bookkit";
import ReleaseNotesPage from "@bookkit/astro-bookkit/components/ReleaseNotesPage.astro";

import bookConfig from "../book.config";
import { getOgImageForPath } from "../lib/og";
import { getReleaseNotes } from "../lib/release-notes";
import { getVersionEntries } from "../lib/versions";

const viewModel = buildReleaseNotesPageProps({
  book: bookConfig,
  releases: getReleaseNotes(),
  versionEntries: getVersionEntries(),
  requestUrl: Astro.locals?.originalUrl ?? Astro.url.toString(),
  ogImage: getOgImageForPath("/release-notes"),
});
---
<ReleaseNotesPage {...viewModel} />
