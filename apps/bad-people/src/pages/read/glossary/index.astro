---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import {
	bookPageTitle,
	buildTranslationLede,
	readItemPath,
} from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.glossary;
const { items: entryItems, completeness } = createLocalizedContentList(
	modules,
	{
		defaultLocale: "en",
		locale: Astro.locals?.locale,
		mapEntry: ({ slug, module, isFallback }) => {
			const frontmatter = module.frontmatter ?? {};
			const term = frontmatter.term ?? "Untitled term";
			return {
				href: readItemPath("glossary", slug),
				title: isFallback ? `${term} (not yet translated)` : term,
			};
		},
		sort: (a, b) => a.title.localeCompare(b.title),
	},
);
const localizedLede = buildTranslationLede(
	"The terms this book uses, defined.",
	completeness,
);
---
<BaseLayout title={bookPageTitle("Glossary", bookConfig.title)}>
  <ContentIndexList
    title="Glossary"
    lede={localizedLede}
    items={entryItems}
    filterMode="always"
    filterPlaceholder="Filter terms"
    alphaMode="always"
  />
</BaseLayout>
