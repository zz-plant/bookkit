---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { getBookExportLinks } from "../../../lib/exports";

const modules = Object.entries(
  import.meta.glob("../../../content/book/chapters/*.mdx", { eager: true })
).map(([path, module]) => {
  const frontmatter = module.frontmatter ?? {};
  return {
    path,
    slug: frontmatter.slug,
    title: frontmatter.title ?? "Untitled chapter",
    status: frontmatter.status ?? "draft",
  };
});

const chapters = modules.sort((a, b) => a.path.localeCompare(b.path));
const chapterItems = chapters.map((chapter) => ({
  href: `/read/chapters/${chapter.slug}`,
  title: chapter.title,
  eyebrow: chapter.status,
}));
const exportLinks = getBookExportLinks();
---
<BaseLayout title="Chapters • Bad People">
  <ContentIndexList
    title="Chapters"
    lede="Module outlines that define the intervention frame."
    items={chapterItems}
  >
    <ExportPanel
      slot="after-header"
      title="Download exports"
      description="Grab a print-ready PDF or an EPUB for offline reading."
      links={exportLinks}
    />
  </ContentIndexList>
</BaseLayout>
