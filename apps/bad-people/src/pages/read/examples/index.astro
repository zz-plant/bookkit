---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath } from "../../../lib/read-routes";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.examples;
const { items: exampleItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const title = frontmatter.title ?? "Untitled example";
    return {
      href: readItemPath("examples", slug),
      title: isFallback ? `${title} (fallback)` : title,
      eyebrow: frontmatter.status ?? "draft",
      meta: `${frontmatter.mechanism ?? "general"} • ${frontmatter.domain ?? "unknown"}`,
    };
  },
  sort: (a, b) => a.title.localeCompare(b.title),
});
const localizedLede = buildTranslationLede(
  "Replaceable cases that ground each mechanism.",
  completeness
);
---
<BaseLayout title={`Examples • ${bookConfig.title}`}>
  <ContentIndexList
    title="Examples"
    lede={localizedLede}
    items={exampleItems}
    filterMode="always"
    filterPlaceholder="Filter by example, mechanism, or domain..."
    filterHint="Filter by example title, mechanism, or domain."
    alphaMode="always"
  />
</BaseLayout>
