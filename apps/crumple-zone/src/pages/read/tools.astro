---
import { readRoutes, runtimeFeatures } from "@bookkit/astro-bookkit";
import ToolsPage from "@bookkit/astro-bookkit/components/ToolsPage.astro";
import bookConfig from "../../book.config";
import { getVersionEntries } from "../../lib/versions";

const toolLinks = [
	{
		title: "Analytics",
		description: "Views, time on page, drop-off, and reader feedback.",
		href: readRoutes.analytics,
	},
	{
		title: "Release notes",
		description: "What changed in each published version.",
		href: "/release-notes",
	},
	{
		title: "Downloads",
		description: "PDF and EPUB exports of the book and each chapter.",
		href: "/downloads",
	},
];

const versionEntries = getVersionEntries();
const currentVersion =
	versionEntries.find((entry) => entry.isLatest)?.version ?? bookConfig.status;
---
<ToolsPage
  title={`Tools • ${bookConfig.title}`}
  bookTitle={bookConfig.title}
  bookVersion={currentVersion}
  bookKey={bookConfig.slug ?? "book"}
  backHref={readRoutes.root}
  links={toolLinks}
  {...runtimeFeatures(bookConfig)}
/>