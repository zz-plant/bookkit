---
const {
	slug,
	title,
	contentType = "chapter",
	prompt = "Was this helpful?",
	endpoint,
} = Astro.props;

if (!slug) {
	throw new Error("FeedbackWidget requires a slug prop.");
}

const noteId = `feedback-note-${String(slug).replace(/[^a-zA-Z0-9_-]+/g, "-")}`;
---
<div
  class="feedback-widget"
  data-feedback-widget
  data-feedback-slug={slug}
  data-feedback-title={title}
  data-feedback-type={contentType}
  data-feedback-endpoint={endpoint}
>
  <div class="feedback-widget__main">
    <span class="feedback-widget__prompt">{prompt}</span>
    <div class="feedback-widget__actions">
      <button
        type="button"
        class="feedback-widget__button"
        data-feedback-choice="helpful"
        aria-pressed="false"
      >
        <span aria-hidden="true">👍</span> Yes
      </button>
      <button
        type="button"
        class="feedback-widget__button"
        data-feedback-choice="not_helpful"
        aria-pressed="false"
      >
        <span aria-hidden="true">👎</span> No
      </button>
    </div>
    <div class="feedback-widget__emoji" aria-label="Reactions">
      <button type="button" data-feedback-choice="emoji:😀" aria-label="Happy" aria-pressed="false">😀</button>
      <button type="button" data-feedback-choice="emoji:🤔" aria-label="Thoughtful" aria-pressed="false">🤔</button>
      <button type="button" data-feedback-choice="emoji:😕" aria-label="Confused" aria-pressed="false">😕</button>
      <button type="button" data-feedback-choice="emoji:🔥" aria-label="Excited" aria-pressed="false">🔥</button>
    </div>
  </div>

  <div class="feedback-widget__step2" id={noteId} data-feedback-note hidden>
    <label class="feedback-widget__note-label">
      <span class="sr-only">Optional note</span>
      <textarea
        rows="2"
        maxlength="240"
        placeholder="Anything specific to share? (optional)"
        data-feedback-comment
      ></textarea>
    </label>
    <div class="feedback-widget__step2-actions">
      <button type="button" class="feedback-widget__submit" data-feedback-submit>
        Send
      </button>
      <button type="button" class="feedback-widget__skip" data-feedback-skip>
        Skip note
      </button>
    </div>
  </div>
  <div class="feedback-widget__status" data-feedback-status aria-live="polite"></div>
</div>

<script>
  import { WebHaptics } from "web-haptics";

  const RATE_LIMIT_MS = 1000 * 60 * 60 * 24;

  type FeedbackEvent = {
    eventType: string;
    timestamp: number;
    slug?: string;
    [key: string]: unknown;
  };

  const sanitizeComment = (value: string) => {
    if (!value) return "";
    return value
      .replace(/https?:\/\/\S+/gi, "")
      .replace(/www\.\S+/gi, "")
      .replace(/[\u0000-\u001F\u007F]+/g, " ")
      .replace(/\s+/g, " ")
      .trim()
      .slice(0, 240);
  };

  const loadEvents = (storageKey: string): FeedbackEvent[] => {
    try {
      const stored = localStorage.getItem(storageKey);
      const parsed = stored ? JSON.parse(stored) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch (error) {
      return [];
    }
  };

  const resolveEndpoint = (value: string | undefined) => {
    if (!value || typeof value !== "string") return null;
    try {
      const url = new URL(value, window.location.origin);
      if (url.protocol === "http:" || url.protocol === "https:") {
        return url.toString();
      }
    } catch (error) {
      return null;
    }
    return null;
  };

  const sendToEndpoint = async (endpoint: string | null, event: FeedbackEvent) => {
    if (!endpoint) return;
    const payload = JSON.stringify(event);
    if (navigator.sendBeacon) {
      navigator.sendBeacon(endpoint, payload);
      return;
    }
    try {
      await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: payload,
      });
    } catch (error) {
      // Ignore submission errors for now.
    }
  };

  const prefersReducedMotion =
    window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches ?? false;
  const haptics = !prefersReducedMotion && WebHaptics.isSupported
    ? new WebHaptics({ showSwitch: false })
    : null;

  const pulseHaptic = (preset = "selection") => {
    if (!haptics) return;
    haptics.trigger(preset);
  };

  const saveEvent = (storageKey: string, event: FeedbackEvent) => {
    const events = loadEvents(storageKey);
    events.push(event);
    localStorage.setItem(storageKey, JSON.stringify(events.slice(-400)));
  };

  const getRecentSubmission = (events: FeedbackEvent[], slug: string | undefined) => {
    const recent = [...events]
      .filter((event) => event.eventType === "feedback" && event.slug === slug)
      .sort((a, b) => b.timestamp - a.timestamp)[0];
    return recent && Date.now() - recent.timestamp < RATE_LIMIT_MS ? recent : null;
  };

  const renderWidget = (widget: HTMLElement) => {
    const slug = widget.dataset.feedbackSlug;
    const title = widget.dataset.feedbackTitle || slug;
    const contentType = widget.dataset.feedbackType || "chapter";
    const endpoint = resolveEndpoint(widget.dataset.feedbackEndpoint);
    const status = widget.querySelector<HTMLElement>("[data-feedback-status]");
    const notePanel = widget.querySelector<HTMLElement>("[data-feedback-note]");
    const commentField = widget.querySelector<HTMLTextAreaElement>("[data-feedback-comment]");
    const submitButton = widget.querySelector<HTMLButtonElement>("[data-feedback-submit]");
    const skipButton = widget.querySelector<HTMLButtonElement>("[data-feedback-skip]");
    const choiceButtons = Array.from(
      widget.querySelectorAll<HTMLButtonElement>("[data-feedback-choice]")
    );

    const analyticsKeyPrefix = document.body?.dataset?.analyticsKey || "book";
    const storageKey = `${analyticsKeyPrefix}.feedback.events`;
    const version = document.body?.dataset?.bookVersion || "draft";
    const impressionKey = `${analyticsKeyPrefix}.feedback.impression.${slug}`;

    const announce = (message: string) => {
      if (status) status.textContent = message;
    };

    const disable = () => {
      widget.classList.add("is-submitted");
      choiceButtons.forEach((button) => (button.disabled = true));
      if (notePanel) notePanel.hidden = true;
      if (submitButton) submitButton.disabled = true;
      if (skipButton) skipButton.disabled = true;
      if (commentField) commentField.disabled = true;
    };

    const events = loadEvents(storageKey);
    const recent = getRecentSubmission(events, slug);

    if (!sessionStorage.getItem(impressionKey)) {
      const impressionEvent = {
        id: `impression-${Date.now()}-${Math.random().toString(16).slice(2)}`,
        eventType: "impression",
        timestamp: Date.now(),
        slug,
        title,
        contentType,
        version,
      };
      saveEvent(storageKey, impressionEvent);
      sendToEndpoint(endpoint, impressionEvent);
      sessionStorage.setItem(impressionKey, "1");
    }

    if (recent) {
      announce("Thanks! Feedback was already sent recently.");
      disable();
      return;
    }

    let selectedChoice: string | null = null;

    const submitFeedback = (choice: string | null, comment: string) => {
      if (!choice) {
        announce("Select a reaction before sending your note.");
        return;
      }
      const timestamp = Date.now();
      const isEmoji = choice.startsWith("emoji:");
      const feedbackEvent = {
        id: `feedback-${timestamp}-${Math.random().toString(16).slice(2)}`,
        eventType: "feedback",
        timestamp,
        slug,
        title,
        contentType,
        version,
        responseType: isEmoji ? "emoji" : choice,
        emoji: isEmoji ? choice.replace("emoji:", "") : null,
        comment: sanitizeComment(comment),
      };
      saveEvent(storageKey, feedbackEvent);
      sendToEndpoint(endpoint, feedbackEvent);
      pulseHaptic("success");
      announce("Thanks for your feedback!");
      disable();
    };

    choiceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        pulseHaptic("selection");
        selectedChoice = button.dataset.feedbackChoice || null;
        choiceButtons.forEach((btn) =>
          btn.classList.toggle("is-selected", btn === button)
        );
        choiceButtons.forEach((btn) => {
          btn.setAttribute("aria-pressed", btn === button ? "true" : "false");
        });

        // Open step 2 smoothly for optional note
        if (notePanel) {
          notePanel.hidden = false;
          commentField?.focus();
        }
      });
    });

    submitButton?.addEventListener("click", () => {
      submitFeedback(selectedChoice, commentField?.value ?? "");
    });

    skipButton?.addEventListener("click", () => {
      submitFeedback(selectedChoice, "");
    });
  };

  document.querySelectorAll<HTMLElement>("[data-feedback-widget]").forEach(renderWidget);
  window.addEventListener("pagehide", () => haptics?.destroy(), { once: true });
</script>
