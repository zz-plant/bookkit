---
import { QA_MODEL_DOWNLOAD } from "./qa-model-consent";

type Props = {
	aiQaSamples?: string[];
};

const { aiQaSamples = [] } = Astro.props;
const {
	models: [embeddingModel, rerankModel],
	modelMegabytes,
	modelHost,
	runtimeMegabytes,
	runtimeHost,
} = QA_MODEL_DOWNLOAD;
---
<div class="qa-panel" id="qa-panel" data-qa-panel hidden>
  <div
    class="qa-panel__content"
    role="dialog"
    aria-modal="true"
    aria-label="Ask about the book"
    data-qa-content
  >
    <div class="qa-panel__header">
      <strong>Ask the book</strong>
      <div class="qa-panel__actions">
        <button type="button" class="qa-panel__toggle" data-qa-disable>
          Turn off
        </button>
        <button type="button" class="kbd-close" data-qa-close aria-label="Esc: close Ask the book">
          Esc
        </button>
      </div>
    </div>
    <div class="qa-panel__body" data-qa-body>
      <p class="meta">
        Answers are drawn only from this book and cite the sections they come from.
      </p>
      <form class="qa-panel__form" data-qa-form>
        <label class="qa-panel__field">
          <span class="sr-only">Ask a question about the book</span>
          <textarea
            rows="2"
            placeholder="Ask a question about the book..."
            autocomplete="off"
            spellcheck="false"
            aria-describedby="qa-status"
            data-qa-input
          ></textarea>
        </label>
        <button type="submit" class="qa-panel__submit">Ask</button>
      </form>
      <div
        class="qa-panel__consent"
        role="group"
        aria-labelledby="qa-consent-title"
        aria-describedby="qa-consent-detail qa-consent-decline"
        tabindex="-1"
        data-qa-consent
        hidden
      >
        <h3 id="qa-consent-title" class="qa-panel__consent-title">Download two models to rank passages?</h3>
        <p id="qa-consent-detail" class="qa-panel__consent-text">
          Ask finds the passages that answer a question with two models that run in your browser,
          <code class="qa-panel__model">{embeddingModel}</code> and
          <code class="qa-panel__model">{rerankModel}</code>.
          They are about {modelMegabytes} MB from Hugging Face ({modelHost}), with a {runtimeMegabytes} MB
          runtime from jsDelivr ({runtimeHost}). Your browser keeps them, so they download once.
        </p>
        <p id="qa-consent-decline" class="qa-panel__consent-text meta">
          Not now: Ask still answers, matching passages by the words in your question.
        </p>
        <div class="qa-panel__consent-actions">
          <button type="button" class="qa-panel__submit" data-qa-consent-download>
            Download
          </button>
          <button type="button" class="qa-panel__toggle" data-qa-consent-decline>
            Not now
          </button>
        </div>
      </div>
      <p class="qa-panel__meta" data-qa-models-off hidden>
        Passages are matched by their words.
        <button type="button" class="qa-panel__link-button" data-qa-models-ask>
          Rank them with models instead
        </button>
      </p>
      <div class="qa-panel__display" role="group" aria-label="Answer display mode">
        <span class="meta">Show</span>
        <button type="button" class="qa-panel__display-toggle" data-qa-display-toggle>
          Show citations first
        </button>
      </div>
      <div class="qa-panel__meta" id="qa-status" role="status" aria-live="polite" data-qa-status>
        Ask a question to see answers.
      </div>
      <div class="qa-panel__suggestions">
        <div class="eyebrow">Try asking</div>
        <div class="qa-panel__suggestion-list">
          {aiQaSamples.map((prompt) => (
            <button type="button" class="qa-panel__suggestion" data-qa-suggestion>{prompt}</button>
          ))}
        </div>
      </div>
      <div class="qa-panel__answer" data-qa-answer>
        <p class="meta">No answer yet.</p>
      </div>
      <div class="qa-panel__citations" data-qa-citations></div>
    </div>
    <div class="qa-panel__disabled" data-qa-disabled hidden>
      <p>Ask the book is turned off in this browser.</p>
      <button type="button" class="qa-panel__submit" data-qa-enable>
        Turn it back on
      </button>
    </div>
  </div>
</div>
