---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const modules = Object.values(
    import.meta.glob("../../../content/book/glossary/*.mdx", { eager: true })
  );

  return modules.map((module) => ({
    params: { slug: module.frontmatter.slug },
    props: {
      frontmatter: module.frontmatter,
      Content: module.default,
    },
  }));
}

const { frontmatter, Content } = Astro.props;
---
<BaseLayout title={`${frontmatter.term} • Bad People`}>
  <a class="back-link" href="/read/glossary">← Glossary</a>
  <div class="eyebrow">Glossary</div>
  <h1 id={frontmatter.slug}>{frontmatter.term}</h1>
  <section class="content-block">
    <Content />
  </section>
</BaseLayout>
