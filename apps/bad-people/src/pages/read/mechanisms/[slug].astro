---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const modules = Object.values(
    import.meta.glob("../../../content/book/mechanisms/*.mdx", { eager: true })
  );

  return modules.map((module) => ({
    params: { slug: module.frontmatter.slug },
    props: {
      frontmatter: module.frontmatter,
      Content: module.default,
    },
  }));
}

const { frontmatter, Content } = Astro.props;
const metaDescription = frontmatter.definition;
---
<BaseLayout title={`${frontmatter.title} • Bad People`} description={metaDescription}>
  <a class="back-link" href="/read/mechanisms">← Mechanisms</a>
  <div class="eyebrow">Mechanism</div>
  <h1 id={frontmatter.slug}>{frontmatter.title}</h1>
  <p class="lede">{frontmatter.definition}</p>
  <section class="content-block">
    <Content />
  </section>
</BaseLayout>
