---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";

const entries = Object.values(
  import.meta.glob("../../../content/book/glossary/*.mdx", { eager: true })
)
  .map((module) => ({
    slug: module.frontmatter.slug,
    term: module.frontmatter.term ?? "Untitled term",
  }))
  .sort((a, b) => a.term.localeCompare(b.term));
const entryItems = entries.map((entry) => ({
  href: `/read/glossary/${entry.slug}`,
  title: entry.term,
}));
---
<BaseLayout title="Glossary • Bad People">
  <ContentIndexList
    title="Glossary"
    lede="Shared language that keeps mechanisms stable."
    items={entryItems}
  />
</BaseLayout>
