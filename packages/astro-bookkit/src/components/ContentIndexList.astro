---
export type ContentIndexItem = {
  href: string;
  title: string;
  eyebrow?: string | null;
  meta?: string | null;
  badges?: string[] | null;
};

const {
  title,
  lede,
  items = [],
  backHref = "/read",
  backLabel = "Reading hub",
  filterLabel = "Filter list",
  filterPlaceholder = "Filter by title, mechanism, or domain...",
  filterMode = "auto",
  filterHint,
  alphaMode = "auto",
  itemActionLabel,
} = Astro.props;

const resolvedItems = Array.isArray(items) ? items : [];
const shouldAutoFilter = resolvedItems.length > 6;
const showFilter =
  filterMode === true ||
  filterMode === "always" ||
  (filterMode === "auto" && shouldAutoFilter);
const shouldAutoAlpha = resolvedItems.length > 10;
const showAlphaNav =
  alphaMode === true ||
  alphaMode === "always" ||
  (alphaMode === "auto" && shouldAutoAlpha);
const alphaGroups = resolvedItems.reduce((groups, item) => {
  const raw = item.title?.trim()?.charAt(0)?.toUpperCase() ?? "#";
  const key = /[A-Z]/.test(raw) ? raw : "#";
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)?.push(item);
  return groups;
}, new Map());
const alphaKeys = Array.from(alphaGroups.keys());
const listSummary = `${resolvedItems.length} ${resolvedItems.length === 1 ? "item" : "items"}`;
const showDensityToggle = resolvedItems.length > 9;
const filterId = `list-filter-${String(title ?? "items")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-+|-+$/g, "")}`;
---
<a class="back-link" href={backHref}>← {backLabel}</a>
<div class="section-header">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</div>
<slot name="after-header" />
<section class="list-tools" aria-label="List tools">
  <p class="list-summary">{listSummary}{showAlphaNav ? ` • ${alphaKeys.length} groups` : ""}</p>
  {showDensityToggle && (
    <div class="list-density-toggle" role="group" aria-label="List density">
      <span class="list-density-toggle__label">Density</span>
      <button class="list-density-toggle__button" type="button" data-list-density="comfortable" aria-pressed="true">
        Comfortable
      </button>
      <button class="list-density-toggle__button" type="button" data-list-density="compact" aria-pressed="false">
        Compact
      </button>
    </div>
  )}
  {showFilter && (
    <div class="list-filter">
      <label class="list-filter__label" for={filterId}>
        {filterLabel}
      </label>
      <input
        id={filterId}
        class="list-filter__input"
        type="search"
        placeholder={filterPlaceholder}
        autocomplete="off"
        spellcheck="false"
        data-list-filter={filterId}
      />
      {filterHint && <p class="list-filter__hint">{filterHint}</p>}
    </div>
  )}
  {showAlphaNav && alphaKeys.length > 0 && (
    <nav class="alpha-nav" aria-label="Jump to letter">
      <span class="alpha-nav__label">Jump to letter</span>
      {alphaKeys.map((letter) => (
        <a class="alpha-nav__link" href={`#alpha-${letter}`}>{letter}</a>
      ))}
    </nav>
  )}
  <slot name="list-tools-extra" />
</section>
<div class="stack list-stack" data-list-container={filterId} data-list-density="comfortable">
  {showAlphaNav
    ? alphaKeys.map((letter) => (
        <section class="alpha-group" data-alpha-group>
          <h2 class="alpha-group__letter" id={`alpha-${letter}`}>
            {letter}
          </h2>
          <div class="stack" data-alpha-items>
            {alphaGroups.get(letter)?.map((item) => (
              <a
                class="list-link"
                href={item.href}
                data-list-item
                data-filter-text={`${item.title ?? ""} ${item.meta ?? ""} ${item.eyebrow ?? ""}`.toLowerCase()}
              >
                {(item.eyebrow || item.badges?.length) && (
                  <div class="list-link__meta-row">
                    {item.eyebrow && <span class="eyebrow">{item.eyebrow}</span>}
                    {item.badges?.length ? (
                      <span class="list-link__badges" aria-label="Entry metadata">
                        {item.badges.map((badge) => (
                          <span class="list-link__badge">{badge}</span>
                        ))}
                      </span>
                    ) : null}
                  </div>
                )}
                <strong>{item.title}</strong>
                {item.meta && <span class="meta">{item.meta}</span>}
                {itemActionLabel && <span class="list-link__action">{itemActionLabel} →</span>}
              </a>
            ))}
          </div>
        </section>
      ))
    : resolvedItems.map((item) => (
        <a
          class="list-link"
          href={item.href}
          data-list-item
          data-filter-text={`${item.title ?? ""} ${item.meta ?? ""} ${item.eyebrow ?? ""}`.toLowerCase()}
        >
          {(item.eyebrow || item.badges?.length) && (
            <div class="list-link__meta-row">
              {item.eyebrow && <span class="eyebrow">{item.eyebrow}</span>}
              {item.badges?.length ? (
                <span class="list-link__badges" aria-label="Entry metadata">
                  {item.badges.map((badge) => (
                    <span class="list-link__badge">{badge}</span>
                  ))}
                </span>
              ) : null}
            </div>
          )}
          <strong>{item.title}</strong>
          {item.meta && <span class="meta">{item.meta}</span>}
          {itemActionLabel && <span class="list-link__action">{itemActionLabel} →</span>}
        </a>
      ))}
</div>
<div class="list-empty" data-list-empty hidden style="padding: var(--space-6); text-align: center; border: 1px dashed var(--color-border); border-radius: var(--radius-card); margin: var(--space-4) 0;">
  <p style="margin: 0; color: var(--color-muted);">No matching entries found.</p>
  <button type="button" class="pill" data-list-reset style="margin-top: var(--space-3); cursor: pointer;">Clear filter</button>
</div>
<slot name="after-list" />
{(showFilter || showDensityToggle) && (
  <script define:vars={{ filterId }}>
    const input = document.querySelector(`[data-list-filter="${filterId}"]`);
    const list = document.querySelector(`[data-list-container="${filterId}"]`);
    const emptyState = document.querySelector(`[data-list-empty]`);
    const resetButton = document.querySelector(`[data-list-reset]`);
    if (list) {
      const items = Array.from(list.querySelectorAll("[data-list-item]"));
      const groups = Array.from(list.querySelectorAll("[data-alpha-group]"));
      const densityButtons = Array.from(document.querySelectorAll("button[data-list-density]"));
      const applyFilter = () => {
        const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : "";
        let visibleCount = 0;
        items.forEach((item) => {
          const text = item.dataset.filterText || "";
          const isHidden = query.length > 0 && !text.includes(query);
          item.hidden = isHidden;
          if (!isHidden) visibleCount++;
        });
        groups.forEach((group) => {
          const visibleItems = group.querySelectorAll("[data-list-item]:not([hidden])");
          group.hidden = visibleItems.length === 0;
        });
        if (emptyState) {
          emptyState.hidden = visibleCount > 0 || items.length === 0;
        }
      };
      if (input instanceof HTMLInputElement) {
        input.addEventListener("input", applyFilter);
      }
      if (resetButton && input instanceof HTMLInputElement) {
        resetButton.addEventListener("click", () => {
          input.value = "";
          applyFilter();
          input.focus();
        });
      }
      densityButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const density = button.getAttribute("data-list-density") || "comfortable";
          list.setAttribute("data-list-density", density);
          densityButtons.forEach((entry) => {
            entry.setAttribute("aria-pressed", entry === button ? "true" : "false");
          });
        });
      });
    }
  </script>
)}
