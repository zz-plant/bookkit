---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../lib/book-entrypoints";
import { createLatestSectionChangeMap, formatTranslationCompleteness, readRoutes } from "@bookkit/astro-bookkit";
import { getReleaseNotes } from "../../lib/release-notes";
import bookConfig from "../../book.config";

const chapterIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.chapters,
  {
    defaultLocale: "en",
  }
);
const mechanismIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.mechanisms,
  {
    defaultLocale: "en",
  }
);
const toolkitIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.toolkit,
  {
    defaultLocale: "en",
  }
);
const glossaryIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.glossary,
  {
    defaultLocale: "en",
  }
);
const exampleIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.examples,
  {
    defaultLocale: "en",
  }
);
const localeKey = Astro.locals?.locale;
const chapters = resolveLocalizedContent(chapterIndex, { locale: localeKey });
const mechanisms = resolveLocalizedContent(mechanismIndex, { locale: localeKey });
const toolkit = resolveLocalizedContent(toolkitIndex, { locale: localeKey });
const glossary = resolveLocalizedContent(glossaryIndex, { locale: localeKey });
const examples = resolveLocalizedContent(exampleIndex, { locale: localeKey });

const releaseNotes = getReleaseNotes();
const latestSectionChanges = createLatestSectionChangeMap(releaseNotes);
const readerSections = [
  {
    title: "Overview",
    description: "Objectives, frame, and constraints for this draft.",
    href: readRoutes.overview,
    count: 1,
    keyHint: ["g", "o"],
    sectionKey: "overview",
  },
  {
    title: "Chapters",
    description: "Core modules and the intervention frame.",
    href: readRoutes.chapters,
    count: chapters.entries.length,
    completeness: chapters.completeness,
    keyHint: ["g", "c"],
    sectionKey: "chapters",
  },
  {
    title: "Mechanisms",
    description: "Named system patterns with stable definitions.",
    href: readRoutes.mechanisms,
    count: mechanisms.entries.length,
    completeness: mechanisms.completeness,
    keyHint: ["g", "m"],
    sectionKey: "mechanisms",
  },
  {
    title: "Toolkit",
    description: "Action primitives that fit inside ten minutes.",
    href: readRoutes.toolkit,
    count: toolkit.entries.length,
    completeness: toolkit.completeness,
    keyHint: ["g", "t"],
    sectionKey: "toolkit",
  },
  {
    title: "Glossary",
    description: "Short definitions to keep shared language consistent.",
    href: readRoutes.glossary,
    count: glossary.entries.length,
    completeness: glossary.completeness,
    keyHint: ["g", "l"],
    sectionKey: "glossary",
  },
  {
    title: "Examples",
    description: "Replaceable cases that ground the modules.",
    href: readRoutes.examples,
    count: examples.entries.length,
    completeness: examples.completeness,
    keyHint: ["g", "e"],
    sectionKey: "examples",
  },
];
const sectionBuckets = [
  {
    title: "Start here",
    description: "Orientation and first-pass reading.",
    sections: ["overview", "chapters"],
  },
  {
    title: "Solve now",
    description: "Diagnose patterns and pick a ten-minute action.",
    sections: ["mechanisms", "toolkit"],
  },
  {
    title: "Reference",
    description: "Shared language and replaceable examples.",
    sections: ["glossary", "examples"],
  },
];
---
<BaseLayout title={`Read • ${bookConfig.title}`}>
  <div class="read-hub">
    <section class="content-block read-hero" style="margin-top: 0;">
      <div class="read-hero__copy">
        <div class="eyebrow">Reading hub</div>
        <h1>Pick a route, then move forward in one click.</h1>
        <p class="lede">
          Use the buckets below: start, solve, or reference. Each path keeps labels and next actions consistent.
        </p>
      </div>
      <div class="read-hero__quicklinks" aria-label="Quick ways to start" data-funnel-group="read-start">
        <a class="read-pill" href="#start-here" data-funnel-step="read_to_start_here">Start here</a>
        <a class="read-pill" href="#solve-now" data-funnel-step="read_to_solve_now">Solve now</a>
        <a class="read-pill" href="#reference" data-funnel-step="read_to_reference">Reference</a>
      </div>
      <div class="quick-start-grid" aria-label="Quick start paths">
        <a class="card quick-start-card" href={readRoutes.chapters} data-funnel-step="quickstart_chapter_first">
          <div class="eyebrow">Start here</div>
          <h2>Read chapter-first</h2>
          <p class="meta">Follow the core arc from orientation to action.</p>
        </a>
        <a class="card quick-start-card" href={readRoutes.overview} data-funnel-step="quickstart_frame_first">
          <div class="eyebrow">Understand the frame</div>
          <h2>Scan objectives and constraints</h2>
          <p class="meta">Get the model before diving into modules.</p>
        </a>
        <a class="card quick-start-card" href={readRoutes.mechanisms} data-funnel-step="quickstart_problem_first">
          <div class="eyebrow">Solve a specific problem</div>
          <h2>Jump straight to mechanism matching</h2>
          <p class="meta">Find the pattern, then move to toolkit actions.</p>
        </a>
      </div>
    </section>

    <section class="content-block read-section" id="reading-surfaces">
      <div class="read-section__intro">
        <div>
          <div class="eyebrow">Route buckets</div>
          <h2>Choose one bucket and begin</h2>
        </div>
        <p class="meta">Start, solve, and reference routes are intentionally separated.</p>
      </div>
      <div class="bucket-grid">
        {sectionBuckets.map((bucket) => (
          <article
            class:list={["card", "bucket-card", { "bucket-card--primary": bucket.title === "Start here" }]}
            id={bucket.title.toLowerCase().replace(" ", "-")}
          >
            <div class="eyebrow">{bucket.title}</div>
            <h3>{bucket.title}</h3>
            <p class="meta">{bucket.description}</p>
            <div class="card-grid" data-reader-sections>
              {readerSections.filter((section) => bucket.sections.includes(section.sectionKey)).map((section) => {
          const label = section.count === 1 ? "item" : "items";
          const keyShortcut = section.keyHint ? section.keyHint.join(" ") : undefined;
          const completenessLabel = formatTranslationCompleteness(section.completeness);
          const changeMeta = latestSectionChanges[section.sectionKey];
          return (
            <a
              class="card read-surface-card"
              href={section.href}
              aria-keyshortcuts={keyShortcut}
              data-section-key={section.sectionKey}
              data-change-date={changeMeta?.date ?? ""}
            >
              <div class="read-surface-card__meta" aria-label="Section metadata">
                <span class="read-meta-chip">{section.count} {label}</span>
                {completenessLabel && <span class="read-meta-chip read-meta-chip--status">{completenessLabel}</span>}
                {changeMeta && (
                  <>
                    <span class="read-meta-chip read-meta-chip--update">Marked in v{changeMeta.version} notes</span>
                    <span class="read-meta-chip read-meta-chip--new" data-read-new hidden>New for you</span>
                  </>
                )}
              </div>
              <h4>{section.title}</h4>
              <p class="meta">{section.description}</p>
              {section.keyHint && (
                <div class="read-surface-card__shortcut" aria-label="Keyboard shortcut">
                  <span class="kbd-hint"><kbd>{section.keyHint[0]}</kbd><kbd>{section.keyHint[1]}</kbd></span>
                </div>
              )}
            </a>
          );
        })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="tools-by-role" class="content-block read-section" style="margin-top: 0;">
      <div class="read-section__intro">
        <div>
          <div class="eyebrow">Meta</div>
          <h2>Release and maintenance links</h2>
        </div>
        <div class="read-meta-actions">
          <p class="meta">Lower-priority utilities live here so reading routes stay focused.</p>
          <button class="button button--secondary" type="button" data-read-updates-filter hidden>
            Show sections marked in latest release notes
          </button>
        </div>
      </div>
      <div class="card-grid read-tools-grid">
        <article class="card read-tools-card read-tools-card--release" data-release-card>
          <div class="eyebrow">Reader meta</div>
          <h3>Reader updates</h3>
          <p class="meta">Track changes or download an offline copy.</p>
          <div class="read-hero__quicklinks">
            <a class="read-pill" href="/release-notes">See what changed</a>
            <a class="read-pill" href="/downloads">Download for offline reading</a>
          </div>
        </article>
        <article class="card read-tools-card">
          <div class="eyebrow">Author meta</div>
          <h3>Author diagnostics</h3>
          <p class="meta">Open analytics and publishing diagnostics.</p>
          <div class="read-hero__quicklinks">
            <a class="read-pill" href={readRoutes.tools}>Open author diagnostics</a>
          </div>
        </article>
      </div>
    </section>
  </div>
  <script>
    const funnelLinks = document.querySelectorAll("[data-funnel-step]");
    const releaseCard = document.querySelector("[data-release-card]");
    const filterButton = document.querySelector("[data-read-updates-filter]");
    const readCards = Array.from(document.querySelectorAll("[data-section-key]"));
    const visitStorageKey = `${document.body?.dataset?.analyticsKey || "book"}:read:lastVisit`;
    const previousVisit = localStorage.getItem(visitStorageKey);
    const previousVisitMs = previousVisit ? new Date(previousVisit).getTime() : Number.NaN;
    const nowIso = new Date().toISOString();

    if (Number.isFinite(previousVisitMs) && filterButton && readCards.length > 0) {
      filterButton.hidden = false;
      readCards.forEach((card) => {
        const dateValue = card.getAttribute("data-change-date");
        const changeMs = dateValue ? new Date(dateValue).getTime() : Number.NaN;
        const isNew = Number.isFinite(changeMs) && changeMs > previousVisitMs;
        const chip = card.querySelector("[data-read-new]");
        if (chip) chip.hidden = !isNew;
      });

      let isFiltered = false;
      filterButton.addEventListener("click", () => {
        isFiltered = !isFiltered;
        readCards.forEach((card) => {
          const dateValue = card.getAttribute("data-change-date");
          const changeMs = dateValue ? new Date(dateValue).getTime() : Number.NaN;
          const isNew = Number.isFinite(changeMs) && changeMs > previousVisitMs;
          card.hidden = isFiltered ? !isNew : false;
        });
        filterButton.textContent = isFiltered
          ? "Show all sections"
          : "Show sections marked in latest release notes";
      });
    }

    localStorage.setItem(visitStorageKey, nowIso);

    const onboardingKey = "running-hot.reader.started";
    const readOnboardingState = () => {
      try {
        return localStorage.getItem(onboardingKey) === "true";
      } catch {
        return false;
      }
    };
    const markOnboardingStarted = () => {
      try {
        localStorage.setItem(onboardingKey, "true");
      } catch {
        // no-op: private mode or disabled storage
      }
    };

    if (!readOnboardingState() && releaseCard) {
      releaseCard.classList.add("read-tools-card--deemphasized");
      releaseCard.insertAdjacentHTML(
        "beforeend",
        `<p class="meta" data-release-note>Release notes stay secondary until you start reading.</p>`
      );
    }

    funnelLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const step = link.getAttribute("data-funnel-step");
        if (!step) return;
        markOnboardingStarted();
        const payload = JSON.stringify({
          type: "engagement",
          title: `funnel:${step}`,
          path: window.location.pathname,
          durationSeconds: 0,
          scrollDepth: 0,
          timestamp: Date.now(),
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon("/api/analytics.json", new Blob([payload], { type: "application/json" }));
          return;
        }
        fetch("/api/analytics.json", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: payload,
          keepalive: true,
        }).catch(() => undefined);
      });
    });
  </script>
</BaseLayout>

<style>
  .read-hub {
    display: grid;
    gap: 1.25rem;
  }

  .read-hero {
    background: linear-gradient(145deg, rgba(91, 76, 230, 0.08), rgba(255, 255, 255, 0.98));
    border-color: rgba(91, 76, 230, 0.24);
    display: grid;
    gap: 1rem;
  }

  .quick-start-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .quick-start-card {
    text-decoration: none;
    color: inherit;
    display: grid;
    gap: 0.35rem;
  }

  .quick-start-card h2 {
    font-size: 1.1rem;
    margin: 0;
  }

  .read-hero__copy {
    display: grid;
    gap: 0.25rem;
  }

  .read-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
    max-width: 22ch;
  }

  .read-hero .lede {
    max-width: 62ch;
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  .read-hero__quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .read-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 10px;
    border: 1px solid rgba(91, 76, 230, 0.12);
    background: rgba(255, 255, 255, 0.9);
    color: color-mix(in srgb, var(--color-accent-strong) 88%, #303030);
    padding: 0.35rem 0.72rem;
    font-size: 0.84rem;
    font-weight: 500;
  }

  .read-pill:hover {
    border-color: rgba(91, 76, 230, 0.28);
    background: rgba(91, 76, 230, 0.08);
  }

  .read-pill:focus-visible,
  .read-card:focus-visible,
  .read-surface-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .read-section {
    margin-top: 0;
  }

  .read-section__intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .read-section__intro .meta {
    max-width: 34ch;
  }

  .read-card-grid {
    margin-top: 0.75rem;
  }

  .bucket-grid {
    display: grid;
    gap: 1rem;
  }

  .bucket-card {
    gap: 0.75rem;
    border-color: rgba(91, 76, 230, 0.14);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(250, 250, 255, 0.95));
  }

  .bucket-card--primary {
    border-color: rgba(91, 76, 230, 0.34);
    background: linear-gradient(165deg, rgba(91, 76, 230, 0.08), rgba(255, 255, 255, 0.98));
  }

  .bucket-card--primary h3 {
    color: var(--color-accent-strong);
  }

  .read-card,
  .read-surface-card {
    background: linear-gradient(180deg, #fff, #fcfcff);
    border-color: rgba(91, 76, 230, 0.15);
  }

  .read-card:hover,
  .read-surface-card:hover {
    border-color: rgba(91, 76, 230, 0.35);
    transform: translateY(-3px);
  }

  .read-surface-card {
    position: relative;
    min-height: 9rem;
  }

  .read-surface-card h4 {
    margin: 0;
  }

  .read-surface-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .read-meta-chip {
    border-radius: 999px;
    border: 1px solid rgba(31, 31, 31, 0.12);
    background: rgba(31, 31, 31, 0.04);
    color: #2e2e2e;
    font-size: 0.72rem;
    line-height: 1.2;
    font-weight: 600;
    padding: 0.28rem 0.55rem;
    letter-spacing: 0.01em;
  }

  .read-meta-chip--status {
    border-color: rgba(91, 76, 230, 0.24);
    background: rgba(91, 76, 230, 0.08);
  }

  .read-meta-chip--update {
    border-color: rgba(6, 94, 156, 0.26);
    background: rgba(6, 94, 156, 0.1);
    color: #094777;
  }

  .read-meta-chip--new {
    border-color: rgba(6, 110, 56, 0.36);
    background: rgba(6, 110, 56, 0.14);
    color: #0a5d31;
  }

  .read-meta-actions {
    display: grid;
    justify-items: end;
    gap: 0.45rem;
  }

  .read-surface-card__shortcut {
    margin-top: auto;
    justify-content: flex-end;
    display: flex;
  }

  .read-tools-grid {
    margin-top: 0.75rem;
  }

  .read-tools-card {
    display: grid;
    gap: 0.75rem;
  }

  .read-tools-card--deemphasized {
    opacity: 0.82;
  }

  .read-surface-card__footer {
    display: none;
  }

  @media (max-width: 900px) {
    .read-section__intro {
      flex-direction: column;
      align-items: flex-start;
    }

    .read-meta-actions {
      justify-items: start;
    }

    .read-hero {
      padding: 1.25rem;
    }

    .read-hero .lede {
      font-size: 1rem;
    }
  }
</style>
