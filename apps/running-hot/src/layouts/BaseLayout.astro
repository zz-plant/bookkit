---
import BookLayout from "@bookkit/astro-bookkit/layouts/BookLayout.astro";
import {
  createBookLayoutState,
} from "@bookkit/astro-bookkit";
import bookConfig from "../book.config";
import { bookEntryPoints } from "../lib/book-entrypoints";
import { getVersionEntries } from "../lib/versions";

const versionEntries = getVersionEntries();
const layoutState = createBookLayoutState({
  astro: {
    props: Astro.props,
    locals: Astro.locals,
    url: Astro.url,
  },
  bookConfig,
  versionEntries,
  localizedContentModules: bookEntryPoints.localizedContentModules,
  versionPrefix: "v",
});
const {
  seoProps,
  previewContext,
  previewRobots,
  resolvedVersion,
  resolvedLocales,
  bookTitle,
  bookKey,
  aiQaEnabled,
  currentLocale,
  defaultLocale,
  includeDefaultLocalePrefix,
  localeLabel,
} = layoutState;
const pathname = Astro.url.pathname;
const isReadContext = pathname === "/read" || pathname.includes("/read/");
---
<BookLayout
  title={Astro.props.title}
  bookTitle={bookTitle}
  bookVersion={resolvedVersion}
  bookKey={bookKey}
  aiQaEnabled={aiQaEnabled}
  versions={versionEntries}
  locales={resolvedLocales}
  currentLocale={currentLocale}
  defaultLocale={defaultLocale}
  includeDefaultLocalePrefix={includeDefaultLocalePrefix}
  localeLabel={localeLabel}
  {...seoProps}
  robots={previewRobots ?? seoProps.robots}
  isPreview={previewContext?.isPreview ?? false}
  previewLabel={previewContext?.label ?? "Preview"}
  previewTokenHint={previewContext?.tokenHint}
  previewExpiresAt={previewContext?.expiresAt}
>
  {
    isReadContext && (
      <nav class="read-meta-nav" aria-label="Reading utilities">
        <a class="read-meta-nav__link" href="/release-notes">Release notes</a>
        <a class="read-meta-nav__link" href="/downloads">Downloads</a>
      </nav>
    )
  }
  <slot />
</BookLayout>

<style>
  .read-meta-nav {
    margin: 0 0 1rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .read-meta-nav__link {
    display: inline-flex;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent-strong) 30%, white);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-accent-strong) 88%, #202020);
    background: color-mix(in srgb, var(--color-accent-soft) 30%, white);
    text-decoration: none;
  }

  .read-meta-nav__link:hover {
    border-color: color-mix(in srgb, var(--color-accent-strong) 55%, white);
    background: color-mix(in srgb, var(--color-accent-soft) 40%, white);
  }
</style>
