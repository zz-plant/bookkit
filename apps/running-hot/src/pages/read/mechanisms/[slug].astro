---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import bookConfig from "../../../book.config";
import Breadcrumbs from "@bookkit/astro-bookkit/components/Breadcrumbs.astro";
import NextActionPanel from "@bookkit/astro-bookkit/components/NextActionPanel.astro";
import { getReadPageBreadcrumbCopy } from "../../../lib/read-copy";
import {
  buildLocalizedReadRoutePath,
  createBreadcrumbListStructuredDataFromTrail,
  createDefinedTermStructuredData,
  readItemPath,
  readRoutes,
} from "@bookkit/astro-bookkit";

export async function getStaticPaths() {
  const modules = bookEntryPoints.contentModules.mechanisms;
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = bookEntryPoints.contentModules.mechanisms;
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing mechanism for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const metaDescription = frontmatter.definition;
const isFallback = missingSlugs.includes(frontmatter.slug);
const hasPredictions =
  Array.isArray(frontmatter.predictions) && frontmatter.predictions.length > 0;
const hasTests = Array.isArray(frontmatter.tests) && frontmatter.tests.length > 0;
const hasIs = Array.isArray(frontmatter.is) && frontmatter.is.length > 0;
const hasIsNot = Array.isArray(frontmatter.isNot) && frontmatter.isNot.length > 0;
const toolkitIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.toolkit,
  {
    defaultLocale: "en",
  }
);
const exampleIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.examples,
  {
    defaultLocale: "en",
  }
);
const { entries: toolkitEntries } = resolveLocalizedContent(toolkitIndex, {
  locale: Astro.locals?.locale,
});
const { entries: exampleEntries } = resolveLocalizedContent(exampleIndex, {
  locale: Astro.locals?.locale,
});
const relatedToolkit = toolkitEntries
  .map(({ slug, module: toolkitModule }) => ({
    slug,
    frontmatter: toolkitModule.frontmatter ?? {},
  }))
  .filter((entry) => entry.frontmatter.mechanism === frontmatter.slug)
  .sort(
    (a, b) =>
      (a.frontmatter.timeboxMinutes ?? 10) - (b.frontmatter.timeboxMinutes ?? 10)
  );
const relatedExamples = exampleEntries
  .map(({ slug, module: exampleModule }) => ({
    slug,
    frontmatter: exampleModule.frontmatter ?? {},
  }))
  .filter((entry) => entry.frontmatter.mechanism === frontmatter.slug);
const requestPath = Astro.url.pathname;
const mechanismUrl = new URL(requestPath, Astro.url).toString();
const localizedReadRootPath = buildLocalizedReadRoutePath(requestPath, readRoutes.root);
const localizedSectionPath = buildLocalizedReadRoutePath(requestPath, readRoutes.mechanisms);
const breadcrumbCopy = getReadPageBreadcrumbCopy(Astro.locals?.locale);
const breadcrumbItems = [
  {
    name: breadcrumbCopy.readingHub,
    href: localizedReadRootPath,
  },
  {
    name: breadcrumbCopy.mechanisms,
    href: localizedSectionPath,
  },
  {
    name: frontmatter.title,
  },
];
const breadcrumbStructuredData = createBreadcrumbListStructuredDataFromTrail(
  breadcrumbItems,
  Astro.url
);
const mechanismStructuredData = createDefinedTermStructuredData({
  name: frontmatter.title,
  description: frontmatter.definition,
  termCode: frontmatter.slug,
  url: mechanismUrl,
  inDefinedTermSet: new URL(localizedSectionPath, Astro.url).toString(),
});
---
<BaseLayout
  title={`${frontmatter.title} • ${bookConfig.title}`}
  description={metaDescription}
  structuredData={[breadcrumbStructuredData, mechanismStructuredData]}
>
  <Breadcrumbs items={breadcrumbItems} ariaLabel={breadcrumbCopy.ariaLabel} />
  <a class="back-link" href={readRoutes.mechanisms}>← Mechanisms</a>
  <div class="eyebrow">Mechanism{isFallback ? " • fallback" : ""}</div>
  <h1 id={frontmatter.slug}>{frontmatter.title}</h1>
  <p class="lede" id="definition">{frontmatter.definition}</p>
  <NextActionPanel
    title="Try this next"
    description="Move from diagnosis to execution with one click."
    links={[
      relatedToolkit[0]
        ? {
            href: readItemPath("toolkit", relatedToolkit[0].slug),
            label: relatedToolkit[0].frontmatter.name ?? "Open related action",
            meta: `${relatedToolkit[0].frontmatter.timeboxMinutes ?? 10} min`,
          }
        : null,
      relatedExamples[0]
        ? {
            href: readItemPath("examples", relatedExamples[0].slug),
            label: relatedExamples[0].frontmatter.title ?? "See related example",
            meta: relatedExamples[0].frontmatter.domain ?? "Example",
          }
        : null,
      {
        href: readRoutes.chapters,
        label: "Return to chapter flow",
        meta: "Keep the intervention frame in view",
      },
    ].filter(Boolean)}
  />

  <section class="content-block" style="margin-top: 0;">
    <h2>On this page</h2>
    <div class="stack">
      <a class="list-link" href="#definition"><strong>Definition</strong></a>
      {(hasIs || hasIsNot || hasPredictions || hasTests) && (
        <a class="list-link" href="#recognize"><strong>How to recognize it</strong></a>
      )}
      {(relatedToolkit.length > 0 || relatedExamples.length > 0) && (
        <a class="list-link" href="#next-steps"><strong>Next steps</strong></a>
      )}
    </div>
  </section>

  <section class="content-block">
    <Content />
  </section>
  {(hasIs || hasIsNot || hasPredictions || hasTests) && (
    <section class="content-block" id="recognize">
      <h2>How to recognize it</h2>
      {hasIs && (
        <>
          <div class="eyebrow">This is</div>
          <ul>
            {frontmatter.is.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
      {hasIsNot && (
        <>
          <div class="eyebrow">This is not</div>
          <ul>
            {frontmatter.isNot.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
      {hasPredictions && (
        <>
          <div class="eyebrow">Predictions</div>
          <ul>
            {frontmatter.predictions.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
      {hasTests && (
        <>
          <div class="eyebrow">Quick tests</div>
          <ul>
            {frontmatter.tests.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
    </section>
  )}
  {(relatedToolkit.length > 0 || relatedExamples.length > 0) && (
    <section class="content-block" id="next-steps">
      <h2>Next steps</h2>
      {relatedToolkit.length > 0 && (
        <>
          <div class="eyebrow">Related actions (shortest first)</div>
          <div class="stack">
            {relatedToolkit.map((entry) => (
              <a class="list-link" href={readItemPath("toolkit", entry.slug)}>
                <strong>{entry.frontmatter.name ?? "Untitled action"}</strong>
                <span class="meta">
                  {entry.frontmatter.timeboxMinutes ?? 10} min
                </span>
              </a>
            ))}
          </div>
        </>
      )}
      {relatedExamples.length > 0 && (
        <>
          <div class="eyebrow">Related examples</div>
          <div class="stack">
            {relatedExamples.map((entry) => (
              <a class="list-link" href={readItemPath("examples", entry.slug)}>
                <strong>{entry.frontmatter.title ?? "Untitled example"}</strong>
                <span class="meta">{entry.frontmatter.domain ?? "unknown domain"}</span>
              </a>
            ))}
          </div>
        </>
      )}
    </section>
  )}
</BaseLayout>
