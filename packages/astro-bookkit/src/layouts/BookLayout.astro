---
import "../styles/bookkit.css";
import VersionSwitcher from "../components/VersionSwitcher.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { buildLocalePath, resolveLocaleConfig, stripLocaleFromPath } from "../localization/routes";
import { extractVersionFromPath, stripVersionFromPath } from "../releases/versions";

const {
  title,
  bookTitle = "Book",
  bookVersion = "draft",
  bookKey = "book",
  analyticsEndpoint = "/api/analytics.json",
  exportAnalyticsEndpoint = "/api/export-analytics.json",
  previewAnalyticsEndpoint = "/api/preview-analytics.json",
  footerText = "Draft book instance.",
  metaDescription,
  siteUrl,
  canonicalPath,
  canonicalUrl,
  ogImage,
  ogTitle,
  ogDescription,
  ogType = "website",
  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  ogSiteName,
  ogLocale,
  ogImageAlt,
  twitterImageAlt,
  structuredData,
  robots,
  aiQaEnabled = true,
  aiQaSamples = [
    "What is the core mechanism behind transfer success?",
    "How do I spot a compliance trap in an organization?",
    "Which actions help reverse moral technology?",
  ],
  isPreview = false,
  previewLabel = "Preview",
  previewTokenHint,
  previewExpiresAt,
  versions = [],
  versionPrefix = "v",
  versionArchivePath = "/versions",
  versionArchiveNoindex = true,
  locales = [],
  currentLocale,
  defaultLocale,
  includeDefaultLocalePrefix = false,
  localeLabel = "Language",
  showLocaleNotice = true,
} = Astro.props;

const pageTitle = title ?? bookTitle;
const versionEntries = Array.isArray(versions) ? versions : [];
const hasVersions = versionEntries.length > 0;
const localeEntries = Array.isArray(locales) ? locales : [];
const localeCodes = localeEntries.map((entry) => entry.code).filter(Boolean);
const originalUrl =
  typeof Astro.locals?.originalUrl === "string" ? new URL(Astro.locals.originalUrl) : null;
const requestPathname = originalUrl?.pathname ?? Astro.url.pathname;
const pathVersion = extractVersionFromPath(requestPathname, { prefixSegment: versionPrefix });
const pathWithoutVersion = stripVersionFromPath(requestPathname, { prefixSegment: versionPrefix });
const { defaultLocale: resolvedDefaultLocale } = resolveLocaleConfig(localeEntries, { defaultLocale });
const { locale: detectedLocale, pathWithoutLocale } = stripLocaleFromPath(
  pathWithoutVersion,
  localeCodes,
  { defaultLocale: resolvedDefaultLocale, includeDefaultPrefix: includeDefaultLocalePrefix }
);
const activeLocale = currentLocale ?? detectedLocale ?? resolvedDefaultLocale ?? localeCodes[0];
const activeLocaleEntry = localeEntries.find((entry) => entry.code === activeLocale);
const activeLocaleLabel = activeLocaleEntry?.label ?? activeLocale;
const defaultLocaleLabel =
  localeEntries.find((entry) => entry.code === resolvedDefaultLocale)?.label ?? resolvedDefaultLocale;
const localeCompletenessRaw =
  typeof activeLocaleEntry?.completeness === "number" ? activeLocaleEntry.completeness : null;
const localeCompleteness =
  localeCompletenessRaw === null
    ? null
    : Math.min(1, Math.max(0, localeCompletenessRaw));
const showTranslationNotice =
  showLocaleNotice && localeCompleteness !== null && localeCompleteness < 1;
const resolvedVersion = pathVersion ?? bookVersion;
const currentVersionEntry =
  versionEntries.find((entry) => entry.version === resolvedVersion) ??
  versionEntries.find((entry) => entry.isLatest);
const versionBadgeLabel = hasVersions
  ? currentVersionEntry?.isLatest
    ? "Latest"
    : resolvedVersion
      ? `v${resolvedVersion}`
      : null
  : null;
const canonicalPathBase =
  canonicalPath ??
  (pathVersion && !currentVersionEntry?.isLatest
    ? stripVersionFromPath(requestPathname, { prefixSegment: versionPrefix })
    : requestPathname);
const resolvedCanonical =
  canonicalUrl ?? (siteUrl ? new URL(canonicalPathBase, siteUrl).toString() : undefined);
const normalizedPath = pathWithoutVersion.replace(/\/$/, "") || "/";
const normalizedLocalePath = (pathWithoutLocale ?? pathWithoutVersion).replace(/\/$/, "") || "/";
const normalizedArchivePath = versionArchivePath.replace(/\/$/, "") || "/";
const isArchivePage = normalizedPath === normalizedArchivePath;
const isReadRoute =
  normalizedLocalePath === "/read" || normalizedLocalePath.startsWith("/read/");
const isDownloadsRoute = normalizedLocalePath === "/downloads";
const resolvedRobots =
  robots ??
  ((pathVersion && !currentVersionEntry?.isLatest) || (versionArchiveNoindex && isArchivePage)
    ? "noindex, nofollow"
    : undefined);
const resolvedOgTitle = ogTitle ?? pageTitle;
const resolvedOgDescription = ogDescription ?? metaDescription;
const resolvedTwitterCard = twitterCard ?? (twitterImage || ogImage ? "summary_large_image" : "summary");
const resolvedTwitterTitle = twitterTitle ?? resolvedOgTitle;
const resolvedTwitterDescription = twitterDescription ?? resolvedOgDescription;
const resolvedTwitterImage = twitterImage ?? ogImage;
const resolvedOgSiteName = ogSiteName ?? bookTitle;
const resolvedOgLocale = ogLocale ?? activeLocale;
const resolvedOgImageAlt = ogImageAlt;
const resolvedTwitterImageAlt = twitterImageAlt ?? ogImageAlt;
const defaultStructuredData = [
  resolvedCanonical
    ? {
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: pageTitle,
        description: metaDescription,
        url: resolvedCanonical,
        inLanguage: activeLocale,
        isPartOf: siteUrl
          ? {
              "@type": "WebSite",
              name: bookTitle,
              url: siteUrl,
            }
          : undefined,
      }
    : null,
].filter(Boolean);
const customStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const structuredDataScripts = [...defaultStructuredData, ...customStructuredData];
const hreflangEntries =
  siteUrl && localeEntries.length
    ? localeEntries.map((entry) => {
        const localePath = buildLocalePath(pathWithoutLocale ?? pathWithoutVersion, entry.code, {
          defaultLocale: resolvedDefaultLocale,
          includeDefaultPrefix: includeDefaultLocalePrefix,
        });
        return {
          locale: entry.code,
          href: new URL(localePath, siteUrl).toString(),
        };
      })
    : [];
const hreflangDefault =
  siteUrl && resolvedDefaultLocale
    ? new URL(
        buildLocalePath(pathWithoutLocale ?? pathWithoutVersion, resolvedDefaultLocale, {
          defaultLocale: resolvedDefaultLocale,
          includeDefaultPrefix: includeDefaultLocalePrefix,
        }),
        siteUrl
      ).toString()
    : null;
const previewExpiresLabel = previewExpiresAt
  ? new Date(previewExpiresAt).toLocaleDateString(activeLocale ?? "en", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : null;
const previewDetails = [
  previewTokenHint ? `Link ending in ${previewTokenHint}` : null,
  previewExpiresLabel ? `Expires ${previewExpiresLabel}` : null,
].filter(Boolean);
const showVersionHint = Boolean(hasVersions && !currentVersionEntry?.isLatest);
const showStatusActions = showTranslationNotice || isPreview || showVersionHint;
---
<!doctype html>
<html lang={activeLocale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}
    {resolvedRobots && <meta name="robots" content={resolvedRobots} />}
    {resolvedOgTitle && <meta property="og:title" content={resolvedOgTitle} />}
    {resolvedOgDescription && <meta property="og:description" content={resolvedOgDescription} />}
    {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
    {ogType && <meta property="og:type" content={ogType} />}
    {resolvedOgSiteName && <meta property="og:site_name" content={resolvedOgSiteName} />}
    {resolvedOgLocale && <meta property="og:locale" content={resolvedOgLocale} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {resolvedOgImageAlt && <meta property="og:image:alt" content={resolvedOgImageAlt} />}
    {resolvedTwitterCard && <meta name="twitter:card" content={resolvedTwitterCard} />}
    {resolvedTwitterTitle && <meta name="twitter:title" content={resolvedTwitterTitle} />}
    {resolvedTwitterDescription && <meta name="twitter:description" content={resolvedTwitterDescription} />}
    {resolvedTwitterImage && <meta name="twitter:image" content={resolvedTwitterImage} />}
    {resolvedTwitterImageAlt && <meta name="twitter:image:alt" content={resolvedTwitterImageAlt} />}
    {hreflangEntries.map((entry) => (
      <link rel="alternate" hreflang={entry.locale} href={entry.href} />
    ))}
    {hreflangDefault && <link rel="alternate" hreflang="x-default" href={hreflangDefault} />}
    {structuredDataScripts.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body
    data-book-version={bookVersion}
    data-analytics-key={bookKey}
    data-analytics-endpoint={analyticsEndpoint}
    data-export-analytics-endpoint={exportAnalyticsEndpoint}
    data-preview-analytics-endpoint={previewAnalyticsEndpoint}
    data-locale={activeLocale}
    data-qa-enabled={aiQaEnabled ? "true" : "false"}
    data-preview={isPreview ? "true" : "false"}
    data-preview-hint={previewTokenHint}
    data-preview-expires={previewExpiresAt}
    data-preview-label={previewLabel}
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page">
      <header class="site-header">
        <div class="site-brand">
          <a href="/">{bookTitle}</a>
          {isPreview && <span class="preview-badge">{previewLabel}</span>}
          {versionBadgeLabel && <span class="version-badge">{versionBadgeLabel}</span>}
        </div>
        <nav class="site-nav" aria-label="Primary">
          <a
            class:list={["site-nav__primary", { "site-nav__primary--active-route": isReadRoute }]}
            href="/read"
            aria-current={isReadRoute ? "page" : undefined}
            aria-keyshortcuts="g r"
          >
            Start reading
          </a>
          <a
            class:list={["site-nav__primary", { "site-nav__primary--active-route": isDownloadsRoute }]}
            href="/downloads"
            aria-current={isDownloadsRoute ? "page" : undefined}
            aria-keyshortcuts="g d"
          >
            Downloads
          </a>
          <button
            class="search-toggle"
            type="button"
            aria-keyshortcuts="k /"
            aria-expanded="false"
            aria-controls="search-panel"
            data-search-toggle
          >
            Search <span aria-hidden="true">⌘K</span>
          </button>
          <details class="site-nav__more" data-site-nav-more id="site-nav-more">
            <summary class="site-nav__more-toggle">Menu</summary>
            <div class="site-nav__overflow">
              <div class="site-nav__group site-nav__group--reader">
                <p class="site-nav__group-label">Reader tools</p>
                <a href="/release-notes" aria-keyshortcuts="g n">Release notes</a>
              </div>
              <div class="site-nav__group site-nav__group--author">
                <p class="site-nav__group-label">Author tools</p>
                <a href="/read/tools" aria-keyshortcuts="g a">Publishing tools</a>
                <a href="/new-book" aria-keyshortcuts="g b">Start a new book</a>
              </div>
              {(hasVersions || localeEntries.length > 1) && (
                <details class="site-settings" data-site-settings>
                  <summary class="site-settings__toggle">View settings</summary>
                  <div class="site-settings__panel">
                    {hasVersions && (
                      <VersionSwitcher
                        versions={versionEntries}
                        currentPath={Astro.url.pathname}
                        currentVersion={resolvedVersion}
                        prefixSegment={versionPrefix}
                        archivePath={versionArchivePath}
                      />
                    )}
                    {localeEntries.length > 1 && (
                      <LanguageSwitcher
                        locales={localeEntries}
                        currentPath={Astro.url.pathname}
                        currentLocale={activeLocale}
                        defaultLocale={resolvedDefaultLocale}
                        includeDefaultPrefix={includeDefaultLocalePrefix}
                        label={localeLabel}
                      />
                    )}
                  </div>
                </details>
              )}
              <details class="reader-settings" data-reader-settings>
                <summary class="reader-settings__toggle">Reading view</summary>
                <div class="reader-settings__panel">
                  <p class="reader-settings__hint">Tune text spacing and font for this device.</p>
                  <div class="reader-settings__group" role="group" aria-label="Reading density">
                    <span class="reader-settings__label">Density</span>
                    <div class="reader-settings__options">
                      <button type="button" data-reader-density="compact">Compact</button>
                      <button type="button" data-reader-density="comfortable">Comfortable</button>
                      <button type="button" data-reader-density="relaxed">Relaxed</button>
                    </div>
                  </div>
                  <div class="reader-settings__group" role="group" aria-label="Reading font">
                    <span class="reader-settings__label">Font</span>
                    <div class="reader-settings__options">
                      <button type="button" data-reader-font="serif">Serif</button>
                      <button type="button" data-reader-font="sans">Sans</button>
                    </div>
                  </div>
                </div>
              </details>
              {aiQaEnabled && (
                <button
                  class="qa-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="qa-panel"
                  data-qa-toggle
                >
                  Ask <span aria-hidden="true">the book</span>
                </button>
              )}
              <button
                class="kbd-toggle"
                type="button"
                aria-keyshortcuts="?"
                aria-expanded="false"
                aria-controls="keyboard-help"
                data-kbd-toggle
              >
                Shortcuts <span aria-hidden="true">?</span>
              </button>
            </div>
          </details>
        </nav>
      </header>
      {showTranslationNotice && (
        <div class="translation-notice" role="status">
          <span class="translation-notice__badge">Translation in progress</span>
          <span class="translation-notice__text">
            {activeLocaleLabel} is {Math.round((localeCompleteness ?? 0) * 100)}% complete. Missing
            sections will fall back to {defaultLocaleLabel ?? "the default language"}.
          </span>
        </div>
      )}
      {isPreview && (
        <div class="preview-notice" role="status">
          <span class="preview-notice__badge">Preview access</span>
          <span class="preview-notice__text">You’re viewing a private preview of this book.</span>
          {previewDetails.length ? (
            <span class="preview-notice__meta">{previewDetails.join(" • ")}</span>
          ) : null}
        </div>
      )}
      {showStatusActions && (
        <div class="status-actions" role="status" aria-live="polite">
          {showVersionHint && (
            <a class="status-actions__link" href="/release-notes">
              You are viewing v{resolvedVersion}. Open release notes to compare with the latest version.
            </a>
          )}
          {showTranslationNotice && (
            <a class="status-actions__link" href="/release-notes">
              Translation is still in progress. Check release notes for the most stable update before sharing.
            </a>
          )}
          {isPreview && (
            <a class="status-actions__link" href="/downloads">
              Using preview mode? Download an offline copy if you need to read without access interruptions.
            </a>
          )}
        </div>
      )}
      <main id="main-content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <span>{footerText}</span>
      </footer>
      <div class="mobile-cta" data-mobile-cta>
        <a
          class="mobile-cta__primary"
          href="/read"
          aria-keyshortcuts="g r"
          aria-current={isReadRoute ? "page" : undefined}
        >
          Read
        </a>
        <button type="button" data-mobile-search aria-controls="search-panel" aria-expanded="false">Search</button>
        <button type="button" data-mobile-menu aria-controls="site-nav-more" aria-expanded="false">Menu</button>
      </div>
      <div class="search-panel" id="search-panel" data-search-panel hidden>
        <div
          class="search-panel__content"
          role="dialog"
          aria-modal="false"
          aria-label="Search the book"
          data-search-content
        >
          <div class="search-panel__header">
            <strong>Search</strong>
            <button type="button" class="kbd-close" data-search-close aria-label="Close search">
              Esc
            </button>
          </div>
          <label class="search-panel__field">
            <span class="sr-only">Search the book</span>
            <input
              type="search"
              placeholder="Search chapters, terms, and examples..."
              autocomplete="off"
              spellcheck="false"
              aria-describedby="search-status"
              data-search-input
            />
          </label>
          <div class="search-panel__meta">
            <span
              class="meta"
              id="search-status"
              role="status"
              aria-live="polite"
              data-search-status
            >
              Type a word or phrase to find relevant sections.
            </span>
            <span class="meta">Uses local book index only.</span>
            <span class="kbd-hint" aria-hidden="true">
              <kbd>⌘</kbd><kbd>K</kbd> / <kbd>/</kbd>
            </span>
          </div>
          <div class="search-panel__results" data-search-results></div>
          <div class="search-panel__empty" data-search-empty hidden>
            <strong>No matches found.</strong>
            <p class="meta">
              Try a shorter phrase or search by mechanism, glossary term, or chapter title.
            </p>
          </div>
        </div>
      </div>
      {aiQaEnabled && (
        <div class="qa-panel" id="qa-panel" data-qa-panel hidden>
          <div
            class="qa-panel__content"
            role="dialog"
            aria-modal="false"
            aria-label="Ask about the book"
            data-qa-content
          >
            <div class="qa-panel__header">
              <strong>Ask the book</strong>
              <div class="qa-panel__actions">
                <button type="button" class="qa-panel__toggle" data-qa-disable>
                  Disable AI Q&amp;A
                </button>
                <button type="button" class="kbd-close" data-qa-close aria-label="Close AI Q&A">
                  Esc
                </button>
              </div>
            </div>
            <div class="qa-panel__body" data-qa-body>
              <p class="meta">
                This assistant matches your question to passages in the book. Responses are grounded in cited
                sections and won’t include external knowledge.
              </p>
              <form class="qa-panel__form" data-qa-form>
                <label class="qa-panel__field">
                  <span class="sr-only">Ask a question about the book</span>
                  <textarea
                    rows="2"
                    placeholder="Ask a question about the book..."
                    autocomplete="off"
                    spellcheck="false"
                    aria-describedby="qa-status"
                    data-qa-input
                  ></textarea>
                </label>
                <button type="submit" class="qa-panel__submit">Get answer</button>
              </form>
              <div class="qa-panel__display" role="group" aria-label="Answer display mode">
                <span class="meta">Display mode</span>
                <button type="button" class="qa-panel__display-toggle" data-qa-display-toggle>
                  Show citations first
                </button>
              </div>
              <div
                class="qa-panel__meta"
                id="qa-status"
                role="status"
                aria-live="polite"
                data-qa-status
              >
                Try a question to see cited answers. Uses local book index only.
              </div>
              <div class="qa-panel__suggestions">
                <div class="eyebrow">Sample prompts</div>
                <div class="qa-panel__suggestion-list">
                  {aiQaSamples.map((prompt) => (
                    <button type="button" class="qa-panel__suggestion" data-qa-suggestion>
                      {prompt}
                    </button>
                  ))}
                </div>
              </div>
              <div class="qa-panel__answer" data-qa-answer>
                <p class="meta">No answer yet.</p>
              </div>
              <div class="qa-panel__citations" data-qa-citations></div>
            </div>
            <div class="qa-panel__disabled" data-qa-disabled hidden>
              <p>AI Q&amp;A is disabled for this book in your browser.</p>
              <button type="button" class="qa-panel__submit" data-qa-enable>
                Re-enable AI Q&amp;A
              </button>
            </div>
          </div>
        </div>
      )}
      <div class="keyboard-help" id="keyboard-help" data-kbd-panel hidden>
        <div
          class="keyboard-help__content"
          data-kbd-content
          role="dialog"
          aria-modal="false"
          aria-label="Keyboard shortcuts"
        >
          <div class="keyboard-help__header">
            <strong>Keyboard shortcuts</strong>
            <button type="button" class="kbd-close" data-kbd-close aria-label="Close keyboard shortcuts">
              Esc
            </button>
          </div>
          <ul class="keyboard-help__list">
            <li>
              <span>Open this panel</span>
              <span class="kbd-hint"><kbd>?</kbd></span>
            </li>
            <li>
              <span>Open search</span>
              <span class="kbd-hint"><kbd>⌘</kbd><kbd>K</kbd> / <kbd>/</kbd></span>
            </li>
            <li>
              <span>Go to home</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>h</kbd></span>
            </li>
            <li>
              <span>Go to reading hub</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>r</kbd></span>
            </li>
            <li>
              <span>Go to release notes</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>n</kbd></span>
            </li>
            <li>
              <span>Open downloads</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>d</kbd></span>
            </li>
            <li>
              <span>Open author diagnostics</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>a</kbd></span>
            </li>
            <li>
              <span>Go to overview</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>o</kbd></span>
            </li>
            <li>
              <span>Jump to chapters</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>c</kbd></span>
            </li>
            <li>
              <span>Jump to mechanisms</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>m</kbd></span>
            </li>
            <li>
              <span>Jump to toolkit</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>t</kbd></span>
            </li>
            <li>
              <span>Jump to glossary</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>l</kbd></span>
            </li>
            <li>
              <span>Jump to examples</span>
              <span class="kbd-hint"><kbd>g</kbd><kbd>e</kbd></span>
            </li>
            <li>
              <span>Previous section</span>
              <span class="kbd-hint"><kbd>[</kbd></span>
            </li>
            <li>
              <span>Next section</span>
              <span class="kbd-hint"><kbd>]</kbd></span>
            </li>
            <li>
              <span>Close panel</span>
              <span class="kbd-hint"><kbd>Esc</kbd></span>
            </li>
          </ul>
          <p class="keyboard-help__note">
            Shortcuts are active when you are not typing in a form field.
          </p>
        </div>
      </div>
    </div>
    <script>
      const analyticsKeyPrefix = document.body?.dataset?.analyticsKey || "book";
      const helpPanel = document.querySelector("[data-kbd-panel]");
      const helpToggle = document.querySelector("[data-kbd-toggle]");
      const helpClose = document.querySelector("[data-kbd-close]");
      const searchPanel = document.querySelector("[data-search-panel]");
      const searchToggle = document.querySelector("[data-search-toggle]");
      const searchClose = document.querySelector("[data-search-close]");
      const searchInput = document.querySelector("[data-search-input]");
      const searchResults = document.querySelector("[data-search-results]");
      const searchStatus = document.querySelector("[data-search-status]");
      const searchEmpty = document.querySelector("[data-search-empty]");
      const qaPanel = document.querySelector("[data-qa-panel]");
      const qaToggle = document.querySelector("[data-qa-toggle]");
      const qaClose = document.querySelector("[data-qa-close]");
      const qaForm = document.querySelector("[data-qa-form]");
      const qaInput = document.querySelector("[data-qa-input]");
      const qaAnswer = document.querySelector("[data-qa-answer]");
      const qaCitations = document.querySelector("[data-qa-citations]");
      const qaStatus = document.querySelector("[data-qa-status]");
      const qaBody = document.querySelector("[data-qa-body]");
      const qaDisabledPanel = document.querySelector("[data-qa-disabled]");
      const qaDisableButton = document.querySelector("[data-qa-disable]");
      const qaEnableButton = document.querySelector("[data-qa-enable]");
      const qaSuggestions = Array.from(document.querySelectorAll("[data-qa-suggestion]"));
      const qaDisplayToggle = document.querySelector("[data-qa-display-toggle]");
      const siteNavMore = document.querySelector("[data-site-nav-more]");
      const siteSettings = document.querySelector("[data-site-settings]");
      const mobileSearchToggle = document.querySelector("[data-mobile-search]");
      const mobileMenuToggle = document.querySelector("[data-mobile-menu]");
      const mobileCta = document.querySelector("[data-mobile-cta]");
      const siteNavMoreSummary = siteNavMore?.querySelector("summary");
      const readerDensityButtons = Array.from(document.querySelectorAll("[data-reader-density]"));
      const readerFontButtons = Array.from(document.querySelectorAll("[data-reader-font]"));
      const desktopNavMedia = window.matchMedia("(min-width: 721px)");
      const qaEnabled = document.body?.dataset?.qaEnabled === "true";
      const readerPrefsKey = `${analyticsKeyPrefix}.reader.prefs`;
      let lastFocused = null;
      let pendingSequence = null;
      let sequenceTimeout = null;
      let activeHeadingIndex = 0;
      let searchIndex = null;
      let searchQuery = "";
      let searchTimeout = null;
      let qaQuery = "";
      let lastScrollY = window.scrollY;
      const searchAnalyticsKey = `${analyticsKeyPrefix}.search.analytics`;
      const exportAnalyticsKey = `${analyticsKeyPrefix}.export.analytics`;
      const qaAnalyticsKey = `${analyticsKeyPrefix}.qa.analytics`;
      const qaDisabledKey = `${analyticsKeyPrefix}.qa.disabled`;
      const qaDisplayModeKey = `${analyticsKeyPrefix}.qa.display.mode`;
      const getStoredValue = (key) => {
        try {
          return localStorage.getItem(key);
        } catch (error) {
          return null;
        }
      };

      const setStoredValue = (key, value) => {
        try {
          localStorage.setItem(key, value);
        } catch (error) {
          // Ignore storage write failures so UI initialization keeps running.
        }
      };

      let qaDisplayMode =
        getStoredValue(qaDisplayModeKey) === "citations-first" ? "citations-first" : "answer-first";
      const exportAnalyticsEndpoint = document.body?.dataset?.exportAnalyticsEndpoint;
      const previewAnalyticsEndpoint = document.body?.dataset?.previewAnalyticsEndpoint;

      const headingSelector = "main h2, main h3";
      const headings = Array.from(document.querySelectorAll(headingSelector));
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const setHeadingHighlight = (target) => {
        if (!target) return;
        target.classList.add("viewport-highlight");
        window.setTimeout(() => target.classList.remove("viewport-highlight"), 1200);
      };

      const goToHeading = (index) => {
        if (!headings.length) return;
        const clamped = Math.max(0, Math.min(index, headings.length - 1));
        activeHeadingIndex = clamped;
        const target = headings[clamped];
        target.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
        target.focus?.({ preventScroll: true });
        setHeadingHighlight(target);
      };

      const updateActiveHeading = () => {
        const visible = headings.findIndex((heading) => {
          const rect = heading.getBoundingClientRect();
          return rect.top >= 0 && rect.top <= window.innerHeight * 0.35;
        });
        if (visible >= 0) {
          activeHeadingIndex = visible;
        }
      };

      const syncSiteNavOverflow = (matchesDesktop) => {
        if (!siteNavMore) return;
        if (matchesDesktop) {
          mobileMenuToggle?.setAttribute("aria-expanded", "false");
          return;
        }
        siteNavMore.removeAttribute("open");
        siteSettings?.removeAttribute("open");
        mobileMenuToggle?.setAttribute("aria-expanded", "false");
      };

      const openHelp = () => {
        if (!helpPanel) return;
        lastFocused = document.activeElement;
        helpPanel.hidden = false;
        helpPanel.classList.add("is-open");
        helpToggle?.setAttribute("aria-expanded", "true");
        helpClose?.focus({ preventScroll: true });
      };

      const closeHelp = () => {
        if (!helpPanel) return;
        helpPanel.hidden = true;
        helpPanel.classList.remove("is-open");
        helpToggle?.setAttribute("aria-expanded", "false");
        lastFocused?.focus?.();
      };

      const toggleHelp = () => {
        if (!helpPanel) return;
        if (helpPanel.hidden) {
          openHelp();
        } else {
          closeHelp();
        }
      };

      const resetSequence = () => {
        pendingSequence = null;
        if (sequenceTimeout) {
          window.clearTimeout(sequenceTimeout);
          sequenceTimeout = null;
        }
      };

      const setSequence = () => {
        pendingSequence = "g";
        if (sequenceTimeout) {
          window.clearTimeout(sequenceTimeout);
        }
        sequenceTimeout = window.setTimeout(resetSequence, 1200);
      };

      const navigateTo = (path) => {
        if (!path) return;
        window.location.href = path;
      };

      const inEditable = (target) => {
        return (
          target instanceof HTMLElement &&
          (target.isContentEditable ||
            ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
        );
      };

      const updateReaderButtonState = (buttons, selectedValue) => {
        buttons.forEach((button) => {
          const isActive =
            button instanceof HTMLElement &&
            (button.dataset.readerDensity === selectedValue || button.dataset.readerFont === selectedValue);
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
          button.classList.toggle("is-active", isActive);
        });
      };

      const loadReaderPreferences = () => {
        try {
          const stored = localStorage.getItem(readerPrefsKey);
          const parsed = stored ? JSON.parse(stored) : null;
          return {
            density: parsed?.density,
            font: parsed?.font,
          };
        } catch (error) {
          return { density: null, font: null };
        }
      };

      const saveReaderPreferences = (prefs) => {
        try {
          localStorage.setItem(readerPrefsKey, JSON.stringify(prefs));
        } catch (error) {
          // Ignore storage write failures so reader setup continues.
        }
      };

      const setReaderDensity = (density) => {
        if (!["compact", "comfortable", "relaxed"].includes(density)) return;
        document.body.dataset.readerDensity = density;
        const prefs = loadReaderPreferences();
        saveReaderPreferences({ ...prefs, density });
        updateReaderButtonState(readerDensityButtons, density);
      };

      const setReaderFont = (font) => {
        if (!["serif", "sans"].includes(font)) return;
        document.body.dataset.readerFont = font;
        const prefs = loadReaderPreferences();
        saveReaderPreferences({ ...prefs, font });
        updateReaderButtonState(readerFontButtons, font);
      };

      const initializeReaderPreferences = () => {
        const prefs = loadReaderPreferences();
        const density =
          prefs.density ??
          (window.matchMedia("(max-width: 720px)").matches ? "compact" : "comfortable");
        const font = prefs.font ?? "serif";
        setReaderDensity(density);
        setReaderFont(font);
      };

      const escapeHtml = (value) => {
        return value
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/\"/g, "&quot;")
          .replace(/'/g, "&#39;");
      };

      const toSafeUrl = (value) => {
        if (typeof value !== "string") return "#";
        try {
          const parsed = new URL(value, window.location.origin);
          if (parsed.protocol === "http:" || parsed.protocol === "https:") {
            return parsed.href;
          }
        } catch (error) {
          // Ignore invalid URLs.
        }
        return "#";
      };

      const highlightText = (value, tokens) => {
        if (!tokens.length) return escapeHtml(value);
        return tokens.reduce((output, token) => {
          const regex = new RegExp(`(${token.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&")})`, "gi");
          return output.replace(regex, "<mark>$1</mark>");
        }, escapeHtml(value));
      };

      const recordSearchEvent = (payload) => {
        const event = { ...payload, ts: Date.now() };
        const existing = JSON.parse(localStorage.getItem(searchAnalyticsKey) ?? "[]");
        existing.push(event);
        localStorage.setItem(searchAnalyticsKey, JSON.stringify(existing.slice(-120)));
        window.dispatchEvent(new CustomEvent("book-search", { detail: event }));
      };

      const recordExportEvent = (payload) => {
        const event = { ...payload, ts: Date.now() };
        const existing = JSON.parse(localStorage.getItem(exportAnalyticsKey) ?? "[]");
        existing.push(event);
        localStorage.setItem(exportAnalyticsKey, JSON.stringify(existing.slice(-120)));
        window.dispatchEvent(new CustomEvent("book-export", { detail: event }));
      };

      const sendExportAnalytics = (payload) => {
        if (!exportAnalyticsEndpoint) return;
        const body = JSON.stringify(payload);
        if ("sendBeacon" in navigator) {
          const blob = new Blob([body], { type: "application/json" });
          navigator.sendBeacon(exportAnalyticsEndpoint, blob);
          return;
        }
        fetch(exportAnalyticsEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      };

      const sendPreviewAnalytics = (payload) => {
        if (!previewAnalyticsEndpoint) return;
        const body = JSON.stringify(payload);
        if ("sendBeacon" in navigator) {
          const blob = new Blob([body], { type: "application/json" });
          navigator.sendBeacon(previewAnalyticsEndpoint, blob);
          return;
        }
        fetch(previewAnalyticsEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      };

      const updateSearchStatus = (message) => {
        if (searchStatus) searchStatus.textContent = message;
      };

      const loadSearchIndex = async () => {
        if (searchIndex) return searchIndex;
        updateSearchStatus("Loading index…");
        try {
          const response = await fetch("/search-index.json");
          const payload = await response.json();
          searchIndex = payload.entries ?? [];
          updateSearchStatus("Type a word or phrase to find relevant sections.");
        } catch (error) {
          updateSearchStatus("Search is unavailable right now.");
          searchIndex = [];
        }
        return searchIndex;
      };


      const warmSearchIndex = () => {
        if (!searchPanel || searchIndex) return;
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(() => {
            loadSearchIndex().catch(() => {});
          });
          return;
        }
        window.setTimeout(() => {
          loadSearchIndex().catch(() => {});
        }, 800);
      };

      const recordQaEvent = (payload) => {
        const event = { ...payload, ts: Date.now() };
        const existing = JSON.parse(localStorage.getItem(qaAnalyticsKey) ?? "[]");
        existing.push(event);
        localStorage.setItem(qaAnalyticsKey, JSON.stringify(existing.slice(-120)));
        window.dispatchEvent(new CustomEvent("book-qa", { detail: event }));
      };

      const isQaDisabled = () => localStorage.getItem(qaDisabledKey) === "true";

      const setQaDisabled = (value) => {
        localStorage.setItem(qaDisabledKey, value ? "true" : "false");
      };

      const updateQaState = () => {
        if (!qaEnabled || !qaPanel) return;
        const disabled = isQaDisabled();
        qaPanel.classList.toggle("is-disabled", disabled);
        qaBody?.toggleAttribute("hidden", disabled);
        qaDisabledPanel?.toggleAttribute("hidden", !disabled);
        qaDisableButton?.toggleAttribute("disabled", disabled);
      };

      const updateQaStatus = (message) => {
        if (qaStatus) qaStatus.textContent = message;
      };

      const renderQaAnswer = (results, tokens) => {
        if (!qaAnswer || !qaCitations) return;
        qaCitations.innerHTML = "";
        if (!results.length) {
          qaAnswer.innerHTML = "<p>No answer found. Try rephrasing or using fewer words.</p>";
          return;
        }
        const answerText = results[0]?.snippet ?? "No answer found.";
        qaAnswer.innerHTML = `
          <p>${escapeHtml(answerText)}</p>
          <p class="meta">Answer assembled from ${results.length} cited passage${results.length === 1 ? "" : "s"}.</p>
        `;
        const heading = document.createElement("h3");
        heading.textContent = "Sources";
        const list = document.createElement("ol");
        list.className = "qa-panel__citation-list";
        results.forEach((entry) => {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = toSafeUrl(entry.url);
          link.dataset.qaCitationId = entry.id;
          link.textContent = `${entry.context} — ${entry.title}`;
          const snippet = document.createElement("p");
          snippet.innerHTML = highlightText(entry.snippet, tokens);
          item.appendChild(link);
          item.appendChild(snippet);
          list.appendChild(item);
        });
        qaCitations.appendChild(heading);
        qaCitations.appendChild(list);
      };

      const updateQaDisplayMode = () => {
        if (!qaDisplayToggle || !qaPanel) return;
        const isCitationsFirst = qaDisplayMode === "citations-first";
        qaPanel.dataset.qaDisplayMode = qaDisplayMode;
        qaDisplayToggle.textContent = isCitationsFirst ? "Show answer first" : "Show citations first";
        setStoredValue(qaDisplayModeKey, qaDisplayMode);
      };

      const runQa = async (value) => {
        if (!qaEnabled) return;
        if (isQaDisabled()) {
          updateQaStatus("AI Q&A is disabled.");
          return;
        }
        const index = await loadSearchIndex();
        qaQuery = value;
        const query = value.trim().toLowerCase();
        if (!query) {
          updateQaStatus("Ask a question to see answers.");
          qaAnswer && (qaAnswer.innerHTML = "<p class='meta'>No answer yet.</p>");
          qaCitations && (qaCitations.innerHTML = "");
          return;
        }
        const tokens = query.split(/\s+/).filter(Boolean);
        const results = index
          .map((entry) => ({
            ...entry,
            searchText: `${entry.title} ${entry.snippet} ${entry.context}`.toLowerCase(),
          }))
          .filter((entry) => tokens.every((token) => entry.searchText.includes(token)))
          .map((entry) => {
            const score = tokens.reduce((total, token) => {
              const titleBoost = entry.title.toLowerCase().includes(token) ? 4 : 0;
              const contextBoost = entry.context.toLowerCase().includes(token) ? 2 : 0;
              return total + titleBoost + contextBoost + 1;
            }, 0);
            return { ...entry, score };
          })
          .sort((a, b) => b.score - a.score)
          .slice(0, 3);

        renderQaAnswer(results, tokens);
        updateQaStatus(
          results.length
            ? `${results.length} cited passage${results.length === 1 ? "" : "s"} returned.`
            : "No citations found."
        );
        recordQaEvent({ type: "question", query, matches: results.length });
      };

      const openSearch = async () => {
        if (!searchPanel) return;
        lastFocused = document.activeElement;
        searchPanel.hidden = false;
        searchPanel.classList.add("is-open");
        searchToggle?.setAttribute("aria-expanded", "true");
        mobileSearchToggle?.setAttribute("aria-expanded", "true");
        await loadSearchIndex();
        window.requestAnimationFrame(() => {
          if (searchInput) {
            searchInput.value = searchQuery;
            searchInput.focus({ preventScroll: true });
            searchInput.select?.();
            if (searchQuery) {
              runSearch(searchQuery);
            }
          }
        });
      };


      const syncMobileToggleState = () => {
        const menuOpen = Boolean(siteNavMore && siteNavMore.hasAttribute("open"));
        mobileMenuToggle?.setAttribute("aria-expanded", menuOpen ? "true" : "false");
        if (mobileMenuToggle) {
          mobileMenuToggle.textContent = menuOpen ? "Close menu" : "Menu";
        }
      };

      const updateMobileCtaVisibility = () => {
        if (!(mobileCta instanceof HTMLElement)) return;
        const setMobileCtaHidden = (hidden) => {
          mobileCta.classList.toggle("mobile-cta--hidden", hidden);
          mobileCta.setAttribute("aria-hidden", hidden ? "true" : "false");
          if ("inert" in mobileCta) {
            mobileCta.inert = hidden;
          } else {
            const focusables = mobileCta.querySelectorAll("a, button, input, select, textarea, [tabindex]");
            focusables.forEach((focusable) => {
              if (!(focusable instanceof HTMLElement)) return;
              if (hidden) {
                if (focusable.dataset.mobileCtaPrevTabindex === undefined) {
                  focusable.dataset.mobileCtaPrevTabindex = focusable.getAttribute("tabindex") ?? "";
                }
                focusable.setAttribute("tabindex", "-1");
              } else if (focusable.dataset.mobileCtaPrevTabindex !== undefined) {
                const previousTabindex = focusable.dataset.mobileCtaPrevTabindex;
                if (previousTabindex) {
                  focusable.setAttribute("tabindex", previousTabindex);
                } else {
                  focusable.removeAttribute("tabindex");
                }
                delete focusable.dataset.mobileCtaPrevTabindex;
              }
            });
          }

          if (hidden && document.activeElement instanceof HTMLElement && mobileCta.contains(document.activeElement)) {
            const mainContent = document.getElementById("main-content");
            (mainContent instanceof HTMLElement ? mainContent : document.body)?.focus?.({ preventScroll: true });
          }
        };

        if (!window.matchMedia("(max-width: 720px)").matches) {
          setMobileCtaHidden(false);
          lastScrollY = window.scrollY;
          return;
        }
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;
        const nearTop = currentY < 80;
        const scrollingDown = delta > 6;
        const scrollingUp = delta < -6;
        if (nearTop || scrollingUp) {
          setMobileCtaHidden(false);
        } else if (scrollingDown) {
          setMobileCtaHidden(true);
        }
        lastScrollY = currentY;
      };

      const closeSearch = () => {
        if (!searchPanel) return;
        searchPanel.hidden = true;
        searchPanel.classList.remove("is-open");
        searchToggle?.setAttribute("aria-expanded", "false");
        mobileSearchToggle?.setAttribute("aria-expanded", "false");
        lastFocused?.focus?.();
      };

      const toggleSearch = () => {
        if (!searchPanel) return;
        if (searchPanel.hidden) {
          openSearch();
        } else {
          closeSearch();
        }
      };

      const openQa = async () => {
        if (!qaEnabled || !qaPanel) return;
        lastFocused = document.activeElement;
        qaPanel.hidden = false;
        qaPanel.classList.add("is-open");
        qaToggle?.setAttribute("aria-expanded", "true");
        updateQaState();
        await loadSearchIndex();
        window.requestAnimationFrame(() => {
          if (qaInput && !isQaDisabled()) {
            qaInput.value = qaQuery;
            qaInput.focus({ preventScroll: true });
            qaInput.select?.();
          }
        });
      };

      const closeQa = () => {
        if (!qaPanel) return;
        qaPanel.hidden = true;
        qaPanel.classList.remove("is-open");
        qaToggle?.setAttribute("aria-expanded", "false");
        lastFocused?.focus?.();
      };

      const toggleQa = () => {
        if (!qaPanel) return;
        if (qaPanel.hidden) {
          openQa();
        } else {
          closeQa();
        }
      };

      const renderSearchResults = (results, tokens) => {
        if (!searchResults) return;
        searchResults.innerHTML = "";
        if (!results.length) {
          searchEmpty?.removeAttribute("hidden");
          return;
        }
        searchEmpty?.setAttribute("hidden", "true");
        const grouped = results.reduce((groupMap, entry) => {
          const key = entry.label ?? entry.type;
          groupMap.set(key, [...(groupMap.get(key) ?? []), entry]);
          return groupMap;
        }, new Map());

        const groupedEntries = Array.from(grouped.entries()).sort(([, aItems], [, bItems]) => {
          const aOrder = aItems[0]?.order ?? 999;
          const bOrder = bItems[0]?.order ?? 999;
          return aOrder - bOrder;
        });

        groupedEntries.forEach(([label, items]) => {
          const section = document.createElement("div");
          section.className = "search-panel__group";
          const heading = document.createElement("h3");
          heading.textContent = `${label} (${items.length})`;
          section.appendChild(heading);

          const list = document.createElement("div");
          list.className = "search-panel__list";
          items.forEach((entry) => {
            const link = document.createElement("a");
            link.href = toSafeUrl(entry.url);
            link.className = "search-panel__item";
            link.dataset.searchId = entry.id;
            const breadcrumb = entry.section ? `${entry.context} › ${entry.section}` : entry.context;
            link.innerHTML = `
              <div class="search-panel__item-title">${highlightText(entry.title, tokens)}</div>
              <div class="search-panel__item-snippet">${highlightText(entry.snippet, tokens)}</div>
              <div class="search-panel__item-meta">${escapeHtml(entry.label)} • ${escapeHtml(
                breadcrumb
              )}</div>
            `;
            list.appendChild(link);
          });
          section.appendChild(list);
          searchResults.appendChild(section);
        });
      };

      const runSearch = async (value) => {
        const index = await loadSearchIndex();
        searchQuery = value;
        const query = value.trim().toLowerCase();
        if (!query) {
          searchResults && (searchResults.innerHTML = "");
          searchEmpty?.setAttribute("hidden", "true");
          updateSearchStatus("Type a word or phrase to find relevant sections.");
          return;
        }
        const tokens = query.split(/\s+/).filter(Boolean);
        const results = index
          .map((entry) => ({
            ...entry,
            searchText: `${entry.title} ${entry.snippet} ${entry.context}`.toLowerCase(),
          }))
          .filter((entry) => tokens.every((token) => entry.searchText.includes(token)))
          .map((entry) => {
            const score = tokens.reduce((total, token) => {
              const titleBoost = entry.title.toLowerCase().includes(token) ? 4 : 0;
              const contextBoost = entry.context.toLowerCase().includes(token) ? 2 : 0;
              return total + titleBoost + contextBoost + 1;
            }, 0);
            return { ...entry, score };
          })
          .sort((a, b) => b.score - a.score);

        renderSearchResults(results, tokens);
        updateSearchStatus(`${results.length} result${results.length === 1 ? "" : "s"}`);

        if (query.length >= 2) {
          recordSearchEvent({ type: "query", query, results: results.length });
          if (!results.length) {
            recordSearchEvent({ type: "zero_results", query });
          }
        }
      };

      helpToggle?.addEventListener("click", toggleHelp);
      helpClose?.addEventListener("click", closeHelp);
      helpPanel?.addEventListener("click", (event) => {
        if (event.target instanceof HTMLElement && !event.target.closest("[data-kbd-content]")) {
          closeHelp();
        }
      });
      searchToggle?.addEventListener("click", toggleSearch);
      mobileSearchToggle?.addEventListener("click", () => {
        toggleSearch();
        const expanded = searchPanel && !searchPanel.hidden;
        mobileSearchToggle?.setAttribute("aria-expanded", expanded ? "true" : "false");
      });
      searchClose?.addEventListener("click", closeSearch);
      searchPanel?.addEventListener("click", (event) => {
        if (event.target instanceof HTMLElement && !event.target.closest("[data-search-content]")) {
          closeSearch();
        }
      });
      searchInput?.addEventListener("input", (event) => {
        const value = event.target instanceof HTMLInputElement ? event.target.value : "";
        if (searchTimeout) window.clearTimeout(searchTimeout);
        searchTimeout = window.setTimeout(() => runSearch(value), 160);
      });
      searchResults?.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest("a") : null;
        if (!target) return;
        recordSearchEvent({ type: "click", id: target.dataset.searchId, query: searchQuery });
        closeSearch();
      });
      qaToggle?.addEventListener("click", toggleQa);
      qaClose?.addEventListener("click", closeQa);
      qaPanel?.addEventListener("click", (event) => {
        if (event.target instanceof HTMLElement && !event.target.closest("[data-qa-content]")) {
          closeQa();
        }
      });
      qaForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const value = qaInput instanceof HTMLTextAreaElement ? qaInput.value : "";
        runQa(value);
      });
      qaInput?.addEventListener("input", (event) => {
        qaQuery = event.target instanceof HTMLTextAreaElement ? event.target.value : "";
      });
      qaDisableButton?.addEventListener("click", () => {
        setQaDisabled(true);
        updateQaState();
        recordQaEvent({ type: "opt_out", enabled: false });
      });
      qaEnableButton?.addEventListener("click", () => {
        setQaDisabled(false);
        updateQaState();
        recordQaEvent({ type: "opt_in", enabled: true });
        if (qaInput && qaInput instanceof HTMLTextAreaElement) {
          qaInput.focus({ preventScroll: true });
        }
      });
      qaSuggestions.forEach((button) => {
        button.addEventListener("click", () => {
          if (!qaInput || !(qaInput instanceof HTMLTextAreaElement)) return;
          qaInput.value = button.textContent?.trim() ?? "";
          runQa(qaInput.value);
          qaInput.focus({ preventScroll: true });
        });
      });
      qaDisplayToggle?.addEventListener("click", () => {
        qaDisplayMode = qaDisplayMode === "answer-first" ? "citations-first" : "answer-first";
        updateQaDisplayMode();
      });
      qaCitations?.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest("a") : null;
        if (!target) return;
        recordQaEvent({ type: "citation_click", id: target.dataset.qaCitationId, query: qaQuery });
        closeQa();
      });

      mobileMenuToggle?.addEventListener("click", () => {
        if (!siteNavMore) return;
        const isOpen = siteNavMore.hasAttribute("open");
        if (isOpen) {
          siteNavMore.removeAttribute("open");
        } else {
          siteNavMore.setAttribute("open", "");
        }
        syncMobileToggleState();
      });

      siteNavMoreSummary?.addEventListener("click", () => {
        window.requestAnimationFrame(syncMobileToggleState);
      });

      readerDensityButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!button.dataset.readerDensity) return;
          setReaderDensity(button.dataset.readerDensity);
        });
      });

      readerFontButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (!button.dataset.readerFont) return;
          setReaderFont(button.dataset.readerFont);
        });
      });

      warmSearchIndex();
      updateQaDisplayMode();
      initializeReaderPreferences();
      syncSiteNavOverflow(desktopNavMedia.matches);
      syncMobileToggleState();
      updateMobileCtaVisibility();

      if ("addEventListener" in desktopNavMedia) {
        desktopNavMedia.addEventListener("change", (event) => {
          syncSiteNavOverflow(event.matches);
          updateMobileCtaVisibility();
        });
      } else {
        desktopNavMedia.addListener((event) => {
          syncSiteNavOverflow(event.matches);
          updateMobileCtaVisibility();
        });
      }

      window.addEventListener("scroll", updateMobileCtaVisibility, { passive: true });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeSearch();
          closeQa();
          closeHelp();
          return;
        }
        if (inEditable(event.target)) return;
        if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
          event.preventDefault();
          toggleSearch();
          return;
        }
        if (event.key === "/" && !event.metaKey && !event.ctrlKey && !event.altKey) {
          event.preventDefault();
          openSearch();
          return;
        }
        if (event.metaKey || event.ctrlKey || event.altKey) return;

        if (event.key === "?") {
          event.preventDefault();
          toggleHelp();
          return;
        }

        if (event.key.toLowerCase() === "g") {
          event.preventDefault();
          setSequence();
          return;
        }

        if (pendingSequence === "g") {
          const key = event.key.toLowerCase();
          resetSequence();
          if (key === "h") navigateTo("/");
          if (key === "r") navigateTo("/read");
          if (key === "n") navigateTo("/release-notes");
          if (key === "d") navigateTo("/downloads");
          if (key === "a") navigateTo("/read/tools");
          if (key === "o") navigateTo("/read/overview");
          if (key === "c") navigateTo("/read/chapters");
          if (key === "m") navigateTo("/read/mechanisms");
          if (key === "t") navigateTo("/read/toolkit");
          if (key === "l") navigateTo("/read/glossary");
          if (key === "e") navigateTo("/read/examples");
          return;
        }

        if (event.key === "[") {
          event.preventDefault();
          updateActiveHeading();
          goToHeading(activeHeadingIndex - 1);
          return;
        }

        if (event.key === "]") {
          event.preventDefault();
          updateActiveHeading();
          goToHeading(activeHeadingIndex + 1);
        }
      });

      if (headings.length) {
        headings.forEach((heading) => heading.setAttribute("tabindex", "-1"));
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                entry.target.classList.toggle("is-in-viewport", entry.isIntersecting);
                if (entry.isIntersecting) {
                  activeHeadingIndex = headings.indexOf(entry.target);
                }
              });
            },
            {
              rootMargin: "-10% 0px -70% 0px",
              threshold: 0.1,
            }
          );
          headings.forEach((heading) => observer.observe(heading));
        } else {
          window.addEventListener("scroll", updateActiveHeading, { passive: true });
        }
      }

      document.addEventListener("click", (event) => {
        const target = event.target instanceof HTMLElement ? event.target.closest("[data-export-link]") : null;
        if (!target) return;
        const payload = {
          type: "download",
          format: target.dataset.exportFormat,
          scope: target.dataset.exportScope,
          slug: target.dataset.exportSlug ?? null,
          href: target.getAttribute("href"),
          path: window.location.pathname,
        };
        recordExportEvent(payload);
        sendExportAnalytics(payload);
      });
    </script>
    <script>
      const analyticsKeyPrefix = document.body?.dataset?.analyticsKey || "book";
      const analyticsStorageKey = `${analyticsKeyPrefix}.analytics.events`;
      const analyticsSessionKey = `${analyticsKeyPrefix}.analytics.session`;
      const previewAnalyticsKey = `${analyticsKeyPrefix}.preview.analytics`;
      const analyticsEndpoint = document.body?.dataset?.analyticsEndpoint;
      const isPreview = document.body?.dataset?.preview === "true";
      const analyticsLocale = document.body?.dataset?.locale || document.documentElement.lang || "en";
      const analyticsRetentionDays = 90;

      const loadAnalyticsEvents = () => {
        try {
          const stored = localStorage.getItem(analyticsStorageKey);
          const parsed = stored ? JSON.parse(stored) : [];
          const cutoff = Date.now() - analyticsRetentionDays * 24 * 60 * 60 * 1000;
          const filtered = Array.isArray(parsed)
            ? parsed.filter((event) => typeof event?.timestamp === "number" && event.timestamp >= cutoff)
            : [];
          if (filtered.length !== parsed.length) {
            localStorage.setItem(analyticsStorageKey, JSON.stringify(filtered));
          }
          return filtered;
        } catch (error) {
          return [];
        }
      };

      const saveAnalyticsEvents = (events) => {
        localStorage.setItem(analyticsStorageKey, JSON.stringify(events));
      };

      const getSessionId = () => {
        const existing = localStorage.getItem(analyticsSessionKey);
        if (existing) return existing;
        const generated =
          "crypto" in window && "randomUUID" in crypto
            ? crypto.randomUUID()
            : `session-${Date.now()}-${Math.random().toString(16).slice(2)}`;
        localStorage.setItem(analyticsSessionKey, generated);
        return generated;
      };

      const recordAnalyticsEvent = (event) => {
        const events = loadAnalyticsEvents();
        events.push(event);
        saveAnalyticsEvents(events);
        sendAnalyticsEvent(event);
      };

      const sendAnalyticsEvent = (payload) => {
        if (!analyticsEndpoint) return;
        const body = JSON.stringify(payload);
        if ("sendBeacon" in navigator) {
          const blob = new Blob([body], { type: "application/json" });
          navigator.sendBeacon(analyticsEndpoint, blob);
          return;
        }
        fetch(analyticsEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      };

      const recordPreviewEvent = () => {
        if (!isPreview) return;
        const tokenHint = document.body?.dataset?.previewHint || "unknown";
        const expiresAt = document.body?.dataset?.previewExpires || null;
        const label = document.body?.dataset?.previewLabel || null;
        const event = {
          type: "preview",
          tokenHint,
          label,
          expiresAt,
          path: window.location.pathname,
          ts: Date.now(),
        };
        const existing = JSON.parse(localStorage.getItem(previewAnalyticsKey) ?? "[]");
        existing.push(event);
        localStorage.setItem(previewAnalyticsKey, JSON.stringify(existing.slice(-120)));
        window.dispatchEvent(new CustomEvent("book-preview", { detail: event }));
        if (typeof sendPreviewAnalytics === "function") {
          sendPreviewAnalytics(event);
        }
      };

      const analyticsVersion = document.body?.dataset?.bookVersion || "draft";
      const path = window.location.pathname;
      const pathSegments = path.split("/").filter(Boolean);
      const isChapter = pathSegments[0] === "read" && pathSegments[1] === "chapters" && pathSegments[2];
      const chapterSlug = isChapter ? pathSegments[2] : null;

      const sessionId = getSessionId();
      const pageViewTimestamp = Date.now();
      recordPreviewEvent();
      recordAnalyticsEvent({
        id: `view-${pageViewTimestamp}-${Math.random().toString(16).slice(2)}`,
        type: "pageview",
        timestamp: pageViewTimestamp,
        sessionId,
        path,
        chapterSlug,
        version: analyticsVersion,
        locale: analyticsLocale,
        title: document.title,
      });

      let maxScrollDepth = 0;
      const updateScrollDepth = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollable <= 0) {
          maxScrollDepth = 1;
          return;
        }
        const ratio = window.scrollY / scrollable;
        if (ratio > maxScrollDepth) {
          maxScrollDepth = ratio;
        }
      };

      let analyticsReported = false;
      const reportEngagement = () => {
        if (analyticsReported) return;
        analyticsReported = true;
        updateScrollDepth();
        const durationSeconds = Math.max(1, Math.round((Date.now() - pageViewTimestamp) / 1000));
        recordAnalyticsEvent({
          id: `engagement-${Date.now()}-${Math.random().toString(16).slice(2)}`,
          type: "engagement",
          timestamp: Date.now(),
          sessionId,
          path,
          chapterSlug,
          version: analyticsVersion,
          locale: analyticsLocale,
          durationSeconds,
          scrollDepth: Math.max(0, Math.min(1, maxScrollDepth)),
        });
      };

      updateScrollDepth();
      window.addEventListener("scroll", updateScrollDepth, { passive: true });
      window.addEventListener("beforeunload", reportEngagement);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "hidden") {
          reportEngagement();
        }
      });
    </script>
    <script type="module">
      const mermaidBlocks = Array.from(
        document.querySelectorAll("pre > code.language-mermaid, pre > code.mermaid")
      );
      if (mermaidBlocks.length) {
        const { default: mermaid } = await import("mermaid");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        mermaid.initialize({ startOnLoad: false, theme: prefersDark ? "dark" : "default" });
        const nodes = mermaidBlocks.map((code) => {
          const pre = code.parentElement;
          const container = document.createElement("div");
          container.className = "mermaid";
          container.textContent = code.textContent ?? "";
          pre?.replaceWith(container);
          return container;
        });
        await mermaid.run({ nodes });
      }
    </script>
  </body>
</html>
