---
import BaseLayout from "../../layouts/BaseLayout.astro";
import bookConfig from "../../book.config";
import { readRoutes } from "@bookkit/astro-bookkit";

const toolLinks = [
  {
    title: "Engagement analytics",
    description: "View reader behavior, drop-off signals, and feedback dashboards.",
    href: readRoutes.analytics,
  },
  {
    title: "Release notes",
    description: "Review version summaries and change rationale for published updates.",
    href: "/release-notes",
  },
  {
    title: "Offline exports",
    description: "Access book and chapter export options for offline reading workflows.",
    href: "/downloads",
  },
];
---
<BaseLayout title={`Tools • ${bookConfig.title}`}>
  <a class="back-link" href={readRoutes.root}>← Back to reading hub</a>
  <div class="section-header">
    <div class="eyebrow">Utilities</div>
    <h1>Tools and diagnostics</h1>
    <p class="lede">
      Publishing and operational surfaces are grouped here so the reading hub stays reader-first.
    </p>
  </div>

  <section class="content-block">
    <div class="card-grid">
      {toolLinks.map((link) => (
        <a class="card" href={link.href}>
          <h2>{link.title}</h2>
          <p class="meta">{link.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
