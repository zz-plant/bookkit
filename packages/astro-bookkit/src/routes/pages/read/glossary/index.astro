---
import BaseLayout from "../../../BaseLayout.astro";
import ContentIndexList from "../../../../components/ContentIndexList.astro";
import { createLocalizedContentList } from "../../../../localization";
import { bookEntryPoints, bookConfig } from "../../../runtime";
import { bookPageTitle } from "../../../../seo/page-meta";
import { buildTranslationLede, readItemPath } from "../../../../book";

const modules = bookEntryPoints.contentModules.glossary;
const { items: entryItems, completeness } = createLocalizedContentList(
	modules,
	{
		defaultLocale: "en",
		locale: Astro.locals?.locale,
		mapEntry: ({ slug, module, isFallback }) => {
			const frontmatter = module.frontmatter ?? {};
			const term = frontmatter.term ?? "Untitled term";
			return {
				href: readItemPath("glossary", slug),
				title: isFallback ? `${term} (not yet translated)` : term,
			};
		},
		sort: (a, b) => a.title.localeCompare(b.title),
	},
);
const localizedLede = buildTranslationLede(
	"The terms this book uses, defined.",
	completeness,
);
---
<BaseLayout title={bookPageTitle("Glossary", bookConfig.title)}>
  <ContentIndexList
    title="Glossary"
    lede={localizedLede}
    items={entryItems}
    filterMode="always"
    filterPlaceholder="Filter terms"
    alphaMode="always"
  />
</BaseLayout>
