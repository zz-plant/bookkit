---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";

const modules = import.meta.glob("../../../content/book/toolkit/*.mdx", { eager: true });
const { items: toolItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const name = frontmatter.name ?? "Untitled action";
    return {
      href: `/read/toolkit/${slug}`,
      title: isFallback ? `${name} (fallback)` : name,
      meta: `${frontmatter.mechanism ?? "general"} • ${
        frontmatter.timeboxMinutes ?? 10
      } min`,
    };
  },
  sort: (a, b) => a.title.localeCompare(b.title),
});
const localizedLede =
  typeof completeness === "number"
    ? `Translation completeness: ${Math.round(completeness * 100)}%.`
    : null;
---
<BaseLayout title="Toolkit • Bad People">
  <ContentIndexList
    title="Toolkit"
    lede={
      localizedLede
        ? `Action primitives designed to be executed in ≤10 minutes. ${localizedLede}`
        : "Action primitives designed to be executed in ≤10 minutes."
    }
    items={toolItems}
    filterMode="always"
    filterPlaceholder="Filter by action, mechanism, or timebox..."
    filterHint="Filter actions by name, mechanism, or timebox."
    alphaMode="always"
  />
</BaseLayout>
