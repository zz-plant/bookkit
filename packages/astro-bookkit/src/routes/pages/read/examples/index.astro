---
import BaseLayout from "../../../BaseLayout.astro";
import ContentIndexList from "../../../../components/ContentIndexList.astro";
import { createLocalizedContentList } from "../../../../localization";
import { bookEntryPoints, bookConfig } from "../../../runtime";
import { bookPageTitle } from "../../../../seo/page-meta";
import { buildTranslationLede, readItemPath } from "../../../../book";

const modules = bookEntryPoints.contentModules.examples;
const { items: exampleItems, completeness } = createLocalizedContentList(
	modules,
	{
		defaultLocale: "en",
		locale: Astro.locals?.locale,
		mapEntry: ({ slug, module, isFallback }) => {
			const frontmatter = module.frontmatter ?? {};
			const title = frontmatter.title ?? "Untitled example";
			return {
				href: readItemPath("examples", slug),
				title: isFallback ? `${title} (not yet translated)` : title,
				eyebrow: frontmatter.status ?? "draft",
				meta: [frontmatter.mechanism, frontmatter.domain]
					.filter(Boolean)
					.join(" · "),
			};
		},
		sort: (a, b) => a.title.localeCompare(b.title),
	},
);
const localizedLede = buildTranslationLede(
	"Worked cases for each mechanism.",
	completeness,
);
---
<BaseLayout title={bookPageTitle("Examples", bookConfig.title)}>
  <ContentIndexList
    title="Examples"
    lede={localizedLede}
    items={exampleItems}
    filterMode="always"
    filterPlaceholder="Filter by title, mechanism, or domain"
    alphaMode="always"
  />
</BaseLayout>
