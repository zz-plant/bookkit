---
import { readRoutes } from "@bookkit/astro-bookkit";
import bookConfig from "../book.config";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title={`Page not found • ${bookConfig.title}`} robots="noindex, nofollow">
  <div class="section-header">
    <div class="eyebrow">404</div>
    <h1>Page not found</h1>
    <p class="lede">
      This address does not exist in the current version of the book. It may have moved between releases.
    </p>
  </div>
  <section class="next-steps">
    <h2>Find it from here</h2>
    <p>
      <button type="button" class="button button--secondary" data-search-open data-search-from-path>
        Search the book
      </button>
    </p>
    <div class="next-steps__links">
      <a class="next-steps__link" href={readRoutes.root}>Reading hub</a>
      <a class="next-steps__link" href={readRoutes.chapters}>Chapters</a>
      <a class="next-steps__link" href={readRoutes.mechanisms}>Mechanisms</a>
      <a class="next-steps__link" href={readRoutes.toolkit}>Toolkit</a>
      <a class="next-steps__link" href={readRoutes.glossary}>Glossary</a>
      <a class="next-steps__link" href={readRoutes.examples}>Examples</a>
      <a class="next-steps__link" href="/release-notes">Release notes</a>
    </div>
  </section>
</BaseLayout>
