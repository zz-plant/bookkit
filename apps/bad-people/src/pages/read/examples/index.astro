---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";

const examples = Object.entries(
  import.meta.glob("../../../content/book/examples/**/*.mdx", { eager: true })
).map(([path, module]) => {
  const slug = path.split("/examples/")[1].replace(/\\.mdx$/, "");
  return {
    slug,
    title: module.frontmatter.title ?? "Untitled example",
    mechanism: module.frontmatter.mechanism ?? "general",
    domain: module.frontmatter.domain ?? "unknown",
    status: module.frontmatter.status ?? "draft",
  };
});

const sorted = examples.sort((a, b) => a.title.localeCompare(b.title));
const exampleItems = sorted.map((example) => ({
  href: `/read/examples/${example.slug}`,
  title: example.title,
  eyebrow: example.status,
  meta: `${example.mechanism} • ${example.domain}`,
}));
---
<BaseLayout title="Examples • Bad People">
  <ContentIndexList
    title="Examples"
    lede="Replaceable cases that ground each mechanism."
    items={exampleItems}
  />
</BaseLayout>
