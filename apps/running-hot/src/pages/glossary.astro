---
const destination = "/read/glossary";
const refreshContent = `0;url=${destination}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={refreshContent} />
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>{destination}</a>…
    </p>
  </body>
</html>
