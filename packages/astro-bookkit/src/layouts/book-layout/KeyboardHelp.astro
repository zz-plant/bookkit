<div class="keyboard-help" id="keyboard-help" data-kbd-panel hidden>
  <div
    class="keyboard-help__content"
    data-kbd-content
    role="dialog"
    aria-modal="false"
    aria-label="Keyboard shortcuts"
  >
    <div class="keyboard-help__header">
      <strong>Keyboard shortcuts</strong>
      <button type="button" class="kbd-close" data-kbd-close aria-label="Close keyboard shortcuts">
        Esc
      </button>
    </div>
    <ul class="keyboard-help__list">
      <li><span>Open this panel</span><span class="kbd-hint"><kbd>?</kbd></span></li>
      <li><span>Open search</span><span class="kbd-hint"><kbd>⌘</kbd><kbd>K</kbd> / <kbd>/</kbd></span></li>
      <li><span>Go to home</span><span class="kbd-hint"><kbd>g</kbd><kbd>h</kbd></span></li>
      <li><span>Go to reading hub</span><span class="kbd-hint"><kbd>g</kbd><kbd>r</kbd></span></li>
      <li><span>Go to release notes</span><span class="kbd-hint"><kbd>g</kbd><kbd>n</kbd></span></li>
      <li><span>Open downloads</span><span class="kbd-hint"><kbd>g</kbd><kbd>d</kbd></span></li>
      <li><span>Open author diagnostics</span><span class="kbd-hint"><kbd>g</kbd><kbd>a</kbd></span></li>
      <li><span>Go to overview</span><span class="kbd-hint"><kbd>g</kbd><kbd>o</kbd></span></li>
      <li><span>Jump to chapters</span><span class="kbd-hint"><kbd>g</kbd><kbd>c</kbd></span></li>
      <li><span>Jump to mechanisms</span><span class="kbd-hint"><kbd>g</kbd><kbd>m</kbd></span></li>
      <li><span>Jump to toolkit</span><span class="kbd-hint"><kbd>g</kbd><kbd>t</kbd></span></li>
      <li><span>Jump to glossary</span><span class="kbd-hint"><kbd>g</kbd><kbd>l</kbd></span></li>
      <li><span>Jump to examples</span><span class="kbd-hint"><kbd>g</kbd><kbd>e</kbd></span></li>
      <li><span>Previous section</span><span class="kbd-hint"><kbd>[</kbd></span></li>
      <li><span>Next section</span><span class="kbd-hint"><kbd>]</kbd></span></li>
      <li><span>Close panel</span><span class="kbd-hint"><kbd>Esc</kbd></span></li>
    </ul>
    <p class="keyboard-help__note">Shortcuts are active when you are not typing in a form field.</p>
  </div>
</div>
