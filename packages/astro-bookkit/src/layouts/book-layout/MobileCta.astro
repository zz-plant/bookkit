---
const { isReadRoute = false, isReadDetailRoute = false } = Astro.props;
// "page" only on the hub itself; below it "Read" marks the section the reader is in.
const readLinkCurrent = isReadRoute
	? isReadDetailRoute
		? "true"
		: "page"
	: undefined;
---
<nav class="mobile-cta" aria-label="Quick actions" data-mobile-cta>
  <a
    class="mobile-cta__primary"
    href="/read"
    aria-current={readLinkCurrent}
  >
    Read
  </a>
  <button type="button" data-mobile-search aria-controls="search-panel" aria-expanded="false">Search</button>
  <button type="button" data-mobile-menu aria-controls="site-nav-more" aria-expanded="false">Menu</button>
</nav>
