---
type Props = {
  destination: string;
  title?: string;
};

const { destination, title = "Redirecting…" } = Astro.props;
const refreshContent = `0;url=${destination}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta http-equiv="refresh" content={refreshContent} />
    <link rel="canonical" href={destination} />
  </head>
  <body>
    <p>
      Redirecting to <a href={destination}>{destination}</a>…
    </p>
  </body>
</html>