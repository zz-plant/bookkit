---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeedbackWidget from "@bookkit/astro-bookkit/components/FeedbackWidget.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ChapterToc from "@bookkit/astro-bookkit/components/ChapterToc.astro";
import { getChapterExportLinks } from "../../../lib/exports";
import {
	buildLocalizedContentIndex,
	resolveLocalizedContent,
	resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import bookConfig from "../../../book.config";
import Breadcrumbs from "@bookkit/astro-bookkit/components/Breadcrumbs.astro";
import { getReadPageBreadcrumbCopy } from "../../../lib/read-copy";
import {
	actionLinksForMechanisms,
	bookPageTitle,
	buildLocalizedReadRoutePath,
	chapterLinksInReadingOrder,
	chapterPositionLabel,
	createBreadcrumbListStructuredDataFromTrail,
	defaultChapterPageCopy,
	firstMetaDescription,
	hasServerRuntime,
	isThinPage,
	pageFactsForModule,
	prerequisiteChapterLinks,
	readItemPath,
	readRoutes,
	THIN_PAGE_ROBOTS,
} from "@bookkit/astro-bookkit";

export async function getStaticPaths() {
	const modules = bookEntryPoints.contentModules.chapters;
	const localizedIndex = buildLocalizedContentIndex(modules, {
		defaultLocale: "en",
	});

	return localizedIndex.slugs.map((slug) => ({
		params: { slug },
	}));
}

const modules = bookEntryPoints.contentModules.chapters;
const localizedIndex = buildLocalizedContentIndex(modules, {
	defaultLocale: "en",
});
const { missingSlugs, entries } = resolveLocalizedContent(localizedIndex, {
	locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
	locale: Astro.locals?.locale,
});

if (!module) {
	throw new Error(`Missing chapter for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const exportLinks = getChapterExportLinks(
	frontmatter.slug,
	frontmatter.title ?? "Chapter",
);
const isFallback = missingSlugs.includes(frontmatter.slug);
const headings =
	typeof module.getHeadings === "function" ? module.getHeadings() : [];
const chapterMechanisms = Array.isArray(frontmatter.mechanisms)
	? frontmatter.mechanisms
	: [];
const mechanismIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.mechanisms,
	{
		defaultLocale: "en",
	},
);
const { entries: mechanismEntries } = resolveLocalizedContent(mechanismIndex, {
	locale: Astro.locals?.locale,
});
const mechanismTitleBySlug = new Map(
	mechanismEntries.map(({ slug, module: mechanismModule }) => [
		slug,
		mechanismModule.frontmatter?.title ?? slug,
	]),
);
// Reading order is the author's: an explicit `order`, else the numbered file
// order. The index lists chapters in the same order, drafts included.
const chapterOrder = chapterLinksInReadingOrder(entries);
// What to read first, and the actions for the mechanisms this chapter uses.
const prerequisites = prerequisiteChapterLinks(
	frontmatter.prerequisites,
	entries,
);
const { entries: toolkitEntries } = resolveLocalizedContent(
	buildLocalizedContentIndex(bookEntryPoints.contentModules.toolkit, {
		defaultLocale: "en",
	}),
	{ locale: Astro.locals?.locale },
);
const chapterActions = actionLinksForMechanisms(
	chapterMechanisms,
	toolkitEntries,
);
const currentIndex = chapterOrder.findIndex(
	(entry) => entry.slug === frontmatter.slug,
);
const previousChapter =
	currentIndex > 0 ? chapterOrder[currentIndex - 1] : null;
const nextChapter = currentIndex >= 0 ? chapterOrder[currentIndex + 1] : null;
const requestPath = Astro.url.pathname;
const localizedReadRootPath = buildLocalizedReadRoutePath(
	requestPath,
	readRoutes.root,
);
const localizedSectionPath = buildLocalizedReadRoutePath(
	requestPath,
	readRoutes.chapters,
);
const breadcrumbCopy = getReadPageBreadcrumbCopy(Astro.locals?.locale);
const breadcrumbItems = [
	{ name: breadcrumbCopy.readingHub, href: localizedReadRootPath },
	{ name: breadcrumbCopy.chapters, href: localizedSectionPath },
	{ name: frontmatter.title },
];
const breadcrumbStructuredData = createBreadcrumbListStructuredDataFromTrail(
	breadcrumbItems,
	Astro.url,
);
const pageFacts = pageFactsForModule(
	modules,
	bookEntryPoints.contentRawModules.chapters,
	module,
);
const metaDescription = firstMetaDescription(
	frontmatter.summary,
	pageFacts?.excerpt,
);
// Outlines and stub chapters stay readable but out of search until they are written.
const robots = isThinPage(pageFacts?.wordCount, bookConfig.site)
	? THIN_PAGE_ROBOTS
	: undefined;
const chapterEyebrow = [
	currentIndex >= 0
		? chapterPositionLabel(currentIndex + 1, chapterOrder.length)
		: null,
	frontmatter.status === "published" ? null : (frontmatter.status ?? "draft"),
	isFallback ? "not yet translated" : null,
]
	.filter(Boolean)
	.join(" · ");
---
<BaseLayout
  title={bookPageTitle(frontmatter.title, bookConfig.title)}
  description={metaDescription}
  robots={robots}
  structuredData={[breadcrumbStructuredData]}
>
  <Breadcrumbs items={breadcrumbItems} ariaLabel={breadcrumbCopy.ariaLabel} />
  <div class="chapter-shell">
    <article data-resume-chapter={frontmatter.slug}>
      {chapterEyebrow && <div class="eyebrow">{chapterEyebrow}</div>}
      <h1 id={frontmatter.slug}>{frontmatter.title}</h1>
      {prerequisites.length > 0 && (
        <div class="chapter-mechanisms chapter-prerequisites">
          <span class="meta chapter-mechanisms__label">{defaultChapterPageCopy.prerequisitesLabel}</span>
          {prerequisites.map((link) => (
            <a class="pill" href={link.href}>{link.label}</a>
          ))}
        </div>
      )}
      {chapterMechanisms.length > 0 && (
        <div class="chapter-mechanisms">
          <span class="meta chapter-mechanisms__label">Mechanisms:</span>
          {chapterMechanisms.map((mechSlug: string) => (
            <a class="pill" href={readItemPath("mechanisms", mechSlug)}>
              {mechanismTitleBySlug.get(mechSlug) ?? mechSlug}
            </a>
          ))}
        </div>
      )}
      {headings.length > 0 && (
        <details class="chapter-toc-mobile">
          <summary>{defaultChapterPageCopy.chapterStepsHeading} ({headings.filter((h: any) => h.depth <= 3).length})</summary>
          <ChapterToc headings={headings} label={defaultChapterPageCopy.chapterMapLabel} />
        </details>
      )}
      <section class="content-block chapter-content" data-chapter-sections>
        <Content />
      </section>
    </article>

    <aside class="chapter-meta-panel">
      {headings.length > 0 && <h2>{defaultChapterPageCopy.chapterStepsHeading}</h2>}
      <ChapterToc headings={headings} label={defaultChapterPageCopy.chapterMapLabel} />
      <ExportPanel
        title={defaultChapterPageCopy.downloadChapterTitle}
        description={defaultChapterPageCopy.downloadChapterDescription}
        links={exportLinks}
      />
    </aside>
  </div>

  <nav class="chapter-pagination" aria-label="Chapter navigation">
    {previousChapter ? (
      <a class="chapter-pagination__card chapter-pagination__card--prev" href={previousChapter.href}>
        <span class="chapter-pagination__label">← Previous chapter</span>
        <span class="chapter-pagination__title">{previousChapter.label}</span>
      </a>
    ) : <div />}
    {nextChapter ? (
      <a class="chapter-pagination__card chapter-pagination__card--next" href={nextChapter.href}>
        <span class="chapter-pagination__label">Next chapter →</span>
        <span class="chapter-pagination__title">{nextChapter.label}</span>
      </a>
    ) : <div />}
  </nav>

  <section class="next-steps" id="next-steps">
    <h2>{defaultChapterPageCopy.nextMoveHeading}</h2>
    {chapterActions.length > 0 && <div class="eyebrow">{defaultChapterPageCopy.chapterActionsLabel}</div>}
    <div class="next-steps__links next-steps__branches">
      {chapterActions.length > 0 ? (
        chapterActions.map((link) => (
          <a class="next-steps__link" href={link.href}>{link.label}</a>
        ))
      ) : (
        <>
          <a class="next-steps__link" href={readRoutes.mechanisms}>{defaultChapterPageCopy.mechanismsLinkLabel}</a>
          <a class="next-steps__link" href={readRoutes.toolkit}>{defaultChapterPageCopy.toolkitLinkLabel}</a>
        </>
      )}
    </div>
  </section>
  {hasServerRuntime(bookConfig.site) && (
    <FeedbackWidget
      slug={frontmatter.slug}
      title={frontmatter.title}
      contentType="chapter"
      endpoint="/api/feedback.json"
    />
  )}
</BaseLayout>
