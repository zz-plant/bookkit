---
import VersionSwitcher from "../../components/VersionSwitcher.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";

const {
  bookTitle,
  isPreview,
  previewLabel,
  versionBadgeLabel,
  isReadRoute,
  isDownloadsRoute,
  isReadDetailRoute,
  hasVersions,
  localeEntries,
  versionEntries,
  currentPath,
  resolvedVersion,
  versionPrefix,
  versionArchivePath,
  activeLocale,
  resolvedDefaultLocale,
  includeDefaultLocalePrefix,
  localeLabel,
  aiQaEnabled,
  enableAuthorTools = isPreview ?? false,
} = Astro.props;

const emphasizeReadCta = !isReadRoute;
const emphasizeDownloadsCta = !isDownloadsRoute;
const readSectionFromPath = currentPath?.match(/\/read\/([^/]+)/)?.[1] ?? null;
const readSectionLabels = {
  overview: "Overview",
  chapters: "Chapters",
  mechanisms: "Mechanisms",
  toolkit: "Toolkit",
  examples: "Examples",
  glossary: "Glossary",
  tools: "Author tools",
};
const activeReadSectionLabel =
  isReadRoute && readSectionFromPath
    ? readSectionLabels[readSectionFromPath as keyof typeof readSectionLabels] ?? null
    : null;
---
      <header class="site-header">
        <div class="site-brand">
          <a href="/">{bookTitle}</a>
          {isPreview && <span class="preview-badge">{previewLabel}</span>}
          {versionBadgeLabel && <span class="version-badge">{versionBadgeLabel}</span>}
          {activeReadSectionLabel && <span class="site-brand__context">{activeReadSectionLabel}</span>}
        </div>
        <nav class:list={["site-nav", { "site-nav--in-read-detail": isReadDetailRoute }]} aria-label="Primary">
          <a
            class:list={[
              "site-nav__primary",
              {
                "site-nav__primary--active-route": isReadRoute,
                "site-nav__primary--emphasis": emphasizeReadCta,
              },
            ]}
            href="/read"
            aria-current={isReadRoute ? "page" : undefined}
            aria-keyshortcuts="g r"
          >
            {isReadRoute ? "Reading hub" : "Start reading"}
          </a>
          <a
            class:list={[
              "site-nav__primary",
              {
                "site-nav__primary--active-route": isDownloadsRoute,
                "site-nav__primary--emphasis": emphasizeDownloadsCta,
              },
            ]}
            href="/downloads"
            aria-current={isDownloadsRoute ? "page" : undefined}
            aria-keyshortcuts="g d"
          >
            Downloads
          </a>
          <button
            class="search-toggle"
            type="button"
            aria-keyshortcuts="k /"
            aria-expanded="false"
            aria-controls="search-panel"
            data-search-toggle
          >
            Search <span aria-hidden="true">⌘K</span>
          </button>
          <div class="site-nav__more" data-site-nav-more id="site-nav-more">
            <button type="button" class="site-nav__more-toggle" data-site-nav-more-toggle aria-expanded="false">
              Menu
              <span aria-hidden="true" class="site-nav__toggle-icon">▾</span>
            </button>
            <div class="site-nav__overflow" data-site-nav-overflow hidden>
              <div class="site-nav__group site-nav__group--reader">
                <p class="site-nav__group-label">Updates</p>
                <a href="/release-notes" aria-keyshortcuts="g n">Release notes</a>
              </div>
              {enableAuthorTools && (
                <div class="site-nav__group site-nav__group--author">
                  <p class="site-nav__group-label">For authors</p>
                  <a href="/read/tools" aria-keyshortcuts="g a">Author tools</a>
                  <a href="/new-book" aria-keyshortcuts="g b">Start a new book</a>
                </div>
              )}
              <hr class="site-nav__separator" />
              {(hasVersions || localeEntries.length > 1) && (
                <details class="site-settings" data-site-settings>
                  <summary class="site-settings__toggle">
                    Version and language
                    <span aria-hidden="true" class="site-nav__toggle-icon">▾</span>
                  </summary>
                  <div class="site-settings__panel">
                    {hasVersions && (
                      <VersionSwitcher
                        versions={versionEntries}
                        currentPath={Astro.url.pathname}
                        currentVersion={resolvedVersion}
                        prefixSegment={versionPrefix}
                        archivePath={versionArchivePath}
                      />
                    )}
                    {localeEntries.length > 1 && (
                      <LanguageSwitcher
                        locales={localeEntries}
                        currentPath={Astro.url.pathname}
                        currentLocale={activeLocale}
                        defaultLocale={resolvedDefaultLocale}
                        includeDefaultPrefix={includeDefaultLocalePrefix}
                        label={localeLabel}
                      />
                    )}
                  </div>
                </details>
              )}
              <details class="reader-settings" data-reader-settings>
                <summary class="reader-settings__toggle">
                  Appearance
                  <span aria-hidden="true" class="site-nav__toggle-icon">▾</span>
                </summary>
                <div class="reader-settings__panel">
                  <p class="reader-settings__hint">Saved on this device.</p>
                  <div class="reader-settings__group" role="group" aria-label="Reading theme">
                    <span class="reader-settings__label">Theme</span>
                    <div class="reader-settings__options">
                      <button type="button" data-reader-theme="auto">Auto</button>
                      <button type="button" data-reader-theme="light">Light</button>
                      <button type="button" data-reader-theme="dark">Dark</button>
                    </div>
                  </div>
                  <div class="reader-settings__group" role="group" aria-label="Reading density">
                    <span class="reader-settings__label">Density</span>
                    <div class="reader-settings__options">
                      <button type="button" data-reader-density="compact">Compact</button>
                      <button type="button" data-reader-density="comfortable">Comfortable</button>
                      <button type="button" data-reader-density="relaxed">Relaxed</button>
                    </div>
                  </div>
                  <div class="reader-settings__group" role="group" aria-label="Reading font">
                    <span class="reader-settings__label">Font</span>
                    <div class="reader-settings__options">
                      <button type="button" data-reader-font="serif">Serif</button>
                      <button type="button" data-reader-font="sans">Sans</button>
                    </div>
                  </div>
                </div>
              </details>
              {aiQaEnabled && (
                <button
                  class="qa-toggle"
                  type="button"
                  aria-expanded="false"
                  aria-controls="qa-panel"
                  data-qa-toggle
                >
                  Ask <span aria-hidden="true">the book</span>
                </button>
              )}
              <button
                class="kbd-toggle"
                type="button"
                aria-keyshortcuts="?"
                aria-expanded="false"
                aria-controls="keyboard-help"
                data-kbd-toggle
              >
                Shortcuts <span aria-hidden="true">?</span>
              </button>
            </div>
          </div>
        </nav>
      </header>
