---
import "../styles/bookkit.css";
import bookLayoutUiClient from "./book-layout/ui.ts?url";
import bookLayoutAnalyticsClient from "./book-layout/analytics.ts?url";
import bookLayoutMermaidClient from "./book-layout/mermaid.ts?url";
import SiteHeader from "./book-layout/SiteHeader.astro";
import MobileCta from "./book-layout/MobileCta.astro";
import SearchPanel from "./book-layout/SearchPanel.astro";
import KeyboardHelp from "./book-layout/KeyboardHelp.astro";
import ReadingProgressBar from "../components/ReadingProgressBar.astro";
import { createBookLayoutRenderState, type BookLayoutRenderState } from "../book/layout";

const {
  title,
  hasMermaid,
  bookTitle = "Book",
  bookVersion = "draft",
  bookKey = "book",
  analyticsEndpoint = "/api/analytics.json",
  exportAnalyticsEndpoint = "/api/export-analytics.json",
  previewAnalyticsEndpoint = "/api/preview-analytics.json",
  footerText = "Draft book instance.",
  metaDescription,
  siteUrl,
  canonicalPath,
  canonicalUrl,
  ogImage,
  ogTitle,
  ogDescription,
  ogType = "website",
  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  ogSiteName,
  ogLocale,
  ogImageAlt,
  twitterImageAlt,
  structuredData,
  robots,
  aiQaEnabled = true,
  aiQaProvider,
  aiQaSamples = [
    "What is the core mechanism behind transfer success?",
    "How do I spot a compliance trap in an organization?",
    "Which actions help reverse moral technology?",
  ],
  isPreview = false,
  previewLabel = "Preview",
  previewTokenHint,
  previewExpiresAt,
  versions = [],
  versionPrefix = "v",
  versionArchivePath = "/versions",
  versionArchiveNoindex = true,
  locales = [],
  currentLocale,
  defaultLocale = "en",
  includeDefaultLocalePrefix = false,
  localeLabel = "Language",
  showLocaleNotice = true,
  enableAuthorTools,
  renderState: precomputedRenderState,
} = Astro.props;

const renderState: BookLayoutRenderState =
  precomputedRenderState ??
  createBookLayoutRenderState({
    title,
    hasMermaid: hasMermaid ?? false,
    bookTitle,
    bookVersion,
    seoProps: {
      siteUrl,
      metaDescription,
      canonicalPath,
      canonicalUrl,
      ogImage,
      ogTitle,
      ogDescription,
      ogType,
      twitterCard,
      twitterTitle,
      twitterDescription,
      twitterImage,
      ogSiteName,
      ogLocale,
      ogImageAlt,
      twitterImageAlt,
      structuredData,
      robots,
    },
    requestPathname: Astro.url.pathname,
    analyticsEndpoint,
    versionEntries: Array.isArray(versions) ? versions : [],
    versionPrefix,
    versionArchivePath,
    versionArchiveNoindex,
    locales: Array.isArray(locales) ? locales : [],
    currentLocale,
    defaultLocale,
    includeDefaultLocalePrefix,
    localeLabel,
    showLocaleNotice,
    isPreview,
    previewLabel,
    previewTokenHint,
    previewExpiresAt,
  });

const shouldLoadMermaidRuntime = hasMermaid ?? renderState.hasMermaid;
const shouldLoadAnalyticsRuntime = Boolean(analyticsEndpoint);
---
<!doctype html>
<html lang={renderState.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{renderState.pageTitle}</title>
    {renderState.metaDescription && <meta name="description" content={renderState.metaDescription} />}
    {renderState.head.resolvedCanonical && <link rel="canonical" href={renderState.head.resolvedCanonical} />}
    {renderState.head.resolvedRobots && <meta name="robots" content={renderState.head.resolvedRobots} />}
    {renderState.head.resolvedOgTitle && <meta property="og:title" content={renderState.head.resolvedOgTitle} />}
    {renderState.head.resolvedOgDescription && <meta property="og:description" content={renderState.head.resolvedOgDescription} />}
    {renderState.head.resolvedCanonical && <meta property="og:url" content={renderState.head.resolvedCanonical} />}
    {renderState.ogType && <meta property="og:type" content={renderState.ogType} />}
    {renderState.head.resolvedOgSiteName && <meta property="og:site_name" content={renderState.head.resolvedOgSiteName} />}
    {renderState.head.resolvedOgLocale && <meta property="og:locale" content={renderState.head.resolvedOgLocale} />}
    {renderState.ogImage && <meta property="og:image" content={renderState.ogImage} />}
    {renderState.head.resolvedOgImageAlt && <meta property="og:image:alt" content={renderState.head.resolvedOgImageAlt} />}
    {renderState.head.resolvedTwitterCard && <meta name="twitter:card" content={renderState.head.resolvedTwitterCard} />}
    {renderState.head.resolvedTwitterTitle && <meta name="twitter:title" content={renderState.head.resolvedTwitterTitle} />}
    {renderState.head.resolvedTwitterDescription && <meta name="twitter:description" content={renderState.head.resolvedTwitterDescription} />}
    {renderState.head.resolvedTwitterImage && <meta name="twitter:image" content={renderState.head.resolvedTwitterImage} />}
    {renderState.head.resolvedTwitterImageAlt && <meta name="twitter:image:alt" content={renderState.head.resolvedTwitterImageAlt} />}
    {renderState.head.hreflangEntries.map((entry) => (
      <link rel="alternate" hreflang={entry.locale} href={entry.href} />
    ))}
    {renderState.head.hreflangDefault && <link rel="alternate" hreflang="x-default" href={renderState.head.hreflangDefault} />}
    {renderState.head.structuredDataScripts.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body
    data-book-version={renderState.version.resolvedVersion ?? bookVersion}
    data-analytics-key={bookKey}
    data-analytics-endpoint={analyticsEndpoint}
    data-export-analytics-endpoint={exportAnalyticsEndpoint}
    data-preview-analytics-endpoint={previewAnalyticsEndpoint}
    data-locale={renderState.locale.activeLocale}
    data-qa-enabled={aiQaEnabled ? "true" : "false"}
    data-qa-endpoint={aiQaEnabled ? "/api/qa.json" : undefined}
    data-qa-providers={JSON.stringify(aiQaProvider ? [aiQaProvider] : undefined)}
    data-preview={renderState.preview.isPreview ? "true" : "false"}
    data-preview-hint={renderState.preview.tokenHint}
    data-preview-expires={renderState.preview.expiresAt}
    data-preview-label={renderState.preview.label}
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="page">
      <ReadingProgressBar />
      <SiteHeader
        bookTitle={bookTitle}
        isPreview={renderState.preview.isPreview}
        previewLabel={renderState.preview.label}
        versionBadgeLabel={renderState.version.badgeLabel}
        isReadRoute={renderState.routes.isReadRoute}
        isDownloadsRoute={renderState.routes.isDownloadsRoute}
        isReadDetailRoute={renderState.routes.isReadDetailRoute}
        hasVersions={renderState.version.hasVersions}
        localeEntries={renderState.locale.entries}
        versionEntries={renderState.version.entries}
        currentPath={renderState.routes.requestPathname}
        resolvedVersion={renderState.version.resolvedVersion}
        versionPrefix={renderState.version.prefix}
        versionArchivePath={renderState.version.archivePath}
        activeLocale={renderState.locale.activeLocale}
        resolvedDefaultLocale={renderState.locale.defaultLocale}
        includeDefaultLocalePrefix={renderState.locale.includeDefaultLocalePrefix}
        localeLabel={renderState.locale.label}
        aiQaEnabled={aiQaEnabled}
        enableAuthorTools={enableAuthorTools ?? renderState.preview.isPreview}
      />
      {renderState.translationNotice.show && (
        <div class="translation-notice" role="status">
          <span class="translation-notice__badge">Translation in progress</span>
          <span class="translation-notice__text">
            {renderState.translationNotice.activeLocaleLabel} is {renderState.translationNotice.percentage ?? 0}% complete.
            Missing sections will fall back to {renderState.translationNotice.defaultLocaleLabel ?? "the default language"}.
          </span>
        </div>
      )}
      {renderState.preview.isPreview && (
        <div class="preview-notice" role="status">
          <span class="preview-notice__badge">Preview access</span>
          <span class="preview-notice__text">You’re viewing a private preview of this book.</span>
          {renderState.preview.details.length ? (
            <span class="preview-notice__meta">{renderState.preview.details.join(" • ")}</span>
          ) : null}
        </div>
      )}
      {renderState.statusActions.show && (
        <div class="status-actions" role="status" aria-live="polite">
          {renderState.version.showVersionHint && (
            <a class="status-actions__link" href="/release-notes">
              You are viewing v{renderState.version.resolvedVersion}. Open release notes to compare with the latest version.
            </a>
          )}
          {renderState.translationNotice.show && (
            <a class="status-actions__link" href="/release-notes">
              Translation is still in progress. Check release notes for the most stable update before sharing.
            </a>
          )}
          {renderState.preview.isPreview && (
            <a class="status-actions__link" href="/downloads">
              Using preview mode? Download an offline copy if you need to read without access interruptions.
            </a>
          )}
        </div>
      )}
      <main id="main-content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <span>{footerText}</span>
      </footer>
      <MobileCta isReadRoute={renderState.routes.isReadRoute} />
      <SearchPanel />
      {aiQaEnabled && <QaPanel aiQaSamples={aiQaSamples} />}
      <KeyboardHelp />
    </div>
    <script type="module" src={bookLayoutUiClient}></script>
    {shouldLoadAnalyticsRuntime && <script type="module" src={bookLayoutAnalyticsClient}></script>}
    {shouldLoadMermaidRuntime && <script type="module" src={bookLayoutMermaidClient}></script>}
  </body>
</html>
