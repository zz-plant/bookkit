---
import type { ExportLink } from "../exports";

const { title = "Downloads", description, links = [] } = Astro.props as {
  title?: string;
  description?: string;
  links?: ExportLink[];
};
---
<section class="export-panel">
  <div class="export-panel__header">
    <h2>{title}</h2>
    {description && <p class="meta">{description}</p>}
  </div>
  <div class="export-panel__list">
    {links.map((link) => (
      <a
        class="export-panel__item"
        href={link.href}
        data-export-link
        data-export-format={link.format}
        data-export-scope={link.scope ?? "book"}
        data-export-slug={link.slug}
      >
        <div class="export-panel__label">
          <strong>{link.label}</strong>
          <span class="meta">
            {[link.size, link.updatedAt && `updated ${link.updatedAt}`].filter(Boolean).join(" · ")}
          </span>
        </div>
        <span class="export-panel__badge">{link.format.toUpperCase()}</span>
      </a>
    ))}
  </div>
</section>
