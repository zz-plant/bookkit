---
export type NextActionLink = {
	href: string;
	label: string;
	meta?: string | null;
};

const { title = "Next", eyebrow, description, links = [] } = Astro.props;

const resolvedLinks = Array.isArray(links)
	? links.filter((link) => link?.href && link?.label)
	: [];
---
{resolvedLinks.length > 0 && (
  <section class="next-action-panel" aria-label={title}>
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h2>{title}</h2>
    {description && <p class="meta">{description}</p>}
    <div class="next-action-panel__links">
      {resolvedLinks.map((link) => (
        <a class="next-action-panel__link" href={link.href}>
          <strong>{link.label}</strong>
          {link.meta && <span class="meta">{link.meta}</span>}
        </a>
      ))}
    </div>
  </section>
)}
