---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";

const tools = Object.values(
  import.meta.glob("../../../content/book/toolkit/*.mdx", { eager: true })
)
  .map((module) => ({
    slug: module.frontmatter.slug,
    name: module.frontmatter.name ?? "Untitled action",
    mechanism: module.frontmatter.mechanism ?? "general",
    timebox: module.frontmatter.timeboxMinutes ?? 10,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const toolItems = tools.map((tool) => ({
  href: `/read/toolkit/${tool.slug}`,
  title: tool.name,
  meta: `${tool.mechanism} • ${tool.timebox} min`,
}));
---
<BaseLayout title="Toolkit • Bad People">
  <ContentIndexList
    title="Toolkit"
    lede="Action primitives designed to be executed in ≤10 minutes."
    items={toolItems}
  />
</BaseLayout>
