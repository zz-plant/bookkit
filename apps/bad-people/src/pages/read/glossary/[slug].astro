---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import bookConfig from "../../../book.config";
import { readRoutes } from "../../../lib/read-routes";

export async function getStaticPaths() {
  const modules = bookEntryPoints.contentModules.glossary;
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = bookEntryPoints.contentModules.glossary;
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing glossary entry for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const isFallback = missingSlugs.includes(frontmatter.slug);
---
<BaseLayout title={`${frontmatter.term} • ${bookConfig.title}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={readRoutes.root}>Reading hub</a>
    <span>›</span>
    <a href={readRoutes.glossary}>Glossary</a>
    <span>›</span>
    <span>{frontmatter.term}</span>
  </nav>
  <a class="back-link" href={readRoutes.glossary}>← Glossary</a>
  <div class="eyebrow">Glossary{isFallback ? " • fallback" : ""}</div>
  <h1 id={frontmatter.slug}>{frontmatter.term}</h1>
  <section class="content-block">
    <Content />
  </section>
  <section class="next-steps">
    <h2>Next steps</h2>
    <div class="next-steps__links">
      <a class="next-steps__link" href={readRoutes.mechanisms}>Review mechanisms</a>
      <a class="next-steps__link" href={readRoutes.examples}>Browse examples</a>
      <a class="next-steps__link" href={readRoutes.toolkit}>Explore toolkit actions</a>
    </div>
  </section>
</BaseLayout>
