---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { getBookExportLinks } from "../../../lib/exports";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
} from "@bookkit/astro-bookkit/localization";

const modules = import.meta.glob("../../../content/book/chapters/*.mdx", { eager: true });
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { entries, completeness } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const chapterItems = entries.map(({ slug, module, isFallback }) => {
  const frontmatter = module.frontmatter ?? {};
  const status = frontmatter.status ?? "draft";
  return {
    href: `/read/chapters/${slug}`,
    title: frontmatter.title ?? "Untitled chapter",
    eyebrow: isFallback ? `${status} · fallback` : status,
  };
});
const exportLinks = getBookExportLinks();
const localizedLede =
  typeof completeness === "number"
    ? `Translation completeness: ${Math.round(completeness * 100)}%.`
    : null;
---
<BaseLayout title="Chapters • Bad People">
  <ContentIndexList
    title="Chapters"
    lede={
      localizedLede
        ? `Module outlines that define the intervention frame. ${localizedLede}`
        : "Module outlines that define the intervention frame."
    }
    items={chapterItems}
  >
    <ExportPanel
      slot="after-header"
      title="Download exports"
      description="Grab a print-ready PDF or an EPUB for offline reading."
      links={exportLinks}
    />
  </ContentIndexList>
</BaseLayout>
