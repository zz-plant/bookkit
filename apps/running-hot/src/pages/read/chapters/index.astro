---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { getBookExportLinks } from "../../../lib/exports";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath } from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.chapters;
const { items: chapterItems, completeness } = createLocalizedContentList(
	modules,
	{
		defaultLocale: "en",
		locale: Astro.locals?.locale,
		mapEntry: ({ slug, module, isFallback }) => {
			const frontmatter = module.frontmatter ?? {};
			return {
				href: readItemPath("chapters", slug),
				title: frontmatter.title ?? "Untitled chapter",
				status: String(frontmatter.status ?? "draft"),
				badges: isFallback ? ["Not yet translated"] : null,
			};
		},
	},
);
// A status only helps when chapters differ; if every chapter is a draft, say so once.
const hasMixedStatus =
	new Set(chapterItems.map((item) => item.status)).size > 1;
const listedChapters = chapterItems.map(({ status, ...item }) => ({
	...item,
	eyebrow: hasMixedStatus && status !== "published" ? status : null,
}));
const draftCount = chapterItems.filter(
	(item) => item.status === "draft",
).length;
const exportLinks = getBookExportLinks();
const localizedLede = buildTranslationLede(
	"The full argument, one chapter at a time.",
	completeness,
);
---
<BaseLayout title={`Chapters • ${bookConfig.title}`}>
  <ContentIndexList
    title="Chapters"
    lede={localizedLede}
    items={listedChapters}
    filterPlaceholder="Filter by title"
    alphaMode={false}
  >
    {draftCount > 0 && (
      <details slot="after-header" class="content-block content-block--flush">
        <summary>
          <strong>{draftCount === chapterItems.length ? "These chapters are drafts" : "Some chapters are drafts"}</strong>
        </summary>
        <p class="meta">
          Drafts are complete enough to use. The mechanisms they describe won’t change, but wording,
          examples, and order may.
        </p>
      </details>
    )}
    <ExportPanel
      slot="after-list"
      title="Download the book"
      description="PDF for print, EPUB for e-readers. Single chapters are on the Downloads page."
      links={exportLinks}
    />
  </ContentIndexList>
</BaseLayout>
