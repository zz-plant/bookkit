---
export type Props = {
  term: string;
  definition: string;
  href: string;
  label?: string;
};

const { term, definition, href, label = term } = Astro.props;
---
<span class="concept-popover" data-concept-popover tabindex="0" role="button" aria-haspopup="true">
  <span class="concept-popover__trigger">{label}</span>
  <span class="concept-popover__card" role="tooltip">
    <strong style="display: block; margin-bottom: 0.25rem; font-size: var(--text-sm);">{term}</strong>
    <span style="color: var(--color-muted); display: block; margin-bottom: 0.5rem;">{definition}</span>
    <a href={href} class="pill" style="font-size: var(--text-xs); padding: 0.15rem 0.5rem; text-decoration: none;">
      Full definition →
    </a>
  </span>
</span>
