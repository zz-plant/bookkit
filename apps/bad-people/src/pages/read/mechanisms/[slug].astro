---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../content/book/mechanisms/*.mdx", { eager: true });
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = import.meta.glob("../../../content/book/mechanisms/*.mdx", { eager: true });
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing mechanism for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const metaDescription = frontmatter.definition;
const isFallback = missingSlugs.includes(frontmatter.slug);
---
<BaseLayout title={`${frontmatter.title} • Bad People`} description={metaDescription}>
  <a class="back-link" href="/read/mechanisms">← Mechanisms</a>
  <div class="eyebrow">Mechanism{isFallback ? " • fallback" : ""}</div>
  <h1 id={frontmatter.slug}>{frontmatter.title}</h1>
  <p class="lede">{frontmatter.definition}</p>
  <section class="content-block">
    <Content />
  </section>
</BaseLayout>
