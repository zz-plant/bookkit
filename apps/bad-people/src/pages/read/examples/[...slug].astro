---
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const modules = Object.entries(
    import.meta.glob("../../../content/book/examples/**/*.mdx", { eager: true })
  );

  return modules.map(([path, module]) => ({
    params: {
      slug: path.split("/examples/")[1].replace(/\\.mdx$/, ""),
    },
    props: {
      frontmatter: module.frontmatter,
      Content: module.default,
    },
  }));
}

const { frontmatter, Content } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} • Bad People`}>
  <a class="back-link" href="/read/examples">← Examples</a>
  <div class="eyebrow">Example</div>
  <h1 id={Astro.params.slug?.replaceAll("/", "-")}>{frontmatter.title}</h1>
  <p class="lede">
    {frontmatter.mechanism} • {frontmatter.domain}
  </p>
  <section class="content-block">
    <Content />
  </section>
</BaseLayout>
