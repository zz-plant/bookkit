---
import BaseLayout from "../BaseLayout.astro";
import ActionsByTrigger from "../../components/ActionsByTrigger.astro";
import RelatedBooks from "../../components/RelatedBooks.astro";
import DraftBookNote from "../../components/DraftBookNote.astro";
import ResumeReading from "../../components/ResumeReading.astro";
import {
	buildLocalizedContentIndex,
	resolveLocalizedContent,
} from "../../localization";
import { bookEntryPoints, bookConfig } from "../runtime";
import { frameFrontDoor } from "../../frames/defaults";
import {
	actionsByTrigger,
	type BookConfig,
	chapterLinksInReadingOrder,
	formatTranslationCompleteness,
	readRoutes,
	readSectionTitles,
	resolveBookHomeCopy,
} from "../../book";

// Read optional fields (author, home, relatedBooks) through BookConfig, so
// leaving them out of book.config.ts still type-checks.
const config: BookConfig = bookConfig;
const home = resolveBookHomeCopy(config.home);

const chapterIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.chapters,
	{
		defaultLocale: "en",
	},
);
const mechanismIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.mechanisms,
	{
		defaultLocale: "en",
	},
);
const toolkitIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.toolkit,
	{
		defaultLocale: "en",
	},
);
const glossaryIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.glossary,
	{
		defaultLocale: "en",
	},
);
const exampleIndex = buildLocalizedContentIndex(
	bookEntryPoints.contentModules.examples,
	{
		defaultLocale: "en",
	},
);
const localeKey = Astro.locals?.locale;
const chapters = resolveLocalizedContent(chapterIndex, { locale: localeKey });
const mechanisms = resolveLocalizedContent(mechanismIndex, {
	locale: localeKey,
});
const toolkit = resolveLocalizedContent(toolkitIndex, { locale: localeKey });
const glossary = resolveLocalizedContent(glossaryIndex, { locale: localeKey });
const examples = resolveLocalizedContent(exampleIndex, { locale: localeKey });
const metaDescription = config.site.defaultMeta?.description;
// A frame whose front door is `actions` (runbook) leads with every action
// under the situation that calls for it. With no action yet, it falls back to
// the reading front door.
const actions =
	frameFrontDoor(config.frame?.slug) === "actions"
		? actionsByTrigger(
				toolkit.entries,
				mechanisms.entries,
				(config.mechanisms ?? []).map((mechanism) => mechanism.slug),
			)
		: [];
const leadsWithActions = actions.length > 0;
// A section with nothing in it yet is not worth a link from the front door.
const stats = [
	{
		label: "Chapters",
		one: "chapter",
		href: readRoutes.chapters,
		count: chapters.entries.length,
		completeness: chapters.completeness,
	},
	{
		label: "Mechanisms",
		one: "mechanism",
		href: readRoutes.mechanisms,
		count: mechanisms.entries.length,
		completeness: mechanisms.completeness,
	},
	{
		label: "Toolkit actions",
		one: "toolkit action",
		href: readRoutes.toolkit,
		count: toolkit.entries.length,
		completeness: toolkit.completeness,
	},
	{
		label: "Glossary terms",
		one: "glossary term",
		href: readRoutes.glossary,
		count: glossary.entries.length,
		completeness: glossary.completeness,
	},
	{
		label: "Examples",
		one: "example",
		href: readRoutes.examples,
		count: examples.entries.length,
		completeness: examples.completeness,
	},
].filter((stat) => stat.count > 0);
const startLinks = [
	{
		title: readSectionTitles.overview,
		description:
			"What the book sets out to do, its approach, and its ground rules.",
		href: readRoutes.overview,
	},
	{
		title: home.mechanismsCard.title,
		description: home.mechanismsCard.description,
		href: readRoutes.mechanisms,
	},
	{
		title: "Browse everything",
		description: "Chapters, toolkit, glossary, and examples.",
		href: readRoutes.root,
	},
];
---
<BaseLayout title={bookConfig.title}>
  <div class="hero-shell">
    {home.kicker && <p class="hero-kicker">{home.kicker}</p>}
    <div class="section-header hero-shell__header">
      <h1>{bookConfig.title}</h1>
      {config.author && <p class="hero-byline">by {config.author.name}</p>}
      {metaDescription && <p class="lede">{metaDescription}</p>}
    </div>
    <ResumeReading chapters={chapterLinksInReadingOrder(chapters.entries)} />
    <DraftBookNote status={config.status} />
  </div>

  {leadsWithActions ? (
    <Fragment>
      <section class="content-block">
        <h2>What’s happening</h2>
        <ActionsByTrigger actions={actions} matcherHref={readRoutes.triage} />
      </section>
      <section class="content-block">
        <h2>Read the book</h2>
        <div class="stack" data-funnel-group="home-start">
          {startLinks.map((link, index) => (
            <a
              class="list-link"
              href={link.href}
              data-funnel-step={`home_quickstart_step_${index + 1}`}
            >
              <strong>{link.title}</strong>
              <span class="meta">{link.description}</span>
            </a>
          ))}
        </div>
      </section>
    </Fragment>
  ) : (
    <section class="content-block">
      <h2>Where to start</h2>
      <div class="card-grid" data-funnel-group="home-start">
        {startLinks.map((link, index) => (
          <a
            class="card"
            href={link.href}
            data-funnel-step={`home_quickstart_step_${index + 1}`}
          >
            <h3>{link.title}</h3>
            <p class="meta">{link.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {!leadsWithActions && stats.length > 0 && (
    <nav class="inside-line content-block" aria-label="What’s inside">
      {stats.map((stat) => (
        <a href={stat.href}>
          {stat.count} {stat.count === 1 ? stat.one : stat.label.toLowerCase()}
          {formatTranslationCompleteness(stat.completeness) &&
            ` (${formatTranslationCompleteness(stat.completeness)})`}
        </a>
      ))}
    </nav>
  )}

  <RelatedBooks books={config.relatedBooks} />
  <script>
    const isDevHost = ["localhost", "127.0.0.1"].includes(window.location.hostname);
    // Empty on a static build, which has no analytics handler.
    const analyticsEndpoint = document.body.dataset.analyticsEndpoint;
    const funnelLinks = document.querySelectorAll("[data-funnel-step]");
    funnelLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (isDevHost || !analyticsEndpoint) return;
        const step = link.getAttribute("data-funnel-step");
        if (!step) return;
        const payload = JSON.stringify({
          type: "engagement",
          title: `funnel:${step}`,
          path: window.location.pathname,
          durationSeconds: 0,
          scrollDepth: 0,
          timestamp: Date.now(),
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(analyticsEndpoint, new Blob([payload], { type: "application/json" }));
          return;
        }
        fetch(analyticsEndpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: payload,
          keepalive: true,
        }).catch(() => undefined);
      });
    });
  </script>
</BaseLayout>
