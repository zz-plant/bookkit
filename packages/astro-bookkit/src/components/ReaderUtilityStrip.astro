---
export type ReaderUtilityLink = {
  href: string;
  label: string;
};

const {
  label = "Utility links",
  links = [],
} = Astro.props;

const resolvedLinks = Array.isArray(links)
  ? links.filter((entry) => entry?.href && entry?.label)
  : [];
---
{resolvedLinks.length > 0 && (
  <nav class="reader-utility-strip" aria-label={label}>
    {resolvedLinks.map((entry) => (
      <a class="pill" href={entry.href}>{entry.label}</a>
    ))}
  </nav>
)}
