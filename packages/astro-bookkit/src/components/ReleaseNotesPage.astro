---
import BookLayout from "../layouts/BookLayout.astro";
import { formatReleaseDate, type ReleaseNote } from "../releases/notes";
import type { BookVersionEntry } from "../releases/versions";

export type Props = {
  title: string;
  bookTitle: string;
  bookVersion: string;
  bookKey?: string;
  versions?: BookVersionEntry[];
  versionPrefix?: string;
  versionArchivePath?: string;
  rssUrl: string;
  releases: ReleaseNote[];
  description?: string;
  subscribeLabel?: string;
  subscribeAnalyticsUrl?: string | null;
  siteUrl?: string;
  metaDescription?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterCard?: "summary" | "summary_large_image" | "app" | "player";
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonicalPath?: string;
  canonicalUrl?: string;
  robots?: string;
};

const {
  title,
  bookTitle,
  bookVersion,
  bookKey = "book",
  versions = [],
  versionPrefix = "v",
  versionArchivePath = "/versions",
  rssUrl,
  releases,
  description = "Track new releases, subscribe to updates, and review the latest changes.",
  subscribeLabel = "Subscribe via RSS",
  subscribeAnalyticsUrl = "/api/release-analytics.json",
  siteUrl,
  metaDescription,
  ogImage,
  ogTitle,
  ogDescription,
  ogType,
  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  structuredData,
  canonicalPath,
  canonicalUrl,
  robots,
} = Astro.props;
---
<BookLayout
  title={title}
  bookTitle={bookTitle}
  bookVersion={bookVersion}
  bookKey={bookKey}
  versions={versions}
  versionPrefix={versionPrefix}
  versionArchivePath={versionArchivePath}
  siteUrl={siteUrl}
  metaDescription={metaDescription}
  ogImage={ogImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  twitterCard={twitterCard}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  structuredData={structuredData}
  canonicalPath={canonicalPath}
  canonicalUrl={canonicalUrl}
  robots={robots}
>
  <div class="section-header release-header">
    <div>
      <h1>Release notes</h1>
      <p class="lede">{description}</p>
    </div>
    <div class="release-actions">
      <a
        class="button"
        href={rssUrl}
        data-release-subscribe
        aria-label={subscribeLabel}
      >
        {subscribeLabel}
      </a>
    </div>
  </div>
  <div class="release-list">
    {releases.map((release) => {
      const Content = release.Content;
      return (
        <article class="release-card" id={`release-${release.version}`}>
          <header class="release-header">
            <div class="release-meta">
              <p class="eyebrow">Version {release.version}</p>
              <h2>{release.title}</h2>
            </div>
            <time class="release-date" datetime={release.date}>
              {formatReleaseDate(release.date)}
            </time>
          </header>
          <p class="release-summary">{release.summary}</p>
          {release.highlights.length > 0 && (
            <ul class="release-highlights">
              {release.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {Content && (
            <details class="release-details">
              <summary>Read details</summary>
              <section class="content-block">
                <Content />
              </section>
            </details>
          )}
        </article>
      );
    })}
  </div>
  {subscribeAnalyticsUrl && (
    <script define:vars={{ subscribeAnalyticsUrl }}>
      const subscribeButton = document.querySelector("[data-release-subscribe]");
      subscribeButton?.addEventListener("click", () => {
        const payload = JSON.stringify({ event: "rss_subscribe_click" });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(subscribeAnalyticsUrl, payload);
        } else {
          fetch(subscribeAnalyticsUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: payload,
          });
        }
      });
    </script>
  )}
</BookLayout>
