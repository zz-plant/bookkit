---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
} from "@bookkit/astro-bookkit/localization";

const modules = import.meta.glob("../../../content/book/mechanisms/*.mdx", { eager: true });
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { entries, completeness } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const mechanisms = entries
  .map(({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    return {
      slug,
      title: frontmatter.title ?? "Untitled mechanism",
      definition: frontmatter.definition ?? "",
      isFallback,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));
const mechanismItems = mechanisms.map((mechanism) => ({
  href: `/read/mechanisms/${mechanism.slug}`,
  title: mechanism.title,
  meta: mechanism.isFallback ? `${mechanism.definition} (fallback)` : mechanism.definition,
}));
const localizedLede =
  typeof completeness === "number"
    ? `Translation completeness: ${Math.round(completeness * 100)}%.`
    : null;
---
<BaseLayout title="Mechanisms • Bad People">
  <ContentIndexList
    title="Mechanisms"
    lede={
      localizedLede
        ? `Stable patterns that explain how harm stays normalized. ${localizedLede}`
        : "Stable patterns that explain how harm stays normalized."
    }
    items={mechanismItems}
    filterMode="always"
    filterPlaceholder="Filter by mechanism name or definition..."
    filterHint="Search by name, definition, or domain signal."
    alphaMode="always"
  />
</BaseLayout>
