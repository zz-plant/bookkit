---
import BookLayout from "@bookkit/astro-bookkit/layouts/BookLayout.astro";
import { createBookLayoutState } from "@bookkit/astro-bookkit";
import bookConfig from "../book.config";
import { bookEntryPoints } from "../lib/book-entrypoints";
import { getVersionEntries } from "../lib/versions";
import { getOgImageForPath } from "../lib/og";

const versionEntries = getVersionEntries();
const pathname = Astro.url.pathname;
const resolvedOgImage = Astro.props.ogImage ?? getOgImageForPath(pathname);
const layoutState = createBookLayoutState({
	astro: {
		props: {
			...Astro.props,
			ogImage: resolvedOgImage,
		},
		locals: Astro.locals,
		url: Astro.url,
	},
	bookConfig,
	versionEntries,
	localizedContentModules: bookEntryPoints.localizedContentModules,
	versionPrefix: "v",
});
const {
	seoProps,
	hasServerRuntime,
	resolvedVersion,
	bookTitle,
	bookKey,
	aiQaEnabled,
	aiQaProvider,
	aiQaProviders,
	renderState,
} = layoutState;
---
<BookLayout
  bookTitle={bookTitle}
  bookVersion={resolvedVersion}
  bookKey={bookKey}
  hasServerRuntime={hasServerRuntime}
  aiQaEnabled={aiQaEnabled}
  aiQaProvider={aiQaProvider}
  aiQaProviders={aiQaProviders}
  renderState={renderState}
  bookDescription={bookConfig.site?.defaultMeta?.description}
  {...seoProps}
>
  <slot />
</BookLayout>
