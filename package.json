{
  "name": "bookkit-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Use bun run dev:<book>\" && exit 1",
    "dev:bad-people": "bun run --filter @books/bad-people dev",
    "build:bad-people": "bun run --filter @books/bad-people build",
    "build:all": "bun run --workspaces build",
    "lint": "bun run scripts/lint.ts",
    "format": "bun run scripts/format.ts",
    "list:books": "bun run scripts/list-books.ts",
    "validate": "bun run scripts/validate-all.ts",
    "validate:release": "bun run scripts/validate-all.ts --mode error --no-drafts",
    "new:example": "bun run scripts/scaffold-example.ts",
    "new:mechanism": "bun run scripts/scaffold-mechanism.ts",
    "new:tool": "bun run scripts/scaffold-tool.ts",
    "check:concepts": "bun run scripts/check-floating-concepts.ts",
    "audit:unused": "bun run scripts/audit-unused.ts",
    "fix:frontmatter": "bun run scripts/fix-frontmatter.ts",
    "export:gitbook": "bun run scripts/export-gitbook.ts"
  }
}
