---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { getBookExportLinks, getChapterExportLinks } from "../lib/exports";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../lib/book-entrypoints";
import { readItemPath } from "@bookkit/astro-bookkit";
import bookConfig from "../book.config";

const modules = bookEntryPoints.contentModules.chapters;
const { items: chapterItems } = createLocalizedContentList(modules, {
	defaultLocale: "en",
	locale: Astro.locals?.locale,
	mapEntry: ({ slug, module }) => ({
		slug,
		href: readItemPath("chapters", slug),
		title: module.frontmatter?.title ?? "Untitled chapter",
	}),
});

const bookExportLinks = getBookExportLinks();
const allChapterExportLinks = chapterItems.flatMap((chapter) =>
	getChapterExportLinks(chapter.slug, chapter.title),
);
// A book can turn the PDF off (exports.pdf in book.config.ts).
const hasPdf = bookExportLinks.some((link) => link.format === "pdf");
---
<BaseLayout title={`Downloads • ${bookConfig.title}`}>
  <div class="section-header">
    <h1>Downloads</h1>
    <p class="lede">{hasPdf
      ? "The whole book or single chapters. PDF is best for printing and annotating; EPUB reflows to fit phones and e-readers."
      : "The whole book or single chapters, as EPUB, which reflows to fit phones and e-readers."}</p>
  </div>

  <ExportPanel title="Whole book" links={bookExportLinks} />

  <ExportPanel title="Single chapters" links={allChapterExportLinks} />
</BaseLayout>
