---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath, readRoutes } from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.mechanisms;
const coreMechanismSlugs = new Set(bookConfig.mechanisms.map((mechanism) => mechanism.slug));
const urgencyBySlug: Record<string, string> = {};
const urgencyOrder: Record<string, number> = {
  urgent: 0,
  "high-leverage": 1,
  stabilize: 2,
};
const summarizeMeta = (value: string) => {
  const firstSentence = value.split(/(?<=[.!?])\s+/)[0] ?? value;
  if (firstSentence.length <= 110) return firstSentence;
  return `${firstSentence.slice(0, 107).replace(/\s+\S*$/, "")}…`;
};
const { items: mechanismItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const urgency = urgencyBySlug[slug] ?? null;
    const tags = [
      urgency,
      coreMechanismSlugs.has(slug) ? "core" : null,
      isFallback ? "fallback" : null,
    ].filter(Boolean);
    const definition = typeof frontmatter.definition === "string" ? frontmatter.definition : "";
    return {
      href: readItemPath("mechanisms", slug),
      title: frontmatter.title ?? "Untitled mechanism",
      eyebrow: tags.join(" • "),
      meta: summarizeMeta(definition),
    };
  },
  sort: (a, b) => {
    const urgencyA = urgencyOrder[a.eyebrow?.split(" • ")[0] ?? "stabilize"] ?? 99;
    const urgencyB = urgencyOrder[b.eyebrow?.split(" • ")[0] ?? "stabilize"] ?? 99;
    if (urgencyA !== urgencyB) return urgencyA - urgencyB;
    return a.title.localeCompare(b.title);
  },
});
// A tag that every mechanism carries doesn't help anyone choose between them,
// so it is neither shown on the list nor offered as a filter.
const tagCounts = new Map<string, number>();
for (const item of mechanismItems) {
  for (const tag of item.eyebrow?.split(" • ") ?? []) {
    if (tag) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const isDistinguishingTag = (tag: string) => {
  const count = tagCounts.get(tag) ?? 0;
  return count > 0 && count < mechanismItems.length;
};
const listedMechanisms = mechanismItems.map((item) => ({
  ...item,
  eyebrow: item.eyebrow?.split(" • ").filter(isDistinguishingTag).join(" • ") || null,
}));
const quickFilters = [
  { value: "urgent", label: "Urgent" },
  { value: "high-leverage", label: "High leverage" },
  { value: "core", label: "Core" },
].filter((filter) => isDistinguishingTag(filter.value));
const localizedLede = buildTranslationLede(
  "Patterns that push the cost of system failures onto people.",
  completeness
);
---
<BaseLayout title={`Mechanisms • ${bookConfig.title}`}>
  <ContentIndexList
    title="Mechanisms"
    lede={localizedLede}
    items={listedMechanisms}
    filterMode={quickFilters.length > 0 ? "always" : "auto"}
    filterPlaceholder="Filter by name or definition"
    alphaMode={false}
  >
    {quickFilters.length > 0 && (
      <Fragment slot="after-header">
        <div class="mechanism-quick-filters" role="group" aria-label="Filter by tag" data-toggle-group="mechanism-filters">
          <span class="mechanism-quick-filters__label">Show</span>
          {quickFilters.map((filter) => (
            <button type="button" class="mechanism-filter-pill" data-filter-value={filter.value} aria-pressed="false">{filter.label}</button>
          ))}
          <button type="button" class="mechanism-filter-pill mechanism-filter-pill--clear" data-filter-clear>All</button>
        </div>
      </Fragment>
    )}
    <Fragment slot="after-list">
      <section class="content-block mechanisms-tail">
        <div>
          <h2>Then pick an action</h2>
          <p class="meta">Each mechanism links to toolkit actions that take ten minutes or less.</p>
        </div>
        <div class="link-group">
          <a class="button" href={readRoutes.toolkit}>Toolkit</a>
        </div>
      </section>
    </Fragment>
  </ContentIndexList>

  <script>
    const mechanismMeta = Array.from(document.querySelectorAll(".list-link .meta"));
    mechanismMeta.forEach((meta, index) => {
      if (!(meta instanceof HTMLElement)) return;
      const isMobile = window.matchMedia("(max-width: 720px)").matches;
      if (!isMobile) return;
      if ((meta.textContent || "").trim().length < 120) return;
      meta.classList.add("mechanism-meta");
      meta.id = `mechanism-meta-${index}`;

      const toggle = document.createElement("button");
      toggle.type = "button";
      toggle.className = "mechanism-meta__toggle";
      toggle.textContent = "Show more";
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-controls", meta.id);

      toggle.addEventListener("click", () => {
        const expanded = meta.classList.toggle("is-expanded");
        toggle.textContent = expanded ? "Show less" : "Show more";
        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      });

      const listLink = meta.closest(".list-link");
      if (listLink instanceof HTMLElement) {
        listLink.insertAdjacentElement("afterend", toggle);
      }
    });

    const listFilterInput = document.querySelector("[data-list-filter]");
    const quickFilterButtons = Array.from(document.querySelectorAll("[data-filter-value]"));
    const clearButton = document.querySelector("[data-filter-clear]");

    const applyQuickFilter = (value) => {
      if (!(listFilterInput instanceof HTMLInputElement)) return;
      listFilterInput.value = value;
      listFilterInput.dispatchEvent(new Event("input", { bubbles: true }));
      quickFilterButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.classList.toggle("is-active", button.dataset.filterValue === value);
        button.setAttribute("aria-pressed", button.dataset.filterValue === value ? "true" : "false");
      });
    };

    quickFilterButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener("click", () => {
        const value = button.dataset.filterValue;
        if (!value) return;
        applyQuickFilter(value);
      });
    });

    if (clearButton instanceof HTMLButtonElement) {
      clearButton.addEventListener("click", () => {
        if (!(listFilterInput instanceof HTMLInputElement)) return;
        listFilterInput.value = "";
        listFilterInput.dispatchEvent(new Event("input", { bubbles: true }));
        quickFilterButtons.forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.classList.remove("is-active");
          button.setAttribute("aria-pressed", "false");
        });
      });
    }
  </script>

</BaseLayout>

<style>

  .mechanism-quick-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }

  .mechanism-quick-filters__label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    font-weight: 700;
  }

  .mechanism-filter-pill {
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-accent-strong);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.3rem 0.65rem;
    cursor: pointer;
  }

  .mechanism-filter-pill:hover,
  .mechanism-filter-pill.is-active {
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--color-accent) 42%, transparent);
  }

  .mechanism-filter-pill--clear {
    border-color: rgba(31, 31, 31, 0.2);
    color: var(--color-muted);
  }

  .mechanisms-tail {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .mechanisms-tail h2 {
    margin-bottom: 0.35rem;
  }

  .mechanisms-tail .link-group {
    align-items: center;
  }

  @media (max-width: 720px) {
    .mechanism-meta {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0;
    }

    .mechanism-meta.is-expanded {
      display: block;
      -webkit-line-clamp: unset;
      overflow: visible;
    }

    .mechanism-meta__toggle {
      margin-top: 0.2rem;
      border: none;
      background: none;
      padding: 0;
      color: var(--color-accent-strong);
      font-size: var(--text-xs);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 0.2em;
      justify-self: start;
    }
  }
</style>
