---
const {
  lastUpdated = new Date().toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }),
  endpoint,
} = Astro.props as {
  lastUpdated?: string;
  endpoint?: string;
};
---
<section
  class="content-block analytics-section"
  data-analytics-dashboard
  data-analytics-endpoint={endpoint}
>
  <div class="analytics-filters" data-analytics-filters>
    <label class="analytics-filter">
      <span>Version</span>
      <select data-filter-version aria-label="Filter by version"></select>
    </label>
    <label class="analytics-filter">
      <span>From</span>
      <input type="date" data-filter-start aria-label="Filter start date" />
    </label>
    <label class="analytics-filter">
      <span>To</span>
      <input type="date" data-filter-end aria-label="Filter end date" />
    </label>
  </div>

  <article class="analytics-card analytics-summary">
    <table class="analytics-table analytics-table--summary">
      <caption class="analytics-table__caption">Topline metrics compared against the immediately prior period.</caption>
      <thead>
        <tr>
          <th scope="col">Metric</th>
          <th scope="col" class="analytics-table__metric">Current</th>
          <th scope="col" class="analytics-table__metric">Δ vs prior</th>
          <th scope="col" class="analytics-table__spark-col">Trend</th>
          <th scope="col">Note</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" class="analytics-table__label">Views</th>
          <td class="analytics-table__metric" data-metric-current="views">0</td>
          <td class="analytics-table__metric" data-metric-delta="views">—</td>
          <td class="analytics-table__spark-col">
            <svg class="sparkline" viewBox="0 0 100 32" role="img" aria-label="Views trend">
              <line class="sparkline-axis" x1="0" y1="16" x2="100" y2="16"></line>
              <polyline data-sparkline="views" points="0,16 100,16" />
            </svg>
          </td>
          <td class="metric-subtext" data-metric-note="views"></td>
        </tr>
        <tr>
          <th scope="row" class="analytics-table__label">Avg. time on page</th>
          <td class="analytics-table__metric" data-metric-current="time">0.0s</td>
          <td class="analytics-table__metric" data-metric-delta="time">—</td>
          <td class="analytics-table__spark-col">
            <svg class="sparkline" viewBox="0 0 100 32" role="img" aria-label="Time on page trend">
              <line class="sparkline-axis" x1="0" y1="16" x2="100" y2="16"></line>
              <polyline data-sparkline="time" points="0,16 100,16" />
            </svg>
          </td>
          <td class="metric-subtext" data-metric-note="time"></td>
        </tr>
        <tr>
          <th scope="row" class="analytics-table__label">Drop-off</th>
          <td class="analytics-table__metric" data-metric-current="dropoff">0.0%</td>
          <td class="analytics-table__metric" data-metric-delta="dropoff">—</td>
          <td class="analytics-table__spark-col">
            <svg class="sparkline" viewBox="0 0 100 32" role="img" aria-label="Drop-off trend">
              <line class="sparkline-axis" x1="0" y1="16" x2="100" y2="16"></line>
              <polyline data-sparkline="dropoff" points="0,16 100,16" />
            </svg>
          </td>
          <td class="metric-subtext" data-metric-note="dropoff"></td>
        </tr>
      </tbody>
    </table>
  </article>

  <div class="analytics-empty" data-analytics-empty hidden>
    <p>
      No analytics events yet. Visit a few chapters and return here to see engagement metrics.
    </p>
  </div>

  <div class="analytics-table-wrap" data-analytics-table>
    <h2>Chapter engagement</h2>
    <table class="analytics-table">
      <caption class="analytics-table__caption">Sorted by views. Values are aggregated for the selected date range.</caption>
      <thead>
        <tr>
          <th scope="col">Chapter</th>
          <th scope="col">Views</th>
          <th scope="col">Avg. time</th>
          <th scope="col">Avg. scroll</th>
          <th scope="col">Drop-off</th>
        </tr>
      </thead>
      <tbody data-analytics-rows></tbody>
    </table>
  </div>

  <div class="analytics-table-wrap" data-analytics-versions hidden>
    <h2>Version comparison</h2>
    <table class="analytics-table">
      <caption class="analytics-table__caption">Sorted by views. Compare versions without changing frame or chapter structure.</caption>
      <thead>
        <tr>
          <th scope="col">Version</th>
          <th scope="col">Views</th>
          <th scope="col">Avg. time</th>
          <th scope="col">Avg. scroll</th>
          <th scope="col">Drop-off</th>
        </tr>
      </thead>
      <tbody data-analytics-version-rows></tbody>
    </table>
  </div>

  <div class="analytics-table-wrap" data-analytics-locales hidden>
    <h2>Locale usage</h2>
    <table class="analytics-table">
      <caption class="analytics-table__caption">Locale share based on page views in the selected range.</caption>
      <thead>
        <tr>
          <th scope="col">Locale</th>
          <th scope="col">Views</th>
          <th scope="col">Share</th>
        </tr>
      </thead>
      <tbody data-analytics-locale-rows></tbody>
    </table>
  </div>

  <div class="analytics-notes">
    <h2>Privacy &amp; retention</h2>
    <ul>
      <li>Events store anonymized session IDs with no personal identifiers.</li>
      <li>Only page views, time-on-page, and scroll depth are captured.</li>
      <li>Language switch events are recorded to track locale preferences.</li>
      <li>Events expire after 90 days to minimize retention.</li>
      <li>Drop-off is estimated using average scroll depth, not user identity.</li>
    </ul>
    <p class="meta">Last updated: {lastUpdated}</p>
  </div>
</section>

<script>
  document.querySelectorAll("[data-analytics-dashboard]").forEach((dashboard) => {
    const analyticsKeyPrefix = document.body?.dataset?.analyticsKey || "book";
    const storageKey = `${analyticsKeyPrefix}.analytics.events`;
    const retentionDays = 90;

    const parseEvents = () => {
      try {
        const stored = localStorage.getItem(storageKey);
        const parsed = stored ? JSON.parse(stored) : [];
        const cutoff = Date.now() - retentionDays * 24 * 60 * 60 * 1000;
        return Array.isArray(parsed)
          ? parsed.filter((event) => typeof event?.timestamp === "number" && event.timestamp >= cutoff)
          : [];
      } catch (error) {
        return [];
      }
    };

    const formatSeconds = (value) => {
      if (!value || Number.isNaN(value)) return "0s";
      if (value < 60) return `${Math.round(value)}s`;
      const minutes = Math.floor(value / 60);
      const seconds = Math.round(value % 60);
      return `${minutes}m ${seconds}s`;
    };

    const metricConfigs = {
      views: { decimals: 0, unit: "", minPctForNote: 0.15, minAbsForNote: 20 },
      time: { decimals: 1, unit: "s", minPctForNote: 0.1, minAbsForNote: 5 },
      dropoff: { decimals: 1, unit: "%", scale: 100, minPctForNote: 0.08, minAbsForNote: 2.5 },
    };

    const formatMetricValue = (metric, value) => {
      const config = metricConfigs[metric];
      if (!config) return `${value}`;
      const normalized = (config.scale ?? 1) * (Number.isFinite(value) ? value : 0);
      return `${normalized.toFixed(config.decimals)}${config.unit}`;
    };

    const formatMetricDelta = (metric, current, prior) => {
      const config = metricConfigs[metric];
      const safeCurrent = Number.isFinite(current) ? current : 0;
      const safePrior = Number.isFinite(prior) ? prior : 0;
      const absoluteDelta = safeCurrent - safePrior;
      const pctDelta = safePrior === 0 ? (safeCurrent === 0 ? 0 : 1) : absoluteDelta / safePrior;
      const normalizedAbs = absoluteDelta * (config?.scale ?? 1);
      const sign = absoluteDelta > 0 ? "+" : "";
      return {
        absoluteDelta,
        pctDelta,
        text: `${sign}${normalizedAbs.toFixed(config?.decimals ?? 1)}${config?.unit ?? ""} (${sign}${(
          pctDelta * 100
        ).toFixed(1)}%)`,
      };
    };

    const isStatisticallyNotable = (metric, delta) => {
      const config = metricConfigs[metric];
      if (!config) return false;
      const scaledAbs = Math.abs(delta.absoluteDelta * (config.scale ?? 1));
      return Math.abs(delta.pctDelta) >= config.minPctForNote && scaledAbs >= config.minAbsForNote;
    };

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

    const formatPercent = (value) => `${Math.round(value * 100)}%`;

    const uniqueValues = (items) => Array.from(new Set(items));

    const byDayKey = (timestamp) => new Date(timestamp).toISOString().slice(0, 10);

    const buildSeries = (events, key) => {
      const map = new Map();
      events.forEach((event) => {
        const day = byDayKey(event.timestamp);
        map.set(day, (map.get(day) ?? 0) + (event[key] ?? 1));
      });
      const sortedDays = Array.from(map.keys()).sort();
      return sortedDays.map((day) => map.get(day));
    };

    const renderSparkline = (polyline, values) => {
      if (!polyline) return;
      if (!values.length) {
        polyline.setAttribute("points", "0,16 100,16");
        return;
      }
      const max = Math.max(...values);
      const min = Math.min(...values);
      const range = max - min || 1;
      const step = 100 / Math.max(values.length - 1, 1);
      const points = values
        .map((value, index) => {
          const x = index * step;
          const normalized = (value - min) / range;
          const y = 32 - normalized * 28 - 2;
          return `${x},${y}`;
        })
        .join(" ");
      polyline.setAttribute("points", points);
    };

    const toDateInput = (date) => date.toISOString().slice(0, 10);

    const getRangeDefaults = () => {
      const end = new Date();
      const start = new Date();
      start.setDate(end.getDate() - 30);
      return { start, end };
    };

    let events = [];
    let versions = [];
    const endpointUrl = dashboard.dataset.analyticsEndpoint;
    const versionSelect = dashboard.querySelector("[data-filter-version]");
    const startInput = dashboard.querySelector("[data-filter-start]");
    const endInput = dashboard.querySelector("[data-filter-end]");
    const emptyState = dashboard.querySelector("[data-analytics-empty]");
    const tableWrap = dashboard.querySelector("[data-analytics-table]");
    const versionTableWrap = dashboard.querySelector("[data-analytics-versions]");
    const rowsTarget = dashboard.querySelector("[data-analytics-rows]");
    const versionRowsTarget = dashboard.querySelector("[data-analytics-version-rows]");
    const localeTableWrap = dashboard.querySelector("[data-analytics-locales]");
    const localeRowsTarget = dashboard.querySelector("[data-analytics-locale-rows]");

    if (
      !versionSelect ||
      !startInput ||
      !endInput ||
      !emptyState ||
      !tableWrap ||
      !rowsTarget ||
      !versionTableWrap ||
      !versionRowsTarget ||
      !localeTableWrap ||
      !localeRowsTarget
    ) {
      return;
    }

    const { start, end } = getRangeDefaults();
    startInput.value = toDateInput(start);
    endInput.value = toDateInput(end);

    const fillVersions = () => {
      const options = ["all", ...versions];
      versionSelect.innerHTML = "";
      options.forEach((version) => {
        const option = document.createElement("option");
        option.value = version;
        option.textContent = version === "all" ? "All versions" : version;
        versionSelect.appendChild(option);
      });
    };

    const summarize = (filteredEvents) => {
      const pageviews = filteredEvents.filter((event) => event.type === "pageview");
      const engagements = filteredEvents.filter((event) => event.type === "engagement");

      const totalViews = pageviews.length;
      const totalTime = engagements.reduce((sum, event) => sum + (event.durationSeconds ?? 0), 0);
      const avgTime = engagements.length ? totalTime / engagements.length : 0;
      const avgScroll = engagements.length
        ? engagements.reduce((sum, event) => sum + (event.scrollDepth ?? 0), 0) / engagements.length
        : 0;

      return { totalViews, avgTime, avgScroll, pageviews, engagements };
    };

    const setText = (selector, value) => {
      const target = dashboard.querySelector(selector);
      if (target) target.textContent = value;
    };

    const renderSummary = ({ current, prior }) => {
      const metrics = {
        views: { current: current.totalViews, prior: prior.totalViews },
        time: { current: current.avgTime, prior: prior.avgTime },
        dropoff: { current: clamp(1 - current.avgScroll, 0, 1), prior: clamp(1 - prior.avgScroll, 0, 1) },
      };

      const deltas = Object.entries(metrics).map(([metric, values]) => ({
        metric,
        ...formatMetricDelta(metric, values.current, values.prior),
      }));

      const emphasisMetric = deltas
        .slice()
        .sort((a, b) => Math.abs(b.pctDelta) - Math.abs(a.pctDelta))[0]?.metric;

      Object.entries(metrics).forEach(([metric, values]) => {
        setText(`[data-metric-current='${metric}']`, formatMetricValue(metric, values.current));
        const delta = formatMetricDelta(metric, values.current, values.prior);
        setText(`[data-metric-delta='${metric}']`, delta.text);

        const deltaCell = dashboard.querySelector(`[data-metric-delta='${metric}']`);
        if (deltaCell) {
          deltaCell.classList.toggle("is-emphasis", metric === emphasisMetric && Math.abs(delta.pctDelta) > 0);
        }

        const note = dashboard.querySelector(`[data-metric-note='${metric}']`);
        if (note) {
          note.textContent = isStatisticallyNotable(metric, delta)
            ? delta.absoluteDelta > 0
              ? "Notable increase vs prior period"
              : "Notable decrease vs prior period"
            : "";
        }
      });

      const viewSeries = buildSeries(current.pageviews, "count");
      const timeSeries = buildSeries(
        current.engagements.map((event) => ({ ...event, count: event.durationSeconds ?? 0 })),
        "count"
      );
      const dropSeries = buildSeries(
        current.engagements.map((event) => ({ ...event, count: 1 - (event.scrollDepth ?? 0) })),
        "count"
      );

      renderSparkline(dashboard.querySelector("[data-sparkline='views']"), viewSeries);
      renderSparkline(dashboard.querySelector("[data-sparkline='time']"), timeSeries);
      renderSparkline(dashboard.querySelector("[data-sparkline='dropoff']"), dropSeries);

    };

    const getPeriods = () => {
      const startDate = new Date(startInput.value);
      const endDate = new Date(endInput.value);
      endDate.setHours(23, 59, 59, 999);
      const rangeDuration = Math.max(endDate.getTime() - startDate.getTime() + 1, 24 * 60 * 60 * 1000);

      const priorEnd = new Date(startDate.getTime() - 1);
      const priorStart = new Date(priorEnd.getTime() - rangeDuration + 1);

      return { startDate, endDate, priorStart, priorEnd };
    };

    const filterEventsForRange = (sourceEvents, startDate, endDate, selectedVersion) => {
      return sourceEvents.filter((event) => {
        const timestamp = event.timestamp;
        const inRange = timestamp >= startDate.getTime() && timestamp <= endDate.getTime();
        const inVersion = selectedVersion === "all" || event.version === selectedVersion;
        return inRange && inVersion;
      });
    };

    const renderTable = (pageviews, engagements) => {
      const chapterMap = new Map();

      pageviews.forEach((event) => {
        const key = event.chapterSlug ?? "unknown";
        const entry = chapterMap.get(key) ?? {
          chapter: key,
          views: 0,
          time: 0,
          engagements: 0,
          scroll: 0,
        };
        entry.views += 1;
        chapterMap.set(key, entry);
      });

      engagements.forEach((event) => {
        const key = event.chapterSlug ?? "unknown";
        const entry = chapterMap.get(key) ?? {
          chapter: key,
          views: 0,
          time: 0,
          engagements: 0,
          scroll: 0,
        };
        entry.time += event.durationSeconds ?? 0;
        entry.engagements += 1;
        entry.scroll += event.scrollDepth ?? 0;
        chapterMap.set(key, entry);
      });

      const rows = Array.from(chapterMap.values())
        .filter((row) => row.chapter !== "unknown")
        .sort((a, b) => b.views - a.views);

      rowsTarget.innerHTML = "";
      rows.forEach((row) => {
        const avgTime = row.engagements ? row.time / row.engagements : 0;
        const avgScroll = row.engagements ? row.scroll / row.engagements : 0;
        const dropOff = clamp(1 - avgScroll, 0, 1);

        const tr = document.createElement("tr");
        tr.innerHTML = `
          <th scope="row" class="analytics-table__label">${row.chapter.replace(/-/g, " ")}</th>
          <td class="analytics-table__metric">${row.views}</td>
          <td class="analytics-table__metric">${formatSeconds(avgTime)}</td>
          <td class="analytics-table__metric">${formatPercent(avgScroll)}</td>
          <td class="analytics-table__metric">${formatPercent(dropOff)}</td>
        `;
        rowsTarget.appendChild(tr);
      });
    };

    const renderVersionTable = (versionEvents) => {
      if (!versions.length || versions.length === 1) {
        versionTableWrap.hidden = true;
        return;
      }

      const versionMap = new Map();

      versionEvents.forEach((event) => {
        const version = event.version || "draft";
        const entry = versionMap.get(version) ?? {
          version,
          views: 0,
          time: 0,
          engagements: 0,
          scroll: 0,
        };
        if (event.type === "pageview") entry.views += 1;
        if (event.type === "engagement") {
          entry.time += event.durationSeconds ?? 0;
          entry.engagements += 1;
          entry.scroll += event.scrollDepth ?? 0;
        }
        versionMap.set(version, entry);
      });

      const rows = Array.from(versionMap.values()).sort((a, b) => b.views - a.views);
      versionRowsTarget.innerHTML = "";

      rows.forEach((row) => {
        const avgTime = row.engagements ? row.time / row.engagements : 0;
        const avgScroll = row.engagements ? row.scroll / row.engagements : 0;
        const dropOff = clamp(1 - avgScroll, 0, 1);
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <th scope="row" class="analytics-table__label">${row.version}</th>
          <td class="analytics-table__metric">${row.views}</td>
          <td class="analytics-table__metric">${formatSeconds(avgTime)}</td>
          <td class="analytics-table__metric">${formatPercent(avgScroll)}</td>
          <td class="analytics-table__metric">${formatPercent(dropOff)}</td>
        `;
        versionRowsTarget.appendChild(tr);
      });

      versionTableWrap.hidden = rows.length === 0;
    };

    const renderLocaleTable = (pageviewEvents) => {
      const localeMap = new Map();

      pageviewEvents.forEach((event) => {
        const locale = event.locale || "unknown";
        const entry = localeMap.get(locale) ?? { locale, views: 0 };
        entry.views += 1;
        localeMap.set(locale, entry);
      });

      const rows = Array.from(localeMap.values())
        .filter((row) => row.locale !== "unknown")
        .sort((a, b) => b.views - a.views);

      localeRowsTarget.innerHTML = "";

      if (!rows.length) {
        localeTableWrap.hidden = true;
        return;
      }

      const totalViews = rows.reduce((sum, row) => sum + row.views, 0);
      rows.forEach((row) => {
        const share = totalViews ? row.views / totalViews : 0;
        const tr = document.createElement("tr");
        tr.innerHTML = `
          <th scope="row" class="analytics-table__label">${row.locale}</th>
          <td class="analytics-table__metric">${row.views}</td>
          <td class="analytics-table__metric">${formatPercent(share)}</td>
        `;
        localeRowsTarget.appendChild(tr);
      });

      localeTableWrap.hidden = false;
    };

    const filterEvents = () => {
      const selectedVersion = versionSelect.value;
      const { startDate, endDate, priorStart, priorEnd } = getPeriods();
      const inRangeEvents = events.filter((event) => event.timestamp >= startDate.getTime() && event.timestamp <= endDate.getTime());
      const filtered = filterEventsForRange(events, startDate, endDate, selectedVersion);
      const priorFiltered = filterEventsForRange(events, priorStart, priorEnd, selectedVersion);

      if (!filtered.length) {
        emptyState.hidden = false;
        tableWrap.hidden = true;
        versionTableWrap.hidden = true;
        localeTableWrap.hidden = true;
      } else {
        emptyState.hidden = true;
        tableWrap.hidden = false;
      }

      const summary = summarize(filtered);
      const priorSummary = summarize(priorFiltered);
      renderSummary({ current: summary, prior: priorSummary });
      renderTable(summary.pageviews, summary.engagements);
      renderLocaleTable(summary.pageviews);

      if (selectedVersion === "all") {
        renderVersionTable(inRangeEvents);
      } else {
        versionTableWrap.hidden = true;
      }
    };

    const loadEvents = async () => {
      if (!endpointUrl) {
        events = parseEvents();
        return;
      }
      try {
        const response = await fetch(endpointUrl);
        const payload = await response.json();
        if (Array.isArray(payload?.events)) {
          events = payload.events;
          return;
        }
      } catch (error) {
        // Ignore and fall back to local events.
      }
      events = parseEvents();
    };

    const initialize = async () => {
      await loadEvents();
      versions = uniqueValues(events.map((event) => event.version).filter(Boolean));
      fillVersions();

      if (events.length) {
        filterEvents();
      } else {
        emptyState.hidden = false;
        tableWrap.hidden = true;
      }

      versionSelect.addEventListener("change", filterEvents);
      startInput.addEventListener("change", filterEvents);
      endInput.addEventListener("change", filterEvents);
    };

    initialize();
  });
</script>
