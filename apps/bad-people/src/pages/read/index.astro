---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../lib/book-entrypoints";
import { formatTranslationCompleteness, readItemPath, readRoutes } from "@bookkit/astro-bookkit";
import { getReleaseNotes } from "../../lib/release-notes";
import { getVersionEntries } from "../../lib/versions";
import bookConfig from "../../book.config";

const chapterIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.chapters,
  {
    defaultLocale: "en",
  }
);
const mechanismIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.mechanisms,
  {
    defaultLocale: "en",
  }
);
const toolkitIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.toolkit,
  {
    defaultLocale: "en",
  }
);
const glossaryIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.glossary,
  {
    defaultLocale: "en",
  }
);
const exampleIndex = buildLocalizedContentIndex(
  bookEntryPoints.contentModules.examples,
  {
    defaultLocale: "en",
  }
);
const localeKey = Astro.locals?.locale;
const chapters = resolveLocalizedContent(chapterIndex, { locale: localeKey });
const mechanisms = resolveLocalizedContent(mechanismIndex, { locale: localeKey });
const toolkit = resolveLocalizedContent(toolkitIndex, { locale: localeKey });
const glossary = resolveLocalizedContent(glossaryIndex, { locale: localeKey });
const examples = resolveLocalizedContent(exampleIndex, { locale: localeKey });
const releaseNotes = getReleaseNotes();
const latestRelease = releaseNotes[0];
const latestVersion =
  getVersionEntries().find((entry) => entry.isLatest)?.version ?? bookConfig.status;
const startingChapter =
  chapters.entries.find((entry) => entry.slug === "overview") ?? chapters.entries[0];

const readerSections = [
  {
    title: "Overview",
    description: "Objectives, frame, and constraints for this draft.",
    href: readRoutes.overview,
    count: 1,
    keyHint: ["g", "o"],
  },
  {
    title: "Chapters",
    description: "Core modules and the intervention frame.",
    href: readRoutes.chapters,
    count: chapters.entries.length,
    completeness: chapters.completeness,
    keyHint: ["g", "c"],
  },
  {
    title: "Mechanisms",
    description: "Named system patterns with stable definitions.",
    href: readRoutes.mechanisms,
    count: mechanisms.entries.length,
    completeness: mechanisms.completeness,
    keyHint: ["g", "m"],
  },
  {
    title: "Toolkit",
    description: "Action primitives that fit inside ten minutes.",
    href: readRoutes.toolkit,
    count: toolkit.entries.length,
    completeness: toolkit.completeness,
    keyHint: ["g", "t"],
    updatedIn: latestVersion,
  },
  {
    title: "Glossary",
    description: "Short definitions to keep shared language consistent.",
    href: readRoutes.glossary,
    count: glossary.entries.length,
    completeness: glossary.completeness,
    keyHint: ["g", "l"],
  },
  {
    title: "Examples",
    description: "Replaceable cases that ground the modules.",
    href: readRoutes.examples,
    count: examples.entries.length,
    completeness: examples.completeness,
    keyHint: ["g", "e"],
    updatedIn: latestVersion,
  },
];

const hasUpdatedSections = readerSections.some((section) => Boolean(section.updatedIn));

const authorSections = [
  {
    title: "Analytics dashboard",
    description: "Author-only engagement dashboard and drop-off insights.",
    href: readRoutes.analytics,
  },
];
---
<BaseLayout title={`Read • ${bookConfig.title}`}>
  <div class="section-header">
    <h1>Reading hub</h1>
    <p class="lede">
      Use these views to move through the book content without exposing engine logic.
    </p>
  </div>

    <section class="content-block" style="margin-top: 0;">
    <div class="eyebrow">Recommended paths</div>
    <h2>Start where your intent is clear</h2>
    <p class="meta">Choose the entry point that best matches what you need right now.</p>
    <div class="card-grid" style="margin-top: 1rem;">
      {startingChapter && (
        <a class="card" href={readItemPath("chapters", startingChapter.slug)}>
          <div class="eyebrow">Foundations</div>
          <h3>Read the framing chapter first</h3>
          <p class="meta">Start with: {startingChapter.module.frontmatter?.title ?? "Foundational chapter"}</p>
        </a>
      )}
      <a class="card" href={readRoutes.overview}>
        <div class="eyebrow">Orientation</div>
        <h3>Understand the frame quickly</h3>
        <p class="meta">Review objectives, constraints, and module boundaries before diving in.</p>
      </a>
      <a class="card" href={readRoutes.mechanisms}>
        <div class="eyebrow">Problem-solving</div>
        <h3>Jump to a named mechanism</h3>
        <p class="meta">Start with concrete system patterns when you already have a specific issue.</p>
      </a>
    </div>
    <p class="meta">Prefer offline reading? Visit the dedicated Offline reading page for full-book and chapter exports.</p>
  </section>

  {latestRelease && (
    <details class="content-block" style="margin-top: 0;">
      <summary><strong>Latest update: v{latestRelease.version}</strong></summary>
      <p class="meta" style="margin-top: 0.75rem;">{latestRelease.summary}</p>
      <a class="next-steps__link" href="/release-notes">See full release notes</a>
      <p class="meta" style="margin-top: 0.5rem;">Prefer stable context first? Scan the latest release summary before diving into updated sections.</p>
    </details>
  )}

  <div class="link-group" style="margin-bottom: 1rem;">
    {hasUpdatedSections && (
      <button class="button" type="button" data-updated-filter>
        Show updated only
      </button>
    )}
  </div>

  <div class="card-grid" data-reader-sections>
    {readerSections.map((section) => {
      const label = section.count === 1 ? "item" : "items";
      const keyShortcut = section.keyHint ? section.keyHint.join(" ") : undefined;
      const completenessLabel = formatTranslationCompleteness(section.completeness);
      return (
        <a
          class="card"
          href={section.href}
          aria-keyshortcuts={keyShortcut}
          data-updated={section.updatedIn ? "true" : "false"}
        >
          <div class="eyebrow">
            {section.count} {label}
            {completenessLabel ? ` • ${completenessLabel}` : ""}
          </div>
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            {section.badge && <span class="pill">{section.badge}</span>}
            {section.updatedIn && <span class="pill">Updated in v{section.updatedIn}</span>}
          </div>
          <h2>{section.title}</h2>
          <p class="meta">{section.description}</p>
          {section.keyHint && (
            <span class="kbd-hint" aria-hidden="true">
              {section.keyHint.map((key) => (
                <kbd>{key}</kbd>
              ))}
            </span>
          )}
        </a>
      );
    })}
  </div>

  {hasUpdatedSections && (
    <script>
      const filterButton = document.querySelector("[data-updated-filter]");
      const cards = Array.from(document.querySelectorAll("[data-reader-sections] [data-updated]"));
      if (filterButton && cards.length > 0) {
        let showUpdatedOnly = false;
        filterButton.addEventListener("click", () => {
          showUpdatedOnly = !showUpdatedOnly;
          cards.forEach((card) => {
            const isUpdated = card.getAttribute("data-updated") === "true";
            card.hidden = showUpdatedOnly && !isUpdated;
          });
          filterButton.textContent = showUpdatedOnly ? "Show all sections" : "Show updated only";
        });
      }
    </script>
  )}

  <details class="content-block" style="margin-top: 1.5rem;">
    <summary><strong>Author tools (optional)</strong></summary>
    <p class="meta" style="margin-top: 0.75rem;">Reader mode hides publishing diagnostics by default.</p>
    <div class="card-grid" style="margin-top: 1rem;">
      {authorSections.map((section) => (
        <a class="card" href={section.href}>
          <span class="pill">Author-only</span>
          <h3>{section.title}</h3>
          <p class="meta">{section.description}</p>
        </a>
      ))}
    </div>
  </details>
</BaseLayout>
