---
import BookLayout from "../layouts/BookLayout.astro";
import { createBookLayoutRenderState } from "../book/layout";
import { buildVersionPath, type BookVersionEntry } from "../releases/versions";

export type Props = {
	title: string;
	bookTitle: string;
	bookVersion: string;
	bookKey?: string;
	versions: BookVersionEntry[];
	description?: string;
	prefixSegment?: string;
	siteUrl?: string;
	metaDescription?: string;
	ogImage?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogType?: string;
	twitterCard?: "summary" | "summary_large_image" | "app" | "player";
	twitterTitle?: string;
	twitterDescription?: string;
	twitterImage?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
	canonicalPath?: string;
	canonicalUrl?: string;
	robots?: string;
};

const {
	title,
	bookTitle,
	bookVersion,
	bookKey = "book",
	versions,
	description = "Every published version of this book.",
	prefixSegment = "v",
	siteUrl,
	metaDescription,
	ogImage,
	ogTitle,
	ogDescription,
	ogType,
	twitterCard,
	twitterTitle,
	twitterDescription,
	twitterImage,
	structuredData,
	canonicalPath,
	canonicalUrl,
	robots,
} = Astro.props;

const renderState = createBookLayoutRenderState({
	title,
	bookTitle,
	bookVersion,
	seoProps: {
		siteUrl,
		metaDescription,
		ogImage,
		ogTitle,
		ogDescription,
		ogType,
		twitterCard,
		twitterTitle,
		twitterDescription,
		twitterImage,
		structuredData,
		canonicalPath,
		canonicalUrl,
		robots,
	},
	requestPathname: Astro.url.pathname,
	versionEntries: versions,
	versionPrefix: prefixSegment,
	locales: [],
	defaultLocale: "en",
	includeDefaultLocalePrefix: false,
	localeLabel: "Language",
	isPreview: false,
});

const entries = versions.map((entry) => ({
	...entry,
	href: buildVersionPath("/", entry, { prefixSegment }),
}));
---
<BookLayout
  title={title}
  bookTitle={bookTitle}
  bookVersion={bookVersion}
  bookKey={bookKey}
  versions={versions}
  versionPrefix={prefixSegment}
  siteUrl={siteUrl}
  metaDescription={metaDescription}
  ogImage={ogImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  twitterCard={twitterCard}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  structuredData={structuredData}
  canonicalPath={canonicalPath}
  canonicalUrl={canonicalUrl}
  robots={robots}
  renderState={renderState}
>
  <div class="section-header">
    <div>
      <h1>Version archive</h1>
      <p class="lede">{description}</p>
    </div>
  </div>
  <div class="version-archive">
    {entries.length ? (
      entries.map((entry) => (
        <article class="version-card" data-version-date={entry.date}>
          <div class="version-card__header">
            <div>
              <p class="eyebrow">{entry.isLatest ? "Latest" : "Archived"}</p>
              <h2>{entry.title ?? `Version ${entry.version}`}</h2>
            </div>
            {entry.date && (
              <time class="version-card__date" datetime={entry.date}>
                {new Date(entry.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
            )}
          </div>
          {entry.summary && <p class="version-card__summary">{entry.summary}</p>}
          <div class="version-card__chips" data-version-new hidden>
            <span class="version-card__chip version-card__chip--new">New since your last visit</span>
          </div>
          {entry.highlights?.length ? (
            <ul class="version-card__highlights">
              {entry.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : null}
          <a class="version-card__link" href={entry.href}>
            View {entry.isLatest ? "latest" : "archived"} version
          </a>
        </article>
      ))
    ) : (
      <p class="meta">No published versions yet.</p>
    )}
  </div>
  <script define:vars={{ bookKey }}>
    const storageKey = `${bookKey}:version:lastVisit`;
    const previousVisit = localStorage.getItem(storageKey);
    const previousVisitMs = previousVisit ? new Date(previousVisit).getTime() : Number.NaN;
    const cards = Array.from(document.querySelectorAll("[data-version-date]"));

    if (Number.isFinite(previousVisitMs)) {
      cards.forEach((card) => {
        const dateValue = card.getAttribute("data-version-date");
        const dateMs = dateValue ? new Date(dateValue).getTime() : Number.NaN;
        const newChip = card.querySelector("[data-version-new]");
        if (newChip) {
          newChip.hidden = !(Number.isFinite(dateMs) && dateMs > previousVisitMs);
        }
      });
    }

    localStorage.setItem(storageKey, new Date().toISOString());
  </script>
</BookLayout>
