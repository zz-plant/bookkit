---
// ReadingProgressBar.astro
// Pure CSS scroll-driven reading progress bar with fallback
---
<div class="reading-progress-bar" role="progressbar" aria-label="Reading progress" aria-hidden="true"></div>

<script>
  if (!CSS.supports("animation-timeline", "scroll()")) {
    const bar = document.querySelector<HTMLElement>(".reading-progress-bar");
    if (bar) {
      window.addEventListener(
        "scroll",
        () => {
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          if (scrollable > 0) {
            const progress = Math.min(1, Math.max(0, window.scrollY / scrollable));
            bar.style.transform = `scaleX(${progress})`;
          }
        },
        { passive: true }
      );
    }
  }
</script>
