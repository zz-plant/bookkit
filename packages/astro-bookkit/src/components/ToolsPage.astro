---
import BookLayout from "../layouts/BookLayout.astro";
import { createBookLayoutRenderState } from "../book/layout";

export type ToolsPageLink = {
	title: string;
	description: string;
	href: string;
};

export type Props = {
	title: string;
	bookTitle: string;
	bookVersion: string;
	bookKey?: string;
	backHref: string;
	links: ToolsPageLink[];
	heading?: string;
	lede?: string;
	eyebrow?: string;
};

const {
	title,
	bookTitle,
	bookVersion,
	bookKey = "book",
	backHref,
	links,
	heading = "Author tools",
	lede = "Analytics, release notes, and downloads for this book.",
	eyebrow,
} = Astro.props;

const renderState = createBookLayoutRenderState({
	title,
	bookTitle,
	bookVersion,
	// Author tools, not reading: reachable, but kept out of search.
	seoProps: { robots: "noindex, nofollow" },
	requestPathname: Astro.url.pathname,
	versionEntries: [],
	locales: [],
	defaultLocale: "en",
	includeDefaultLocalePrefix: false,
	localeLabel: "Language",
	isPreview: false,
});
---
<BookLayout title={title} bookTitle={bookTitle} bookVersion={bookVersion} bookKey={bookKey} renderState={renderState}>
  <a class="back-link" href={backHref}>← Reading hub</a>
  <div class="section-header">
    {eyebrow && <div class="eyebrow">{eyebrow}</div>}
    <h1>{heading}</h1>
    <p class="lede">{lede}</p>
  </div>

  <section class="content-block">
    <div class="card-grid">
      {links.map((link) => (
        <a class="card" href={link.href}>
          <h2>{link.title}</h2>
          <p class="meta">{link.description}</p>
        </a>
      ))}
    </div>
  </section>
</BookLayout>
