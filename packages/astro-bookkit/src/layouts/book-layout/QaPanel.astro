---
const { aiQaSamples = [] } = Astro.props;
---
<div class="qa-panel" id="qa-panel" data-qa-panel hidden>
  <div
    class="qa-panel__content"
    role="dialog"
    aria-modal="true"
    aria-label="Ask about the book"
    data-qa-content
  >
    <div class="qa-panel__header">
      <strong>Ask the book</strong>
      <div class="qa-panel__actions">
        <button type="button" class="qa-panel__toggle" data-qa-disable>
          Turn off
        </button>
        <button type="button" class="kbd-close" data-qa-close aria-label="Close Ask the book">
          Esc
        </button>
      </div>
    </div>
    <div class="qa-panel__body" data-qa-body>
      <p class="meta">
        Answers are drawn only from this book and cite the sections they come from.
      </p>
      <form class="qa-panel__form" data-qa-form>
        <label class="qa-panel__field">
          <span class="sr-only">Ask a question about the book</span>
          <textarea
            rows="2"
            placeholder="Ask a question about the book..."
            autocomplete="off"
            spellcheck="false"
            aria-describedby="qa-status"
            data-qa-input
          ></textarea>
        </label>
        <button type="submit" class="qa-panel__submit">Ask</button>
      </form>
      <div class="qa-panel__display" role="group" aria-label="Answer display mode">
        <span class="meta">Show</span>
        <button type="button" class="qa-panel__display-toggle" data-qa-display-toggle>
          Show citations first
        </button>
      </div>
      <div class="qa-panel__meta" id="qa-status" role="status" aria-live="polite" data-qa-status>
        Ask a question to see answers.
      </div>
      <div class="qa-panel__suggestions">
        <div class="eyebrow">Try asking</div>
        <div class="qa-panel__suggestion-list">
          {aiQaSamples.map((prompt) => (
            <button type="button" class="qa-panel__suggestion" data-qa-suggestion>{prompt}</button>
          ))}
        </div>
      </div>
      <div class="qa-panel__answer" data-qa-answer>
        <p class="meta">No answer yet.</p>
      </div>
      <div class="qa-panel__citations" data-qa-citations></div>
    </div>
    <div class="qa-panel__disabled" data-qa-disabled hidden>
      <p>Ask the book is turned off in this browser.</p>
      <button type="button" class="qa-panel__submit" data-qa-enable>
        Turn it back on
      </button>
    </div>
  </div>
</div>
