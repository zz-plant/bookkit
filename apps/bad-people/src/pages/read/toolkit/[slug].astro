---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";

export async function getStaticPaths() {
  const modules = import.meta.glob("../../../content/book/toolkit/*.mdx", { eager: true });
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = import.meta.glob("../../../content/book/toolkit/*.mdx", { eager: true });
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing toolkit entry for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const isFallback = missingSlugs.includes(frontmatter.slug);
---
<BaseLayout title={`${frontmatter.name} • Bad People`}>
  <a class="back-link" href="/read/toolkit">← Toolkit</a>
  <div class="eyebrow">Toolkit{isFallback ? " • fallback" : ""}</div>
  <h1 id={frontmatter.slug}>{frontmatter.name}</h1>
  <p class="lede">
    {frontmatter.mechanism} • {frontmatter.timeboxMinutes ?? 10} min
  </p>
  <section class="content-block">
    <Content />
  </section>
</BaseLayout>
