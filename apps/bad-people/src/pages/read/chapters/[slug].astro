---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FeedbackWidget from "@bookkit/astro-bookkit/components/FeedbackWidget.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import { getChapterExportLinks } from "../../../lib/exports";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import bookConfig from "../../../book.config";
import { readItemPath, readRoutes } from "@bookkit/astro-bookkit";

export async function getStaticPaths() {
  const modules = bookEntryPoints.contentModules.chapters;
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = bookEntryPoints.contentModules.chapters;
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs, entries } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const module = resolveLocalizedModule(localizedIndex, Astro.params.slug ?? "", {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing chapter for slug: ${Astro.params.slug}`);
}

const { frontmatter, default: Content } = module;
const exportLinks = getChapterExportLinks(frontmatter.slug, frontmatter.title ?? "Chapter");
const isFallback = missingSlugs.includes(frontmatter.slug);
const chapterOrder = entries
  .map(({ slug, module: chapterModule }) => ({
    slug,
    title: chapterModule.frontmatter?.title ?? "Untitled chapter",
  }))
  .sort((a, b) => a.slug.localeCompare(b.slug));
const currentIndex = chapterOrder.findIndex((entry) => entry.slug === frontmatter.slug);
const nextChapter = currentIndex >= 0 ? chapterOrder[currentIndex + 1] : null;
---
<BaseLayout title={`${frontmatter.title} • ${bookConfig.title}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={readRoutes.root}>Reading hub</a>
    <span>›</span>
    <a href={readRoutes.chapters}>Chapters</a>
    <span>›</span>
    <span>{frontmatter.title}</span>
  </nav>
  <a class="back-link" href={readRoutes.chapters}>← Chapters</a>
  <div class="chapter-shell">
    <aside class="chapter-meta-panel">
      <div class="eyebrow">Chapter map</div>
      <h2>Progress steps</h2>
      <ol class="chapter-step-list" data-chapter-step-list></ol>
      <ExportPanel
        title="Download chapter"
        description="Keep a focused export for offline sharing."
        links={exportLinks}
      />
    </aside>

    <article>
      <div class="eyebrow">
        {frontmatter.status ?? "draft"}
        {isFallback ? " • fallback" : ""}
      </div>
      <h1 id={frontmatter.slug}>{frontmatter.title}</h1>
      <section class="content-block chapter-content" data-chapter-sections>
        <Content />
      </section>
    </article>
  </div>

  <section class="next-steps" id="next-steps">
    <h2>Choose your next move</h2>
    <div class="next-steps__links next-steps__branches">
      {nextChapter && (
        <a class="next-steps__link" href={readItemPath("chapters", nextChapter.slug)}>
          Continue chapter path → {nextChapter.title}
        </a>
      )}
      <a class="next-steps__link" href={readRoutes.mechanisms}>Branch to mechanism diagnosis</a>
      <a class="next-steps__link" href={readRoutes.toolkit}>Branch to ten-minute toolkit action</a>
    </div>
  </section>
  <FeedbackWidget
    slug={frontmatter.slug}
    title={frontmatter.title}
    contentType="chapter"
    endpoint="/api/feedback.json"
  />
</BaseLayout>

<script is:inline>
  const chapterStepList = document.querySelector("[data-chapter-step-list]");
  const chapterSections = document.querySelector("[data-chapter-sections]");

  if (chapterStepList && chapterSections) {
    const sectionHeadings = Array.from(chapterSections.querySelectorAll("h2[id], h3[id]"));
    const nextStepsHeading = document.querySelector(".next-steps h2[id], .next-steps[id]");
    const orderedHeadings =
      nextStepsHeading && "id" in nextStepsHeading && nextStepsHeading.id
        ? [...sectionHeadings, nextStepsHeading]
        : sectionHeadings;

    orderedHeadings.forEach((heading, index) => {
      if (!("id" in heading) || !heading.id) return;

      const stepItem = document.createElement("li");
      const stepLink = document.createElement("a");
      const stepNumber = document.createElement("span");
      stepNumber.textContent = `${index + 1}.`;
      stepLink.href = `#${heading.id}`;
      stepLink.append(stepNumber, ` ${heading.textContent?.trim() ?? "Section"}`);
      stepItem.append(stepLink);
      chapterStepList.append(stepItem);
    });
  }
</script>

<style>
  .chapter-shell {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .chapter-meta-panel {
    position: sticky;
    top: 1rem;
    border: 1px solid rgba(91, 76, 230, 0.16);
    border-radius: 0.75rem;
    background: #fff;
    padding: 0.9rem;
    display: grid;
    gap: 0.65rem;
  }

  .chapter-meta-panel h2 {
    margin: 0;
    font-size: 1rem;
  }

  .chapter-step-list {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.35rem;
  }

  .chapter-step-list a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .chapter-step-list a:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .next-steps__branches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .chapter-shell {
      grid-template-columns: 1fr;
    }

    .chapter-meta-panel {
      position: static;
    }
  }
</style>
