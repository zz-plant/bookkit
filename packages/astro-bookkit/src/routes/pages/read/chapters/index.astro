---
import BaseLayout from "../../../BaseLayout.astro";
import ExportPanel from "../../../../components/ExportPanel.astro";
import ContentIndexList from "../../../../components/ContentIndexList.astro";
import {
	getBookExportLinks,
	bookEntryPoints,
	bookConfig,
} from "../../../runtime";
import {
	buildLocalizedContentIndex,
	resolveLocalizedContent,
} from "../../../../localization";
import { bookPageTitle } from "../../../../seo/page-meta";
import {
	buildTranslationLede,
	chapterReadingOrder,
	deriveRolePathways,
	draftCopy,
	type GraphNode,
	readItemPath,
} from "../../../../book";

const { entries, completeness } = resolveLocalizedContent(
	buildLocalizedContentIndex(bookEntryPoints.contentModules.chapters, {
		defaultLocale: "en",
	}),
	{ locale: Astro.locals?.locale },
);
// In reading order, as previous/next and "Chapter N of M" count it.
const orderedChapters = chapterReadingOrder(entries);
const chapterItems = orderedChapters.map(({ slug, module, isFallback }) => {
	const frontmatter = module.frontmatter ?? {};
	return {
		href: readItemPath("chapters", slug),
		title: frontmatter.title ?? "Untitled chapter",
		status: String(frontmatter.status ?? "draft"),
		badges: isFallback ? ["Not yet translated"] : null,
	};
});

const graphNodes: GraphNode[] = orderedChapters.map(({ slug, module }) => {
	const frontmatter = module.frontmatter ?? {};
	return {
		slug,
		title: String(frontmatter.title ?? slug),
		prerequisites: Array.isArray(frontmatter.prerequisites)
			? (frontmatter.prerequisites as string[])
			: [],
	};
});
const rolePathways = deriveRolePathways(graphNodes);
// A status only helps when chapters differ; if every chapter is a draft, say so once.
const hasMixedStatus =
	new Set(chapterItems.map((item) => item.status)).size > 1;
const listedChapters = chapterItems.map(({ status, ...item }) => ({
	...item,
	eyebrow: hasMixedStatus && status !== "published" ? status : null,
}));
const draftCount = chapterItems.filter(
	(item) => item.status === "draft",
).length;
const exportLinks = getBookExportLinks();
const localizedLede = buildTranslationLede(
	"The full argument, one chapter at a time.",
	completeness,
);
---
<BaseLayout title={bookPageTitle("Chapters", bookConfig.title)}>
  <ContentIndexList
    title="Chapters"
    lede={localizedLede}
    items={listedChapters}
    filterPlaceholder="Filter by title"
    alphaMode={false}
    emptyMessage="No chapters yet."
    emptyCommand={`bun run bookkit new chapter ${bookConfig.slug} "<title>"`}
  >
    <div slot="after-header">
      {rolePathways.length > 0 && (
        <div class="next-action-panel">
          <div class="eyebrow">Role-Based Reading Pathways</div>
          <div class="next-action-panel__links" style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2);">
            {rolePathways.map((pathway) => (
              <span
                class="list-link__badge"
                title={pathway.description}
                style="padding: var(--space-1) var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-control); background: var(--color-surface-hover);"
              >
                <strong style="color: var(--color-ink);">{pathway.name}</strong> ({pathway.slugs.length} {pathway.slugs.length === 1 ? "chapter" : "chapters"})
              </span>
            ))}
          </div>
        </div>
      )}
      {draftCount > 0 && (
        <details class="content-block content-block--flush" style="margin-bottom: var(--space-3);">
          <summary>
            <strong>{draftCount === chapterItems.length ? draftCopy.allChapters : draftCopy.someChapters}</strong>
          </summary>
          <p class="meta">{draftCopy.meaning}</p>
        </details>
      )}
    </div>
    <ExportPanel
      slot="after-list"
      title="Download the book"
      description="PDF for print, EPUB for e-readers. Single chapters are on the Downloads page."
      links={exportLinks}
    />
  </ContentIndexList>
</BaseLayout>
