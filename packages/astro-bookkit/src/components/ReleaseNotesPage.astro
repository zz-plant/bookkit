---
import BookLayout from "../layouts/BookLayout.astro";
import { createBookLayoutRenderState } from "../book/layout";
import { formatReleaseDate, type ReleaseNote } from "../releases/notes";
import type { BookVersionEntry } from "../releases/versions";

export type Props = {
  title: string;
  bookTitle: string;
  bookVersion: string;
  bookKey?: string;
  versions?: BookVersionEntry[];
  versionPrefix?: string;
  versionArchivePath?: string;
  rssUrl: string;
  releases: ReleaseNote[];
  description?: string;
  subscribeLabel?: string;
  subscribeAnalyticsUrl?: string | null;
  siteUrl?: string;
  metaDescription?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  twitterCard?: "summary" | "summary_large_image" | "app" | "player";
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  canonicalPath?: string;
  canonicalUrl?: string;
  robots?: string;
};

const {
  title,
  bookTitle,
  bookVersion,
  bookKey = "book",
  versions = [],
  versionPrefix = "v",
  versionArchivePath = "/versions",
  rssUrl,
  releases,
  description = "Track new releases, subscribe to updates, and review the latest changes.",
  subscribeLabel = "Subscribe via RSS",
  subscribeAnalyticsUrl = "/api/release-analytics.json",
  siteUrl,
  metaDescription,
  ogImage,
  ogTitle,
  ogDescription,
  ogType,
  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  structuredData,
  canonicalPath,
  canonicalUrl,
  robots,
} = Astro.props;

const renderState = createBookLayoutRenderState({
  title,
  bookTitle,
  bookVersion,
  seoProps: {
    siteUrl,
    metaDescription,
    ogImage,
    ogTitle,
    ogDescription,
    ogType,
    twitterCard,
    twitterTitle,
    twitterDescription,
    twitterImage,
    structuredData,
    canonicalPath,
    canonicalUrl,
    robots,
  },
  requestPathname: Astro.url.pathname,
  versionEntries: versions,
  versionPrefix,
  versionArchivePath,
  locales: [],
  defaultLocale: "en",
  includeDefaultLocalePrefix: false,
  localeLabel: "Language",
  isPreview: false,
});
---
<BookLayout
  title={title}
  bookTitle={bookTitle}
  bookVersion={bookVersion}
  bookKey={bookKey}
  versions={versions}
  versionPrefix={versionPrefix}
  versionArchivePath={versionArchivePath}
  siteUrl={siteUrl}
  metaDescription={metaDescription}
  ogImage={ogImage}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogType={ogType}
  twitterCard={twitterCard}
  twitterTitle={twitterTitle}
  twitterDescription={twitterDescription}
  twitterImage={twitterImage}
  structuredData={structuredData}
  canonicalPath={canonicalPath}
  canonicalUrl={canonicalUrl}
  robots={robots}
  renderState={renderState}
>
  <div class="section-header release-header">
    <div>
      <h1>Release notes</h1>
      <p class="lede">{description}</p>
      <p class="meta" data-release-visit-note hidden>
        Showing changes since your last visit.
      </p>
    </div>
    <div class="release-actions" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <button class="button button--secondary" type="button" data-release-filter hidden>
        Show since last visit
      </button>
      <a
        class="button"
        href={rssUrl}
        data-release-subscribe
        aria-label={subscribeLabel}
      >
        {subscribeLabel}
      </a>
    </div>
  </div>
  <div class="release-list" data-release-list>
    {releases.map((release) => {
      const Content = release.Content;
      return (
        <article class="release-card" id={`release-${release.version}`} data-release-date={release.date}>
          <header class="release-header">
            <div class="release-meta">
              <p class="eyebrow">Version {release.version}</p>
              <h2>{release.title}</h2>
            </div>
            <time class="release-date" datetime={release.date}>
              {formatReleaseDate(release.date)}
            </time>
          </header>
          <p class="eyebrow">Reader impact summary</p>
          <p class="release-summary">{release.summary}</p>
          <div class="release-chip-row">
            <span class="release-chip">Impact: reader</span>
            {release.changedSections.length > 0 && (
              <span class="release-chip">{release.changedSections.length} updated section{release.changedSections.length === 1 ? "" : "s"}</span>
            )}
            {release.highlights.length > 0 && (
              <span class="release-chip">{release.highlights.length} key highlight{release.highlights.length === 1 ? "" : "s"}</span>
            )}
            <span class="release-chip release-chip--new" data-release-new hidden>Updated since last visit</span>
          </div>
          {release.changedSections.length > 0 && (
            <p class="meta">Updated sections: {release.changedSections.join(", ")}</p>
          )}
          {release.highlights.length > 0 && (
            <ul class="release-highlights">
              {release.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {Content && (
            <details class="release-details">
              <summary>Read details</summary>
              <section class="content-block">
                <Content />
              </section>
            </details>
          )}
        </article>
      );
    })}
  </div>
  {(subscribeAnalyticsUrl || releases.length > 0) && (
    <script define:vars={{ subscribeAnalyticsUrl, releases, bookKey }}>
      const subscribeButton = document.querySelector("[data-release-subscribe]");
      subscribeButton?.addEventListener("click", () => {
        if (!subscribeAnalyticsUrl) return;
        const payload = JSON.stringify({ event: "rss_subscribe_click" });
        if (navigator.sendBeacon) {
          navigator.sendBeacon(subscribeAnalyticsUrl, payload);
        } else {
          fetch(subscribeAnalyticsUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: payload,
          });
        }
      });

      const filterButton = document.querySelector("[data-release-filter]");
      const visitNote = document.querySelector("[data-release-visit-note]");
      const cards = Array.from(document.querySelectorAll("[data-release-date]"));
      const storageKey = `${bookKey}:release:lastVisit`;
      const sessionKey = `${bookKey}:release:sessionVisit`;
      const nowIso = new Date().toISOString();
      let previousVisit = sessionStorage.getItem(sessionKey);
      if (!previousVisit) {
        previousVisit = localStorage.getItem(storageKey);
        if (previousVisit) {
          sessionStorage.setItem(sessionKey, previousVisit);
        }
      }
      const previousVisitMs = previousVisit ? new Date(previousVisit).getTime() : Number.NaN;

      if (Number.isFinite(previousVisitMs)) {
        cards.forEach((card) => {
          const dateValue = card.getAttribute("data-release-date");
          const releaseMs = dateValue ? new Date(dateValue).getTime() : Number.NaN;
          const newChip = card.querySelector("[data-release-new]");
          if (newChip) {
            newChip.hidden = !(Number.isFinite(releaseMs) && releaseMs > previousVisitMs);
          }
        });
      }

      if (filterButton && Number.isFinite(previousVisitMs) && cards.length > 0) {
        filterButton.hidden = false;
        let showingFiltered = false;
        filterButton.addEventListener("click", () => {
          showingFiltered = !showingFiltered;
          cards.forEach((card) => {
            const dateValue = card.getAttribute("data-release-date");
            const releaseMs = dateValue ? new Date(dateValue).getTime() : Number.NaN;
            const isNew = Number.isFinite(releaseMs) && releaseMs > previousVisitMs;
            const show = !showingFiltered || isNew;
            card.hidden = !show;
            const newChip = card.querySelector("[data-release-new]");
            if (newChip) {
              newChip.hidden = !isNew;
            }
          });
          if (visitNote) {
            visitNote.hidden = !showingFiltered;
          }
          filterButton.textContent = showingFiltered
            ? "Show all releases"
            : "Show since last visit";
        });
      }

      window.addEventListener("beforeunload", () => {
        localStorage.setItem(storageKey, nowIso);
      });
    </script>
  )}
</BookLayout>
