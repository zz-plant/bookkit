---
const { heading = "Reader feedback", endpoint } = Astro.props;
---
<section class="feedback-dashboard" data-feedback-dashboard data-feedback-endpoint={endpoint}>
  <div class="section-header">
    <h2>{heading}</h2>
    <p class="lede">Reactions and notes from readers.</p>
  </div>

  <div class="feedback-filters" data-feedback-filters>
    <label class="analytics-filter">
      <span>From</span>
      <input type="date" data-feedback-start aria-label="Feedback start date" />
    </label>
    <label class="analytics-filter">
      <span>To</span>
      <input type="date" data-feedback-end aria-label="Feedback end date" />
    </label>
    <label class="analytics-filter">
      <span>Reaction</span>
      <select data-feedback-type aria-label="Filter by reaction">
        <option value="all">All reactions</option>
        <option value="helpful">Helpful</option>
        <option value="not_helpful">Not helpful</option>
        <option value="emoji">Emoji</option>
      </select>
    </label>
  </div>

  <div class="feedback-grid">
    <article class="analytics-card">
      <div class="eyebrow">Feedback</div>
      <div class="metric-value" data-feedback-metric="total">0</div>
      <div class="metric-subtext" data-feedback-metric-detail="total">No feedback yet</div>
    </article>
    <article class="analytics-card">
      <div class="eyebrow">Helpful rate</div>
      <div class="metric-value" data-feedback-metric="helpful-rate">0%</div>
      <div class="metric-subtext" data-feedback-metric-detail="helpful-rate">Based on votes</div>
    </article>
    <article class="analytics-card">
      <div class="eyebrow">Conversion</div>
      <div class="metric-value" data-feedback-metric="conversion">0%</div>
      <div class="metric-subtext" data-feedback-metric-detail="conversion">Feedback per view</div>
    </article>
  </div>

  <div class="feedback-empty" data-feedback-empty hidden>
    <p>No feedback yet. Visit a chapter and respond to see insights here.</p>
  </div>

  <div class="feedback-table-wrap" data-feedback-table>
    <h3>Feedback by chapter</h3>
    <table class="analytics-table">
      <thead>
        <tr>
          <th>Chapter</th>
          <th>Views</th>
          <th>Feedback</th>
          <th>Helpful</th>
          <th>Top emoji</th>
        </tr>
      </thead>
      <tbody data-feedback-rows></tbody>
    </table>
  </div>

  <div class="feedback-comments" data-feedback-comments>
    <h3>Recent comments</h3>
    <ul class="feedback-comments__list" data-feedback-comment-list></ul>
  </div>
</section>

<script>
  import {
    AUTHOR_TOKEN_EVENT,
    fetchAuthorJson,
    reportAuthorRead,
    storedAuthorToken,
  } from "./author-access/access";

  type FeedbackEvent = {
    eventType: string;
    timestamp: number;
    slug?: string;
    title?: string;
    responseType?: string;
    emoji?: string | null;
    comment?: string;
  };

  type FeedbackRow = {
    slug: string;
    views: number;
    feedback: FeedbackEvent[];
    helpful: number;
    notHelpful: number;
  };

  // Every element below is rendered unconditionally by this component.
  const requireElement = <T extends Element = HTMLElement>(selector: string): T => {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`Feedback dashboard is missing ${selector}`);
    return element;
  };

  const resolveEndpoint = (value: string | undefined) => {
    if (!value || typeof value !== "string") return null;
    try {
      const url = new URL(value, window.location.origin);
      if (url.protocol === "http:" || url.protocol === "https:") {
        return url.toString();
      }
    } catch (error) {
      return null;
    }
    return null;
  };

  const analyticsKeyPrefix = document.body?.dataset?.analyticsKey || "book";
  const storageKey = `${analyticsKeyPrefix}.feedback.events`;
  const retentionDays = 120;

  const toDateInput = (date: Date) => date.toISOString().slice(0, 10);
  const formatPercent = (value: number) => `${Math.round(value * 100)}%`;

  const loadEvents = async (endpoint: string | null): Promise<FeedbackEvent[]> => {
    const cutoff = Date.now() - retentionDays * 24 * 60 * 60 * 1000;
    if (endpoint) {
      const read = await fetchAuthorJson(`${endpoint}?since=${cutoff}`, {
        token: storedAuthorToken(),
      });
      reportAuthorRead("feedback", read.state);
      const remote = read.state === "ok" ? (read.payload as { events?: unknown } | null)?.events : null;
      if (Array.isArray(remote)) return remote;
    }
    // Without the server's events, this browser's own.
    try {
      const stored = localStorage.getItem(storageKey);
      const parsed = stored ? JSON.parse(stored) : [];
      return Array.isArray(parsed)
        ? parsed.filter((event) => typeof event?.timestamp === "number" && event.timestamp >= cutoff)
        : [];
    } catch (error) {
      return [];
    }
  };

  const buildEmojiSummary = (events: FeedbackEvent[]) => {
    const counts = new Map<string, number>();
    events
      .forEach((event) => {
        if (event.responseType !== "emoji" || !event.emoji) return;
        counts.set(event.emoji, (counts.get(event.emoji) ?? 0) + 1);
      });
    const top = Array.from(counts.entries()).sort((a, b) => b[1] - a[1])[0];
    return top ? `${top[0]} ${top[1]}` : "—";
  };

  const dashboard = document.querySelector<HTMLElement>("[data-feedback-dashboard]");
  const endpoint = resolveEndpoint(dashboard?.dataset?.feedbackEndpoint);
  const startInput = requireElement<HTMLInputElement>("[data-feedback-start]");
  const endInput = requireElement<HTMLInputElement>("[data-feedback-end]");
  const typeSelect = requireElement<HTMLSelectElement>("[data-feedback-type]");
  const emptyState = requireElement("[data-feedback-empty]");
  const tableWrap = requireElement("[data-feedback-table]");
  const rowsTarget = requireElement("[data-feedback-rows]");
  const commentList = requireElement("[data-feedback-comment-list]");
  const commentsSection = requireElement("[data-feedback-comments]");
  let events: FeedbackEvent[] = [];

  const getRangeDefaults = () => {
    const end = new Date();
    const start = new Date();
    start.setDate(end.getDate() - 30);
    return { start, end };
  };

  const { start, end } = getRangeDefaults();
  startInput.value = toDateInput(start);
  endInput.value = toDateInput(end);

  const filterEvents = () => {
    const startDate = new Date(startInput.value);
    const endDate = new Date(endInput.value);
    endDate.setHours(23, 59, 59, 999);
    const selectedType = typeSelect.value;

    return events.filter((event) => {
      if (event.timestamp < startDate.getTime() || event.timestamp > endDate.getTime()) return false;
      if (selectedType === "all") return true;
      if (event.eventType === "impression") return true;
      return event.responseType === selectedType;
    });
  };

  const renderSummary = (filtered: FeedbackEvent[]) => {
    const impressions = filtered.filter((event) => event.eventType === "impression");
    const feedback = filtered.filter((event) => event.eventType === "feedback");
    const helpfulVotes = feedback.filter((event) => event.responseType === "helpful").length;
    const notHelpfulVotes = feedback.filter((event) => event.responseType === "not_helpful").length;
    const ratedTotal = helpfulVotes + notHelpfulVotes;
    const helpfulRate = ratedTotal ? helpfulVotes / ratedTotal : 0;
    const conversion = impressions.length ? feedback.length / impressions.length : 0;

    requireElement("[data-feedback-metric='total']").textContent = feedback.length.toString();
    requireElement("[data-feedback-metric='helpful-rate']").textContent =
      formatPercent(helpfulRate);
    requireElement("[data-feedback-metric='conversion']").textContent =
      formatPercent(conversion);

    requireElement("[data-feedback-metric-detail='total']").textContent =
      feedback.length ? `${feedback.length} feedback responses` : "No feedback yet";
    requireElement("[data-feedback-metric-detail='helpful-rate']").textContent = ratedTotal
      ? `${helpfulVotes} helpful / ${notHelpfulVotes} not helpful`
      : "No helpful votes yet";
    requireElement("[data-feedback-metric-detail='conversion']").textContent = impressions.length
      ? `${feedback.length} feedback from ${impressions.length} views`
      : "No impressions tracked";
  };

  const renderTable = (filtered: FeedbackEvent[]) => {
    const impressions = filtered.filter((event) => event.eventType === "impression");
    const feedback = filtered.filter((event) => event.eventType === "feedback");
    const map = new Map<string, FeedbackRow>();

    impressions.forEach((event) => {
      const key = typeof event.slug === "string" ? event.slug : "unknown";
      const entry = map.get(key) ?? { slug: key, views: 0, feedback: [], helpful: 0, notHelpful: 0 };
      entry.views += 1;
      map.set(key, entry);
    });

    feedback.forEach((event) => {
      const key = typeof event.slug === "string" ? event.slug : "unknown";
      const entry = map.get(key) ?? { slug: key, views: 0, feedback: [], helpful: 0, notHelpful: 0 };
      entry.feedback.push(event);
      if (event.responseType === "helpful") entry.helpful += 1;
      if (event.responseType === "not_helpful") entry.notHelpful += 1;
      map.set(key, entry);
    });

    const rows = Array.from(map.values())
      .filter((row) => row.slug !== "unknown")
      .sort((a, b) => b.feedback.length - a.feedback.length);

    // Slugs and emoji are what readers sent: each cell holds them as text.
    const cell = (text: string) => {
      const td = document.createElement("td");
      td.textContent = text;
      return td;
    };
    rowsTarget.replaceChildren(
      ...rows.map((row) => {
        const totalVotes = row.helpful + row.notHelpful;
        const helpfulRate = totalVotes ? row.helpful / totalVotes : 0;
        const tr = document.createElement("tr");
        tr.append(
          cell(row.slug.replace(/-/g, " ")),
          cell(String(row.views)),
          cell(String(row.feedback.length)),
          cell(formatPercent(helpfulRate)),
          cell(buildEmojiSummary(row.feedback)),
        );
        return tr;
      }),
    );
  };

  const renderComments = (filtered: FeedbackEvent[]) => {
    const comments = filtered
      .filter((event) => event.eventType === "feedback" && event.comment)
      .sort((a, b) => b.timestamp - a.timestamp)
      .slice(0, 6);

    commentList.replaceChildren();
    if (!comments.length) {
      const li = document.createElement("li");
      li.textContent = "No comments yet.";
      commentList.appendChild(li);
      return;
    }

    comments.forEach((event) => {
      const li = document.createElement("li");
      const title = document.createElement("strong");
      const date = new Date(event.timestamp).toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
      });
      const dateSpan = document.createElement("span");
      const comment = document.createElement("p");
      title.textContent = event.title ?? event.slug ?? "Untitled";
      dateSpan.textContent = date;
      comment.textContent = event.comment ?? "";
      li.append(title, dateSpan, comment);
      commentList.appendChild(li);
    });
  };

  const render = () => {
    const filtered = filterEvents();
    if (!filtered.length) {
      emptyState.hidden = false;
      tableWrap.hidden = true;
      commentsSection.hidden = true;
    } else {
      emptyState.hidden = true;
      tableWrap.hidden = false;
      commentsSection.hidden = false;
    }
    renderSummary(filtered);
    renderTable(filtered);
    renderComments(filtered);
  };

  const initialize = async () => {
    events = await loadEvents(endpoint);
    if (!events.length) {
      emptyState.hidden = false;
      tableWrap.hidden = true;
      commentsSection.hidden = true;
      return;
    }
    render();
  };

  initialize();
  // The author saved or forgot the token: ask the server again.
  window.addEventListener(AUTHOR_TOKEN_EVENT, async () => {
    events = await loadEvents(endpoint);
    render();
  });

  startInput.addEventListener("change", render);
  endInput.addEventListener("change", render);
  typeSelect.addEventListener("change", render);
</script>
