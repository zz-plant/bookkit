---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";

const mechanisms = Object.values(
  import.meta.glob("../../../content/book/mechanisms/*.mdx", { eager: true })
)
  .map((module) => ({
    slug: module.frontmatter.slug,
    title: module.frontmatter.title ?? "Untitled mechanism",
    definition: module.frontmatter.definition ?? "",
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const mechanismItems = mechanisms.map((mechanism) => ({
  href: `/read/mechanisms/${mechanism.slug}`,
  title: mechanism.title,
  meta: mechanism.definition,
}));
---
<BaseLayout title="Mechanisms • Bad People">
  <ContentIndexList
    title="Mechanisms"
    lede="Stable patterns that explain how harm stays normalized."
    items={mechanismItems}
  />
</BaseLayout>
