---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocalizedContentIndex,
  resolveLocalizedContent,
  resolveLocalizedModule,
} from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import bookConfig from "../../../book.config";
import Breadcrumbs from "@bookkit/astro-bookkit/components/Breadcrumbs.astro";
import { getReadPageBreadcrumbCopy } from "../../../lib/read-copy";
import {
  buildLocalizedReadRoutePath,
  createBreadcrumbListStructuredDataFromTrail,
  readItemPath,
  readRoutes,
} from "@bookkit/astro-bookkit";

export async function getStaticPaths() {
  const modules = bookEntryPoints.contentModules.examples;
  const localizedIndex = buildLocalizedContentIndex(modules, {
    defaultLocale: "en",
  });

  return localizedIndex.slugs.map((slug) => ({
    params: { slug },
  }));
}

const modules = bookEntryPoints.contentModules.examples;
const localizedIndex = buildLocalizedContentIndex(modules, {
  defaultLocale: "en",
});
const { missingSlugs } = resolveLocalizedContent(localizedIndex, {
  locale: Astro.locals?.locale,
});
const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : Astro.params.slug ?? "";
const module = resolveLocalizedModule(localizedIndex, slugParam, {
  locale: Astro.locals?.locale,
});

if (!module) {
  throw new Error(`Missing example for slug: ${slugParam}`);
}

const { frontmatter, default: Content } = module;
const metaDescription = frontmatter.summary;
// Examples are keyed by file name; their frontmatter has no slug.
const isFallback = missingSlugs.includes(slugParam);
const requestPath = Astro.url.pathname;
const localizedReadRootPath = buildLocalizedReadRoutePath(requestPath, readRoutes.root);
const localizedSectionPath = buildLocalizedReadRoutePath(requestPath, readRoutes.examples);
const breadcrumbCopy = getReadPageBreadcrumbCopy(Astro.locals?.locale);
const breadcrumbItems = [
  { name: breadcrumbCopy.readingHub, href: localizedReadRootPath },
  { name: breadcrumbCopy.examples, href: localizedSectionPath },
  { name: frontmatter.title },
];
const breadcrumbStructuredData = createBreadcrumbListStructuredDataFromTrail(
  breadcrumbItems,
  Astro.url
);
---
<BaseLayout
  title={`${frontmatter.title} • ${bookConfig.title}`}
  description={metaDescription}
  structuredData={[breadcrumbStructuredData]}
>
  <Breadcrumbs items={breadcrumbItems} ariaLabel={breadcrumbCopy.ariaLabel} />
  <div class="eyebrow">Example{isFallback ? " · not yet translated" : ""}</div>
  <h1 id={slugParam.replaceAll("/", "-")}>{frontmatter.title}</h1>
  <p class="lede">
    <a href={readItemPath("mechanisms", frontmatter.mechanism)}>{frontmatter.mechanism}</a>
    {frontmatter.domain && <> · {frontmatter.domain}</>}
  </p>
  <section class="content-block">
    <Content />
  </section>
  <details class="content-block" id="swap-template">
    <summary><strong>Adapt this example to your own situation</strong></summary>
    <p class="meta">The mechanism holds even when the setting changes.</p>
    <ol class="step-list">
      <li class="step-card">
        <span class="step-card__number">1</span>
        <span>Restate the mechanism in one sentence.</span>
      </li>
      <li class="step-card">
        <span class="step-card__number">2</span>
        <span>Swap in your own setting and people, but keep the same incentives and constraints.</span>
      </li>
      <li class="step-card">
        <span class="step-card__number">3</span>
        <span>Check that the same outcome still follows.</span>
      </li>
    </ol>
  </details>
  <section class="next-steps">
    <h2>Keep going</h2>
    <div class="next-steps__links">
      <a class="next-steps__link" href={readItemPath("mechanisms", frontmatter.mechanism)}>
        The {frontmatter.mechanism} mechanism
      </a>
      <a class="next-steps__link" href={readRoutes.toolkit}>Toolkit</a>
    </div>
  </section>
</BaseLayout>
