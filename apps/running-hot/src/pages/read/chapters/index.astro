---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExportPanel from "@bookkit/astro-bookkit/components/ExportPanel.astro";
import ContentIndexList from "@bookkit/astro-bookkit/components/ContentIndexList.astro";
import ReaderUtilityStrip from "@bookkit/astro-bookkit/components/ReaderUtilityStrip.astro";
import { getBookExportLinks } from "../../../lib/exports";
import { createLocalizedContentList } from "@bookkit/astro-bookkit/localization";
import { bookEntryPoints } from "../../../lib/book-entrypoints";
import { buildTranslationLede, readItemPath } from "@bookkit/astro-bookkit";
import bookConfig from "../../../book.config";

const modules = bookEntryPoints.contentModules.chapters;
const { items: chapterItems, completeness } = createLocalizedContentList(modules, {
  defaultLocale: "en",
  locale: Astro.locals?.locale,
  mapEntry: ({ slug, module, isFallback }) => {
    const frontmatter = module.frontmatter ?? {};
    const status = frontmatter.status ?? "draft";
    return {
      href: readItemPath("chapters", slug),
      title: frontmatter.title ?? "Untitled chapter",
      eyebrow: status,
      badges: [isFallback ? "fallback" : null, "guided path"].filter(Boolean),
    };
  },
});
const exportLinks = getBookExportLinks();
const localizedLede = buildTranslationLede(
  "Module outlines that define the intervention frame.",
  completeness
);
---
<BaseLayout title={`Chapters • ${bookConfig.title}`}>
  <ReaderUtilityStrip
    label="Reading utilities"
    links={[
      { href: "/release-notes", label: "Release notes" },
      { href: "/downloads", label: "Offline downloads" },
    ]}
  />
  <ContentIndexList
    title="Chapters"
    lede={localizedLede}
    items={chapterItems}
  >
    <details slot="after-header" class="content-block" style="margin-top: 0;">
      <summary><strong>What draft status means</strong></summary>
      <p class="meta">
        Draft chapters are readable and useful, but examples, wording, and ordering can still
        change as validation improves.
      </p>
    </details>
    <div class="hero-quick-links" style="margin-top: -0.25rem;">
      <a class="pill" href="#chapter-exports">Jump to download exports</a>
    </div>
    <div slot="after-list" id="chapter-exports">
    <ExportPanel
      title="Download exports"
      description="Grab a print-ready PDF or an EPUB for offline reading. Links include rough size/freshness metadata when available. Need chapter-specific options? Visit Offline reading."
      links={exportLinks}
    />
    </div>
  </ContentIndexList>
</BaseLayout>
